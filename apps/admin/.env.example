# API backend URL (server-side only — never exposed to browser)
API_URL=http://localhost:4000

# Base domain for building impersonation URLs
BASE_DOMAIN=societyledger.com.ng

# Admin console public host (used for CSRF origin check in BFF proxy)
NEXT_PUBLIC_ADMIN_HOST=http://localhost:3002

# Optional: comma-separated CIDRs / IPs — empty disables the allowlist
ADMIN_IP_ALLOWLIST=

# TOTP encryption key (at least 32 chars, keep secret)
TOTP_ENCRYPTION_KEY=

# Admin session token expiry (default 8h)
PLATFORM_TOKEN_EXPIRY=8h
