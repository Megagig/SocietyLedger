# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=SocietyLedger
# Base domain for multi-tenant subdomains (e.g., localhost:3000 for dev, societyledger.com.ng for production)
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000
# Docs site (architecture.md §15.1) — defaults to production if unset
NEXT_PUBLIC_DOCS_URL=https://docs.societyledger.com.ng
