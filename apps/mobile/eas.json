        "EAS_PROJECT_ID": "7deffb9f-b682-45c7-b773-b919a4d8f28b"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EAS_PROJECT_ID": "7deffb9f-b682-45c7-b773-b919a4d8f28b"
      }
    }
  },
  "submit": {
    "production": {}
  }
