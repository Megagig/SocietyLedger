{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EAS_PROJECT_ID": "7deffb9f-b682-45c7-b773-b919a4d8f28b"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EAS_PROJECT_ID": "7deffb9f-b682-45c7-b773-b919a4d8f28b",
        "EXPO_PUBLIC_API_URL": "https://api.societyledger.com.ng",
        "EXPO_PUBLIC_WEB_URL": "https://societyledger.com.ng",
        "EXPO_PUBLIC_BASE_DOMAIN": "societyledger.com.ng",
        "EXPO_PUBLIC_DOCS_URL": "https://docs.societyledger.com.ng"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EAS_PROJECT_ID": "7deffb9f-b682-45c7-b773-b919a4d8f28b",
        "EXPO_PUBLIC_API_URL": "https://api.societyledger.com.ng",
        "EXPO_PUBLIC_WEB_URL": "https://societyledger.com.ng",
        "EXPO_PUBLIC_BASE_DOMAIN": "societyledger.com.ng",
        "EXPO_PUBLIC_DOCS_URL": "https://docs.societyledger.com.ng"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
