  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EAS_PROJECT_ID": "7deffb9f-b682-45c7-b773-b919a4d8f28b"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
