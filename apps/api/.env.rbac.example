# RBAC Configuration for Database-driven Role-Based Access Control
# Copy this to your .env file and configure as needed

# RBAC Migration Mode
# - shadow: Run new RBAC alongside legacy system, log mismatches (Phase 1)
# - hybrid: Use new RBAC with legacy fallback (Phase 2) 
# - full: Complete database-driven RBAC (Phase 3)
RBAC_MODE=shadow

# Enable logging of permission mismatches during shadow mode
RBAC_LOG_MISMATCHES=true

# Enforce permission checks (set to false during shadow mode)
RBAC_ENFORCE=false

# Cache settings for permission resolution
RBAC_CACHE_TTL=300000  # 5 minutes in milliseconds

# Audit settings
RBAC_AUDIT_ENABLED=true
RBAC_AUDIT_RETENTION_DAYS=90

# Performance monitoring
RBAC_MONITOR_ENABLED=true
RBAC_MONITOR_MAX_MISMATCHES=10000

# Development/Testing settings
RBAC_DEBUG=false
RBAC_SKIP_CACHE=false  # Set to true for testing

# Migration settings
RBAC_MIGRATION_BATCH_SIZE=1000
RBAC_MIGRATION_TIMEOUT=30000  # 30 seconds