{
  "name": "@societyledger/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx watch src/server.ts",
    "build": "tsc",
    "build:prod": "tsc --project tsconfig.prod.json",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/server.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:email": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx scripts/test-email.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "migrate:rbac": "tsx scripts/migrate-rbac.ts",
    "migrate:rbac:dry": "tsx scripts/migrate-rbac.ts --dry-run",
    "seed:rbac": "tsx prisma/seeds/rbac-seed.ts",
    "migrate:accounting": "tsx ../../scripts/migrate-to-accounting.ts",
    "rollback:accounting": "tsx ../../scripts/rollback-accounting-sync.ts",
    "check:accounting": "tsx ../../scripts/check-accounting-status.ts",
    "debug:accounting": "tsx ../../scripts/debug-association-accounting.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.27",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^3.0.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "paystack-node": "^0.3.0",
    "pdfkit": "^0.17.2",
    "prisma": "^5.0.0",
    "redis": "^4.6.0",
    "resend": "^2.1.0",
    "typescript": "^5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^2.0.16",
    "eslint": "^8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed-all.ts"
  }
}
