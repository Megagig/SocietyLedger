  amount                Decimal             @db.Decimal(12, 2)
  reason                String
  supportingDocuments   String?             @map("supporting_documents")
  status                WelfarePayoutStatus @default(PENDING)
  reviewedBy            Int?                @map("reviewed_by")
  reviewedAt            DateTime?           @map("reviewed_at")
  reviewComments        String?             @map("review_comments")
  approvedBy            Int?                @map("approved_by")
  approvedAt            DateTime?           @map("approved_at")
  approvedAmount        Decimal?            @map("approved_amount") @db.Decimal(12, 2)
  rejectionReason       String?             @map("rejection_reason")
  disbursedBy           Int?                @map("disbursed_by")
  disbursedAt           DateTime?           @map("disbursed_at")
  disbursementMethod    String?             @map("disbursement_method")
  disbursementReference String?             @map("disbursement_reference")
  requestedAt           DateTime            @default(now()) @map("requested_at")
  createdAt             DateTime            @default(now()) @map("created_at")
