  @@index([associationId, createdAt])
  @@index([userId])
  @@index([promptType])
  @@index([status])
  @@map("ai_audit_logs")
}

// Document Embedding - For RAG-based document Q&A (Phase 17 - Future)
model DocumentEmbedding {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  documentType  String      @map("document_type") // constitution, bylaw, policy, minutes, other
  filename      String
  content       String      @db.Text
  chunkIndex    Int         @default(0) @map("chunk_index")
  // Note: embedding vector stored as JSON until pgvector is enabled
  // For production, use: embedding Unsupported("vector(1536)")?
  embeddingJson String?     @map("embedding_json") @db.Text
  metadata      Json?
  isProcessed   Boolean     @default(false) @map("is_processed")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, documentType])
  @@index([associationId, isProcessed])
  @@map("document_embeddings")
}

// ============================================
// PHASE 4.5: VOTING & ELECTIONS MODELS
// Digital voting, elections, and polls
// ============================================

// Election Model
model Election {
  id                  Int                @id @default(autoincrement())
  associationId       Int                @map("association_id")
  title               String
  description         String?            @db.Text
  electionType        ElectionType       @default(GENERAL) @map("election_type")
  status              ElectionStatus     @default(DRAFT)
  nominationStartDate DateTime?          @map("nomination_start_date")
  nominationEndDate   DateTime?          @map("nomination_end_date")
  votingStartDate     DateTime           @map("voting_start_date")
  votingEndDate       DateTime           @map("voting_end_date")
  maxVotesPerMember   Int                @default(1) @map("max_votes_per_member")
  allowAbstention     Boolean            @default(true) @map("allow_abstention")
  isAnonymous         Boolean            @default(true) @map("is_anonymous")
  requiresQuorum      Boolean            @default(false) @map("requires_quorum")
  quorumPercentage    Int?               @map("quorum_percentage")
  eligibleVoterCount  Int                @default(0) @map("eligible_voter_count")
  totalVotesCast      Int                @default(0) @map("total_votes_cast")
  createdBy           Int                @map("created_by")
  publishedBy         Int?               @map("published_by")
  publishedAt         DateTime?          @map("published_at")
  cancelledBy         Int?               @map("cancelled_by")
  cancelledAt         DateTime?          @map("cancelled_at")
  cancellationReason  String?            @map("cancellation_reason")
  // Who may vote and who may stand, set by the association (null = every active member, the default). See eligibility-rules.ts.
  eligibilityRules    Json?              @map("eligibility_rules")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  association         Association        @relation(fields: [associationId], references: [id], onDelete: Cascade)
  creator             User               @relation("ElectionCreatedBy", fields: [createdBy], references: [id])
  publisher           User?              @relation("ElectionPublishedBy", fields: [publishedBy], references: [id])
  canceller           User?              @relation("ElectionCancelledBy", fields: [cancelledBy], references: [id])
  positions           ElectionPosition[]
  candidates          Candidate[]
  votes               Vote[]
  eligibilityExceptions ElectionEligibilityException[]

  @@index([associationId, status])
  @@index([associationId, votingStartDate])
  @@index([votingStartDate, votingEndDate])
  @@map("elections")
}

// Election Position (for elections with multiple positions)
model ElectionPosition {
  id            Int         @id @default(autoincrement())
  electionId    Int         @map("election_id")
  title         String
  description   String?
  maxCandidates Int         @default(1) @map("max_candidates")
  orderNumber   Int         @default(0) @map("order_number")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  election      Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates    Candidate[]
  votes         Vote[]

  @@unique([electionId, orderNumber])
  @@index([electionId])
  @@map("election_positions")
}

// A named member let in, or kept out, of one election's vote or candidacy, whatever the rules say — with the reason on record.
model ElectionEligibilityException {
  id         Int      @id @default(autoincrement())
  electionId Int      @map("election_id")
  memberId   Int      @map("member_id")
  scope      String // VOTE | STAND
  kind       String // ALLOW | BAR
  reason     String
  createdBy  Int      @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([electionId, memberId, scope])
  @@index([electionId])
  @@map("election_eligibility_exceptions")
}

// Candidate Model
model Candidate {
  id               Int               @id @default(autoincrement())
  electionId       Int               @map("election_id")
  positionId       Int?              @map("position_id")
  memberId         Int               @map("member_id")
  manifesto        String?           @db.Text
  photoUrl         String?           @map("photo_url")
  status           CandidateStatus   @default(PENDING)
  nominatedBy      Int?              @map("nominated_by")
  nominatedAt      DateTime          @default(now()) @map("nominated_at")
  approvedBy       Int?              @map("approved_by")
  approvedAt       DateTime?         @map("approved_at")
  rejectionReason  String?           @map("rejection_reason")
  withdrawnAt      DateTime?         @map("withdrawn_at")
  withdrawalReason String?           @map("withdrawal_reason")
  voteCount        Int               @default(0) @map("vote_count")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  election         Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position         ElectionPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  member           Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  nominator        User?             @relation("CandidateNominatedBy", fields: [nominatedBy], references: [id])
  approver         User?             @relation("CandidateApprovedBy", fields: [approvedBy], references: [id])
  votes            Vote[]

  @@unique([electionId, positionId, memberId])
  @@index([electionId, status])
  @@index([positionId])
  @@index([memberId])
  @@map("candidates")
}

// Vote Model
model Vote {
  id           Int               @id @default(autoincrement())
  electionId   Int               @map("election_id")
  positionId   Int?              @map("position_id")
  candidateId  Int?              @map("candidate_id")
  voterId      Int               @map("voter_id")
  voteHash     String            @map("vote_hash") // For verification without revealing voter
  isAbstention Boolean           @default(false) @map("is_abstention")
  votedAt      DateTime          @default(now()) @map("voted_at")
  election     Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position     ElectionPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  candidate    Candidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  voter        Member            @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([electionId, positionId, voterId])
  @@index([electionId])
  @@index([candidateId])
  @@index([voterId])
  @@map("votes")
}

// Poll Model
model Poll {
  id                   Int            @id @default(autoincrement())
  associationId        Int            @map("association_id")
  title                String
  description          String?        @db.Text
  pollType             PollType       @default(SINGLE_CHOICE) @map("poll_type")
  status               PollStatus     @default(DRAFT)
  startDate            DateTime       @map("start_date")
  endDate              DateTime       @map("end_date")
  allowMultipleVotes   Boolean        @default(false) @map("allow_multiple_votes")
  maxChoices           Int?           @map("max_choices")
  isAnonymous          Boolean        @default(true) @map("is_anonymous")
  showResultsBeforeEnd Boolean        @default(false) @map("show_results_before_end")
  totalResponses       Int            @default(0) @map("total_responses")
  createdBy            Int            @map("created_by")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  association          Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  creator              User           @relation("PollCreatedBy", fields: [createdBy], references: [id])
  options              PollOption[]
  responses            PollResponse[]

  @@index([associationId, status])
  @@index([associationId, startDate])
  @@index([startDate, endDate])
  @@map("polls")
}

// Poll Option Model
model PollOption {
  id          Int            @id @default(autoincrement())
  pollId      Int            @map("poll_id")
  optionText  String         @map("option_text")
  orderNumber Int            @default(0) @map("order_number")
  voteCount   Int            @default(0) @map("vote_count")
  createdAt   DateTime       @default(now()) @map("created_at")
  poll        Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses   PollResponse[]

  @@unique([pollId, orderNumber])
  @@index([pollId])
  @@map("poll_options")
}

// Poll Response Model
model PollResponse {
  id           Int        @id @default(autoincrement())
  pollId       Int        @map("poll_id")
  optionId     Int        @map("option_id")
  responderId  Int        @map("responder_id")
  responseHash String     @map("response_hash") // For verification without revealing responder
  respondedAt  DateTime   @default(now()) @map("responded_at")
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option       PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  responder    Member     @relation(fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, responderId])
  @@index([pollId])
  @@index([optionId])
  @@index([responderId])
  @@map("poll_responses")
}

// Voting Enums
enum ElectionType {
  GENERAL // General election for all positions
  EXECUTIVE // Executive committee election
  COMMITTEE // Committee member election
  SPECIAL // Special purpose election
}

enum ElectionStatus {
  DRAFT // Being created
  NOMINATIONS_OPEN // Accepting nominations
  NOMINATIONS_CLOSED // Nominations closed, candidates being finalised before voting
  VOTING_OPEN // Voting in progress
  VOTING_CLOSED // Voting ended, results being processed
  RESULTS_PUBLISHED // Results announced
  CANCELLED // Election cancelled
}

enum CandidateStatus {
  PENDING // Awaiting approval
  APPROVED // Approved to contest
  REJECTED // Nomination rejected
  WITHDRAWN // Candidate withdrew
}

enum PollType {
  YES_NO // Simple yes/no poll
  MULTIPLE_CHOICE // Select multiple options
  SINGLE_CHOICE // Select one option
  RATING // Rating scale (1-5, 1-10, etc.)
}

enum PollStatus {
  DRAFT // Being created
  ACTIVE // Poll is live
  CLOSED // Poll ended
  CANCELLED // Poll cancelled
}

// ============================================
// RBAC SYSTEM MODELS - Database-driven Roles & Permissions
// ============================================

// Permission Model - Global permissions registry
model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique // e.g., "members.view", "ledger.create"
  description     String
  module          String // e.g., "Members", "Finance/Ledger"
  examples        String[]         @default([]) // Usage examples
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@index([module])
  @@index([isActive])
  @@map("permissions")
}

// Role Model - Association-scoped roles (except platform roles)
model Role {
  id            Int              @id @default(autoincrement())
  associationId Int?             @map("association_id") // NULL for platform roles
  name          String
  displayName   String           @map("display_name")
  description   String?
  isSystemRole  Boolean          @default(false) @map("is_system_role") // Cannot be deleted/modified
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  association   Association?     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  userRoles     UserRole[]

  @@unique([associationId, name])
  @@index([associationId, isActive])
  @@index([isSystemRole])
  @@map("roles")
}

// Role-Permission Junction Table
model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// User-Role Junction Table - Users can have multiple roles per association
model UserRole {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  roleId        Int         @map("role_id")
  associationId Int         @map("association_id")
  assignedBy    Int?        @map("assigned_by")
  assignedAt    DateTime    @default(now()) @map("assigned_at")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  assigner      User?       @relation("UserRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId, associationId])
  @@index([userId, associationId])
  @@index([roleId])
  @@index([associationId])
  @@map("user_roles")
}

// ============================================
// PHASE 19: SAAS OWNER / SUPER ADMIN PLATFORM CONTROLS
// Module & Feature Flags, Billing Overrides, Platform Action Logging
// ============================================

// Platform Module Definition - High-level modules
model PlatformModule {
  id            Int               @id @default(autoincrement())
  code          String            @unique // e.g., "members", "ledger", "payments"
  name          String
  description   String?
  isCore        Boolean           @default(false) @map("is_core") // Core modules can't be disabled
  sortOrder     Int               @default(0) @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  features      PlatformFeature[]
  planModules   PlanModule[]
  tenantModules TenantModule[]

  @@index([isCore])
  @@map("platform_modules")
}

// Platform Feature Definition - Fine-grained features within modules
model PlatformFeature {
  id             Int             @id @default(autoincrement())
  moduleId       Int             @map("module_id")
  code           String          @unique // e.g., "ledger.export", "audit.export"
  name           String
  description    String?
  isCore         Boolean         @default(false) @map("is_core")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  module         PlatformModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  planFeatures   PlanFeature[]
  tenantFeatures TenantFeature[]

  @@index([moduleId])
  @@map("platform_features")
}

// Plan-Module Assignment - What modules each plan includes
model PlanModule {
  id        Int            @id @default(autoincrement())
  planId    Int            @map("plan_id")
  moduleId  Int            @map("module_id")
  isEnabled Boolean        @default(true) @map("is_enabled")
  createdAt DateTime       @default(now()) @map("created_at")
  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@index([planId])
  @@index([moduleId])
  @@map("plan_modules")
}

// Plan-Feature Assignment - What features each plan includes
model PlanFeature {
  id        Int             @id @default(autoincrement())
  planId    Int             @map("plan_id")
  featureId Int             @map("feature_id")
  isEnabled Boolean         @default(true) @map("is_enabled")
  createdAt DateTime        @default(now()) @map("created_at")
  plan      Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
  @@map("plan_features")
}

// Tenant-Module Override - Per-tenant module overrides
model TenantModule {
  id            Int            @id @default(autoincrement())
  associationId Int            @map("association_id")
  moduleId      Int            @map("module_id")
  isEnabled     Boolean        @map("is_enabled")
  overrideType  OverrideType   @default(MANUAL) @map("override_type")
  reason        String?
  overriddenBy  Int            @map("overridden_by")
  expiresAt     DateTime?      @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  association   Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  module        PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([associationId, moduleId])
  @@index([associationId])
  @@index([moduleId])
  @@index([expiresAt])
  @@map("tenant_modules")
}

// Tenant-Feature Override - Per-tenant feature overrides
model TenantFeature {
  id            Int             @id @default(autoincrement())
  associationId Int             @map("association_id")
  featureId     Int             @map("feature_id")
  isEnabled     Boolean         @map("is_enabled")
  overrideType  OverrideType    @default(MANUAL) @map("override_type")
  reason        String?
  overriddenBy  Int             @map("overridden_by")
  expiresAt     DateTime?       @map("expires_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  association   Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  feature       PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([associationId, featureId])
  @@index([associationId])
  @@index([featureId])
  @@index([expiresAt])
  @@map("tenant_features")
}

// Billing Override - Billing exceptions and manual controls
model BillingOverride {
  id            Int                 @id @default(autoincrement())
  associationId Int                 @map("association_id")
  overrideType  BillingOverrideType @map("override_type")
  value         String? // JSON or simple value depending on type
  reason        String
  startDate     DateTime            @default(now()) @map("start_date")
  endDate       DateTime?           @map("end_date")
  isActive      Boolean             @default(true) @map("is_active")
  createdBy     Int                 @map("created_by")
  revokedBy     Int?                @map("revoked_by")
  revokedAt     DateTime?           @map("revoked_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  association   Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, isActive])
  @@index([overrideType])
  @@index([endDate])
  @@map("billing_overrides")
}

// Platform Action Log - Comprehensive audit trail for platform admin actions
model PlatformActionLog {
  id            Int      @id @default(autoincrement())
  actorId       Int      @map("actor_id")
  actorRole     String   @map("actor_role")
  actionType    String   @map("action_type")
  targetType    String   @map("target_type") // association, user, module, feature, billing
  targetId      Int?     @map("target_id")
  associationId Int?     @map("association_id")
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  reason        String?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([actionType])
  @@index([targetType])
  @@index([associationId])
  @@index([createdAt])
  @@map("platform_action_logs")
}

// Override Type Enum - Types of tenant overrides
enum OverrideType {
  MANUAL // Admin manually set
  TRIAL // Trial period override
  PROMOTION // Promotional access
  SUPPORT // Support-granted access
  COMPLIANCE // Compliance requirement
}

// Billing Override Type Enum - Types of billing exceptions
enum BillingOverrideType {
  BYPASS_BILLING // Skip all billing
  EXTEND_TRIAL // Extend trial period
  PAUSE_BILLING // Pause billing temporarily
  APPLY_CREDIT // Apply credit to account
  MARK_PAID_EXTERNAL // Paid outside system
  OVERRIDE_PLAN // Force specific plan
  GRACE_PERIOD // Grace period for payment
}

// ============================================
// PHASE 21: HELP & SUPPORT MODULE
// ============================================

// Help Article - Knowledge base articles
model HelpArticle {
  id              Int          @id @default(autoincrement())
  associationId   Int?         @map("association_id") // null = global article
  slug            String       @unique
  title           String
  content         String       @db.Text
  excerpt         String?
  category        String // getting_started, members, finance, reports, settings, troubleshooting
  tags            String[]     @default([])
  roleVisibility  String[]     @default(["admin", "treasurer", "member"]) @map("role_visibility")
  isPublished     Boolean      @default(true) @map("is_published")
  isFeatured      Boolean      @default(false) @map("is_featured")
  viewCount       Int          @default(0) @map("view_count")
  helpfulCount    Int          @default(0) @map("helpful_count")
  notHelpfulCount Int          @default(0) @map("not_helpful_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  association     Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([isPublished, isFeatured])
  @@index([associationId])
  @@map("help_articles")
}

// FAQ Item - Frequently asked questions
model FAQItem {
  id             Int          @id @default(autoincrement())
  associationId  Int?         @map("association_id") // null = global FAQ
  question       String
  answer         String       @db.Text
  category       String // general, payments, members, reports, technical
  roleVisibility String[]     @default(["admin", "treasurer", "member"]) @map("role_visibility")
  sortOrder      Int          @default(0) @map("sort_order")
  isActive       Boolean      @default(true) @map("is_active")
  viewCount      Int          @default(0) @map("view_count")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  association    Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([category, isActive])
  @@index([associationId])
  @@map("faq_items")
}

// Support Ticket - User support requests
model SupportTicket {
  id                      Int                @id @default(autoincrement())
  associationId           Int                @map("association_id")
  userId                  Int                @map("user_id")
  ticketNumber            String             @unique @map("ticket_number") // TKT-YYYYMMDD-XXXX
  subject                 String
  description             String             @db.Text
  category                TicketCategory
  priority                TicketPriority     @default(MEDIUM)
  status                  TicketStatus       @default(OPEN)
  audience                TicketAudience     @default(ASSOCIATION)
  // Set on a Tier 2 ticket an officer opened by escalating a member's ticket (the member's ticket is never shared)
  escalatedFromId         Int?               @map("escalated_from_id")
  // AI-generated fields
  aiCategory              String?            @map("ai_category")
  aiCategoryConfidence    Float?             @map("ai_category_confidence")
  aiSentiment             String?            @map("ai_sentiment") // positive, neutral, negative, urgent
  aiSentimentScore        Float?             @map("ai_sentiment_score")
  aiEscalationRecommended Boolean            @default(false) @map("ai_escalation_recommended")
  // Assignment
  assignedToId            Int?               @map("assigned_to_id")
  // Timestamps
  resolvedAt              DateTime?          @map("resolved_at")
  closedAt                DateTime?          @map("closed_at")
  firstResponseAt         DateTime?          @map("first_response_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  // Relations
  association             Association        @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user                    User               @relation("TicketCreator", fields: [userId], references: [id])
  assignedTo              User?              @relation("TicketAssignee", fields: [assignedToId], references: [id])
  escalatedFrom           SupportTicket?     @relation("TicketEscalation", fields: [escalatedFromId], references: [id], onDelete: SetNull)
  escalations             SupportTicket[]    @relation("TicketEscalation")
  responses               TicketResponse[]
  attachments             TicketAttachment[]

  @@index([associationId, status])
  @@index([audience, status])
  @@index([escalatedFromId])
  @@index([userId])
  @@index([assignedToId])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@map("support_tickets")
}

// Ticket Response - Replies to support tickets
model TicketResponse {
  id            Int                @id @default(autoincrement())
  ticketId      Int                @map("ticket_id")
  userId        Int                @map("user_id")
  message       String             @db.Text
  isStaff       Boolean            @default(false) @map("is_staff")
  isInternal    Boolean            @default(false) @map("is_internal") // Internal notes not visible to user
  // AI-generated response
  isAiGenerated Boolean            @default(false) @map("is_ai_generated")
  aiConfidence  Float?             @map("ai_confidence")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  // Relations
  ticket        SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id])
  attachments   TicketAttachment[]

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_responses")
}

// Ticket Attachment - Files attached to tickets/responses
model TicketAttachment {
  id           Int             @id @default(autoincrement())
  ticketId     Int             @map("ticket_id")
  responseId   Int?            @map("response_id")
  userId       Int             @map("user_id")
  filename     String
  originalName String          @map("original_name")
  mimeType     String          @map("mime_type")
  fileSize     Int             @map("file_size") // bytes
  filePath     String          @map("file_path")
  createdAt    DateTime        @default(now()) @map("created_at")
  // Relations
  ticket       SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  response     TicketResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([responseId])
  @@map("ticket_attachments")
}

// Ticket Category Enum
enum TicketCategory {
  ACCESS // Login, permissions, account issues
  PAYMENTS // Payment processing, reconciliation
  REPORTS // Report generation, exports
  MEMBERS // Member management issues
  TECHNICAL // Technical issues, bugs
  BUG // Bug reports
  FEATURE_REQUEST // Feature requests
  BILLING // Subscription, plans, invoices (Tier 2: association admin to SocietyLedger)
  DATA // Data corrections and imports (Tier 2)
  OTHER // Other inquiries
}

// Who a ticket is for. ASSOCIATION = a member asking their own association's admins (Tier 1);
// PLATFORM = an association admin asking SocietyLedger support (Tier 2).
enum TicketAudience {
  ASSOCIATION
  PLATFORM
}

// Ticket Priority Enum
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Ticket Status Enum
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  WAITING_ON_STAFF
  RESOLVED
  CLOSED
}

// ============================================
// PHASE 14: WEBHOOKS MANAGEMENT MODELS
// ============================================

// Webhook Event Log - Track all webhook events (incoming and test)
model WebhookEventLog {
  id                  Int                  @id @default(autoincrement())
  associationId       Int                  @map("association_id")
  eventType           String               @map("event_type")
  status              WebhookEventStatus   @default(PENDING)
  statusCode          Int?                 @map("status_code")
  duration            Int?                 @map("duration")
  payload             Json?                @map("payload")
  responseBody        Json?                @map("response_body")
  errorMessage        String?              @map("error_message")
  source              String               @default("paystack") @map("source")
  endpoint            String?              @map("endpoint")
  retryCount          Int                  @default(0) @map("retry_count")
  isTest              Boolean              @default(false) @map("is_test")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  association         Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([associationId, eventType])
  @@index([associationId, source])
  @@index([associationId, createdAt])
  @@index([isTest])
  @@map("webhook_event_logs")
}

enum WebhookEventStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// ============================================
// BLOG & DOCUMENTATION SYSTEM MODELS
// Platform-level CMS for Super Admins
// ============================================

// Blog & Documentation Enums
enum ContentScope {
  PLATFORM
  ASSOCIATION  // Future extensibility
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

enum DocStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Blog Post Model
model BlogPost {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  coverImage      String?   // Cloudinary URL
  status          PostStatus @default(DRAFT)
  scope           ContentScope @default(PLATFORM)
  publishedAt     DateTime?
  viewCount       Int       @default(0)
  readTimeMinutes Int?
  
  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]  @default([])
  
  // Full-text search vector (managed by PostgreSQL triggers)
  searchVector    Unsupported("tsvector")?
  
  // Relations
  authorId        Int
  author          User      @relation("BlogPostAuthor", fields: [authorId], references: [id])
  categoryId      Int?
  category        BlogCategory? @relation(fields: [categoryId], references: [id])
  tags            BlogPostTag[]
  comments        BlogComment[]
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@map("blog_posts")
  @@index([status, publishedAt])
  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([status, viewCount], name: "blog_posts_status_viewcount_idx")
  @@index([searchVector], type: Gin, name: "blog_posts_search_idx")
}

// Blog Category Model
model BlogCategory {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  color       String?     // Hex color for UI
  posts       BlogPost[]
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  @@map("blog_categories")
}

// Blog Tag Model
model BlogTag {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String        @unique
  posts     BlogPostTag[]
  
  createdAt DateTime      @default(now()) @map("created_at")
  
  @@map("blog_tags")
}

// Blog Post Tag Junction Table
model BlogPostTag {
  postId    Int
  tagId     Int
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([postId, tagId])
  @@map("blog_post_tags")
}

// Blog Comment Model
model BlogComment {
  id        Int       @id @default(autoincrement())
  content   String    @db.Text
  status    CommentStatus @default(PENDING)
  
  postId    Int
  post      BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Authenticated user (optional)
  authorId  Int?
  author    User?     @relation("BlogCommentAuthor", fields: [authorId], references: [id])
  
  // Guest comments (optional)
  guestName  String?
  guestEmail String?
  
  // Threading
  parentId  Int?
  parent    BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   BlogComment[] @relation("CommentReplies")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  @@map("blog_comments")
  @@index([postId, status])
}

// Documentation Page Model
model DocPage {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  content         String    @db.Text
  excerpt         String?
  order           Int       @default(0)
  scope           ContentScope @default(PLATFORM)
  
  // Hierarchy
  parentId        Int?
  parent          DocPage?  @relation("DocPageHierarchy", fields: [parentId], references: [id])
  children        DocPage[] @relation("DocPageHierarchy")
  
  // Section
  sectionId       Int?
  section         DocSection? @relation(fields: [sectionId], references: [id])
  
  // SEO
  metaTitle       String?
  metaDescription String?
  
  // Versioning
  version         String    @default("1.0")
  isLatest        Boolean   @default(true)
  
  // Status
  status          DocStatus @default(DRAFT)
  publishedAt     DateTime?
  
  // Analytics
  viewCount       Int       @default(0)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  
  // Full-text search vector (managed by PostgreSQL triggers)
  searchVector    Unsupported("tsvector")?
  
  // Relations
  authorId        Int
  author          User      @relation("DocPageAuthor", fields: [authorId], references: [id])
  feedback        DocFeedback[]
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@map("doc_pages")
  @@index([status, publishedAt])
  @@index([slug])
  @@index([sectionId])
  @@index([parentId])
  @@index([status, viewCount], name: "doc_pages_status_viewcount_idx")
  @@index([searchVector], type: Gin, name: "doc_pages_search_idx")
}

// Documentation Section Model
model DocSection {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  icon        String?   // Icon name (e.g., "rocket", "book")
  order       Int       @default(0)
  pages       DocPage[]
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  @@map("doc_sections")
  @@index([order])
}

// Documentation Feedback Model
model DocFeedback {
  id        Int      @id @default(autoincrement())
  pageId    Int
  page      DocPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  isHelpful Boolean
  comment   String?  @db.Text

  // Authenticated user (optional)
  userId    Int?
  user      User?    @relation("DocFeedbackUser", fields: [userId], references: [id])

  // Anonymous feedback
  email     String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("doc_feedback")
  @@index([pageId])
}

// ============================================================
// A1.3 — Impersonation handoff (B4)
// One-time 60s code so the admin console never passes a JWT in a URL
// ============================================================
model ImpersonationHandoff {
  id              Int       @id @default(autoincrement())
  codeHash        String    @unique @map("code_hash")
  adminUserId     Int       @map("admin_user_id")
  adminUser       User      @relation(fields: [adminUserId], references: [id])
  associationId   Int       @map("association_id")
  association     Association @relation(fields: [associationId], references: [id])
  reason          String
  durationMinutes Int       @default(240) @map("duration_minutes")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("impersonation_handoffs")
}

// ============================================================
// A2.12 — Platform admin invites: email-link invite flow for adding
// new platform admin console users. tokenHash follows the same
// SHA-256-of-a-random-token pattern as ImpersonationHandoff above
// (never store the raw token — only what's needed to verify it).
// ============================================================
model PlatformAdminInvite {
  id           Int          @id @default(autoincrement())
  email        String
  platformRole PlatformRole @map("platform_role")
  tokenHash    String       @unique @map("token_hash")
  invitedById  Int          @map("invited_by")
  invitedBy    User         @relation("PlatformAdminInvitedBy", fields: [invitedById], references: [id])
  expiresAt    DateTime     @map("expires_at")
  acceptedAt   DateTime?    @map("accepted_at")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("platform_admin_invites")
}

// ============================================================
// A1.4 — TOTP 2FA for platform users (B5)
// ============================================================
model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("recovery_codes")
}

model AdminLoginChallenge {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("admin_login_challenges")
}

// ============================================
// Cash collections & lodgments
// ============================================
// Officers collect cash from members at meetings and later lodge it into an association bank account. Additive: the existing
// payment, savings, welfare, donation and loan tables are untouched — a receipt item points at the record it created by (kind, source_id).

// One occasion (a meeting or a day) on which an officer collects cash. Owned by the collector.
model CashCollection {
  id            Int                  @id @default(autoincrement())
  associationId Int                  @map("association_id")
  meetingId     Int?                 @map("meeting_id")
  title         String
  collectedBy   Int                  @map("collected_by") // User id of the officer holding the cash
  status        CashCollectionStatus @default(OPEN)
  notes         String?
  openedAt      DateTime             @default(now()) @map("opened_at")
  closedAt      DateTime?            @map("closed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  association Association              @relation(fields: [associationId], references: [id], onDelete: Cascade)
  receipts    CashReceipt[]
  allocations CashLodgmentAllocation[]

  @@index([associationId, status])
  @@index([associationId, collectedBy])
  @@index([meetingId])
  @@map("cash_collections")
}

// One member's cash payment inside a collection. It credits the member at once; the idempotency key makes a retry safe.
model CashReceipt {
  id             Int               @id @default(autoincrement())
  associationId  Int               @map("association_id")
  collectionId   Int               @map("collection_id")
  memberId       Int               @map("member_id")
  receiptNumber  String            @unique @map("receipt_number")
  idempotencyKey String            @map("idempotency_key")
  totalAmount    Decimal           @map("total_amount") @db.Decimal(12, 2)
  status         CashReceiptStatus @default(ACTIVE)
  createdBy      Int               @map("created_by")
  voidedBy       Int?              @map("voided_by")
  voidedAt       DateTime?         @map("voided_at")
  voidReason     String?           @map("void_reason")
  createdAt      DateTime          @default(now()) @map("created_at")

  association Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  collection  CashCollection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items       CashReceiptItem[]

  @@unique([associationId, idempotencyKey])
  @@index([collectionId, status])
  @@index([associationId, memberId])
  @@map("cash_receipts")
}

// What a receipt paid: one line per thing, pointing at the record the existing flow created.
model CashReceiptItem {
  id        Int          @id @default(autoincrement())
  receiptId Int          @map("receipt_id")
  kind      CashItemKind
  sourceId  Int?         @map("source_id") // payments / savings_transactions / welfare_contributions / donation_records / loan_repayments id
  label     String
  amount    Decimal      @db.Decimal(12, 2)

  receipt CashReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([kind, sourceId])
  @@map("cash_receipt_items")
}

// Cash paid into an association bank account, with a deposit-slip photo. A different officer verifies it against the statement.
model CashLodgment {
  id                Int                @id @default(autoincrement())
  associationId     Int                @map("association_id")
  bankAccountId     Int                @map("bank_account_id")
  lodgedBy          Int                @map("lodged_by")
  amount            Decimal            @db.Decimal(12, 2)
  expectedAmount    Decimal            @map("expected_amount") @db.Decimal(12, 2)
  shortfallReason   String?            @map("shortfall_reason")
  depositDate       DateTime           @map("deposit_date")
  bankReference     String?            @map("bank_reference")
  slipKey           String?            @map("slip_key")
  status            CashLodgmentStatus @default(PENDING)
  verifiedBy        Int?               @map("verified_by")
  verifiedAt        DateTime?          @map("verified_at")
  rejectionReason   String?            @map("rejection_reason")
  accountingEntryId Int?               @map("accounting_entry_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  association Association              @relation(fields: [associationId], references: [id], onDelete: Cascade)
  allocations CashLodgmentAllocation[]

  @@index([associationId, status])
  @@index([associationId, lodgedBy])
  @@map("cash_lodgments")
}

// How much of a lodgment came out of which collection.
model CashLodgmentAllocation {
  id           Int     @id @default(autoincrement())
  lodgmentId   Int     @map("lodgment_id")
  collectionId Int     @map("collection_id")
  amount       Decimal @db.Decimal(12, 2)

  lodgment   CashLodgment   @relation(fields: [lodgmentId], references: [id], onDelete: Cascade)
  collection CashCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([lodgmentId, collectionId])
  @@index([collectionId])
  @@map("cash_lodgment_allocations")
}

enum CashCollectionStatus {
  OPEN
  CLOSED
}

enum CashReceiptStatus {
  ACTIVE
  VOIDED
}

enum CashItemKind {
  DUES
  LEVY
  SAVINGS
  WELFARE
  DONATION
  LOAN_REPAYMENT
}

enum CashLodgmentStatus {
  PENDING
  VERIFIED
  REJECTED
}
