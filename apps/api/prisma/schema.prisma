// Chart of Accounts (TASK-ACC-001)
model ChartOfAccount {
  id                Int                @id @default(autoincrement())
  associationId     Int                @map("association_id")
  code              String // Account code (e.g., "1000", "2000")
  name              String
  type              AccountType // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  subType           String?            @map("sub_type") // e.g., "current_asset", "fixed_asset"
  description       String?
  parentId          Int?               @map("parent_id")
  isActive          Boolean            @default(true) @map("is_active")
  isSystemAccount   Boolean            @default(false) @map("is_system_account") // Cannot be deleted
  normalBalance     NormalBalance      @default(DEBIT) @map("normal_balance")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  association       Association        @relation(fields: [associationId], references: [id])
  parent            ChartOfAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          ChartOfAccount[]   @relation("AccountHierarchy")
  journalEntryLines JournalEntryLine[]
  budgetItems       BudgetItem[]
  expenseCategories ExpenseVoucher[]   @relation("ExpenseCategory")
  expensesPaidFrom  ExpenseVoucher[]   @relation("ExpensePaidFrom")

  @@unique([associationId, code])
  @@index([associationId, type])
  @@index([parentId])
  @@map("chart_of_accounts")
}

// Expense voucher: spending recorded after it is paid. A different officer approves it, and approval posts it to the books
// (debit the category account, credit the account it was paid from). A wrong one is voided, which posts a reversal.
model ExpenseVoucher {
  id                Int            @id @default(autoincrement())
  associationId     Int            @map("association_id")
  voucherNumber     String         @map("voucher_number") // EXP-2026-00001
  expenseDate       DateTime       @map("expense_date")
  payee             String
  description       String
  amount            Decimal        @db.Decimal(12, 2)
  categoryAccountId Int            @map("category_account_id")
  paidFromAccountId Int            @map("paid_from_account_id")
  reference         String?
  noReceiptReason   String?        @map("no_receipt_reason")
  receiptKey        String?        @map("receipt_key")
  receiptType       String?        @map("receipt_type")
  status            ExpenseStatus  @default(DRAFT)
  createdBy         Int            @map("created_by")
  submittedAt       DateTime?      @map("submitted_at")
  approvedBy        Int?           @map("approved_by")
  approvedAt        DateTime?      @map("approved_at")
  overBudget        Boolean        @default(false) @map("over_budget")
  rejectedBy        Int?           @map("rejected_by")
  rejectedAt        DateTime?      @map("rejected_at")
  rejectionReason   String?        @map("rejection_reason")
  voidedBy          Int?           @map("voided_by")
  voidedAt          DateTime?      @map("voided_at")
  voidReason        String?        @map("void_reason")
  journalEntryId    Int?           @map("journal_entry_id")
  reversalEntryId   Int?           @map("reversal_entry_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  association       Association    @relation(fields: [associationId], references: [id])
  category          ChartOfAccount @relation("ExpenseCategory", fields: [categoryAccountId], references: [id])
  paidFrom          ChartOfAccount @relation("ExpensePaidFrom", fields: [paidFromAccountId], references: [id])

  @@unique([associationId, voucherNumber])
  @@index([associationId, status])
  @@index([associationId, expenseDate])
  @@index([categoryAccountId])
  @@map("expense_vouchers")
}

// Journal Entry (TASK-ACC-002)
model JournalEntry {
  id              Int                @id @default(autoincrement())
  associationId   Int                @map("association_id")
  entryNumber     String             @map("entry_number") // Auto-generated
  entryDate       DateTime           @map("entry_date")
  description     String
  reference       String? // External reference (e.g., invoice number)
  sourceType      String?            @map("source_type") // manual, auto_sync, adjustment
  sourceId        Int?               @map("source_id") // Reference to source transaction
  status          JournalEntryStatus @default(DRAFT)
  totalDebit      Decimal            @map("total_debit") @db.Decimal(12, 2)
  totalCredit     Decimal            @map("total_credit") @db.Decimal(12, 2)
  createdBy       Int                @map("created_by")
  approvedBy      Int?               @map("approved_by")
  approvedAt      DateTime?          @map("approved_at")
  rejectedBy      Int?               @map("rejected_by")
  rejectedAt      DateTime?          @map("rejected_at")
  rejectionReason String?            @map("rejection_reason")
  postedAt        DateTime?          @map("posted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  association     Association        @relation(fields: [associationId], references: [id])
  creator         User               @relation("JournalEntryCreatedBy", fields: [createdBy], references: [id])
  approver        User?              @relation("JournalEntryApprovedBy", fields: [approvedBy], references: [id])
  rejecter        User?              @relation("JournalEntryRejectedBy", fields: [rejectedBy], references: [id])
  lines           JournalEntryLine[]

  @@unique([associationId, entryNumber])
  @@index([associationId, status])
  @@index([associationId, entryDate])
  @@map("journal_entries")
}

// Journal Entry Line (Double-entry bookkeeping)
model JournalEntryLine {
  id             Int            @id @default(autoincrement())
  journalEntryId Int            @map("journal_entry_id")
  accountId      Int            @map("account_id")
  debitAmount    Decimal        @default(0) @map("debit_amount") @db.Decimal(12, 2)
  creditAmount   Decimal        @default(0) @map("credit_amount") @db.Decimal(12, 2)
  description    String?
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// Budget (TASK-ACC-006)
model Budget {
  id            Int          @id @default(autoincrement())
  associationId Int          @map("association_id")
  name          String
  description   String?
  fiscalYear    Int          @map("fiscal_year")
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  status        BudgetStatus @default(DRAFT)
  totalBudget   Decimal      @map("total_budget") @db.Decimal(12, 2)
  createdBy     Int          @map("created_by")
  approvedBy    Int?         @map("approved_by")
  approvedAt    DateTime?    @map("approved_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  association   Association  @relation(fields: [associationId], references: [id])
  creator       User         @relation("BudgetCreatedBy", fields: [createdBy], references: [id])
  approver      User?        @relation("BudgetApprovedBy", fields: [approvedBy], references: [id])
  items         BudgetItem[]

  @@unique([associationId, fiscalYear, name])
  @@index([associationId, fiscalYear])
  @@map("budgets")
}

// Budget Item (Line items for budget)
model BudgetItem {
  id            Int            @id @default(autoincrement())
  budgetId      Int            @map("budget_id")
  accountId     Int            @map("account_id")
  monthlyAmount Decimal        @map("monthly_amount") @db.Decimal(12, 2)
  q1Amount      Decimal?       @map("q1_amount") @db.Decimal(12, 2)
  q2Amount      Decimal?       @map("q2_amount") @db.Decimal(12, 2)
  q3Amount      Decimal?       @map("q3_amount") @db.Decimal(12, 2)
  q4Amount      Decimal?       @map("q4_amount") @db.Decimal(12, 2)
  annualAmount  Decimal        @map("annual_amount") @db.Decimal(12, 2)
  notes         String?
  budget        Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account       ChartOfAccount @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId])
  @@index([budgetId])
  @@map("budget_items")
}

// Accounting Period (for closing books)
model AccountingPeriod {
  id            Int          @id @default(autoincrement())
  associationId Int          @map("association_id")
  name          String // e.g., "January 2025", "Q1 2025"
  periodType    String       @map("period_type") // month, quarter, year
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  status        PeriodStatus @default(OPEN)
  closedBy      Int?         @map("closed_by")
  closedAt      DateTime?    @map("closed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  association   Association  @relation(fields: [associationId], references: [id])
  closer        User?        @relation("PeriodClosedBy", fields: [closedBy], references: [id])

  @@unique([associationId, startDate, endDate])
  @@index([associationId, status])
  @@map("accounting_periods")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  VOIDED
}

enum JournalEntryStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  VOIDED
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  CLOSED
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

// ============================================
// PHASE 3.5: NIGERIAN PAYMENT FEATURES MODELS
// ============================================

// Association Bank Accounts (TASK-PAY-002)
model AssociationBankAccount {
  id               Int                   @id @default(autoincrement())
  associationId    Int                   @map("association_id")
  bankName         String                @map("bank_name")
  accountName      String                @map("account_name")
  accountNumber    String                @map("account_number")
  bankCode         String?               @map("bank_code") // Nigerian bank codes
  isDefault        Boolean               @default(false) @map("is_default")
  isActive         Boolean               @default(true) @map("is_active")
  description      String?
  // How this bank's statement columns were read last time (by header text), so the next import needs no correction
  statementMapping Json?                 @map("statement_mapping")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  association      Association           @relation(fields: [associationId], references: [id])
  bankTransfers    BankTransfer[]
  statementImports BankStatementImport[]
  statementEntries BankStatementEntry[]

  @@unique([associationId, accountNumber])
  @@index([associationId, isActive])
  @@map("association_bank_accounts")
}

// Bank Transfer Tracking (TASK-PAY-001)
model BankTransfer {
  id                  Int                     @id @default(autoincrement())
  associationId       Int                     @map("association_id")
  transactionId       Int?                    @map("transaction_id") // Link to financial transaction
  bankAccountId       Int?                    @map("bank_account_id") // Receiving bank account
  memberId            Int?                    @map("member_id")
  senderBankName      String                  @map("sender_bank_name")
  senderAccountNumber String?                 @map("sender_account_number")
  senderAccountName   String?                 @map("sender_account_name")
  amount              Decimal                 @db.Decimal(12, 2)
  reference           String // Bank transfer reference
  transferDate        DateTime                @map("transfer_date")
  narration           String?
  status              BankTransferStatus      @default(PENDING)
  reconciliationId    Int?                    @map("reconciliation_id")
  recordedBy          Int?                    @map("recorded_by") // The officer who entered it; they cannot also verify it
  verifiedBy          Int?                    @map("verified_by")
  verifiedAt          DateTime?               @map("verified_at")
  notes               String?
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  association         Association             @relation(fields: [associationId], references: [id])
  transaction         Transaction?            @relation(fields: [transactionId], references: [id])
  bankAccount         AssociationBankAccount? @relation(fields: [bankAccountId], references: [id])
  member              Member?                 @relation(fields: [memberId], references: [id])
  reconciliation      PaymentReconciliation?  @relation(fields: [reconciliationId], references: [id])
  paymentProofs       PaymentProof[]

  @@index([associationId, status])
  @@index([reference])
  @@index([transactionId])
  @@map("bank_transfers")
}

// Bank Statement Import (TASK-PAY-005)
model BankStatementImport {
  id               Int                    @id @default(autoincrement())
  associationId    Int                    @map("association_id")
  bankAccountId    Int                    @map("bank_account_id")
  filename         String
  importDate       DateTime               @default(now()) @map("import_date")
  startDate        DateTime?              @map("start_date")
  endDate          DateTime?              @map("end_date")
  totalEntries     Int                    @default(0) @map("total_entries")
  matchedEntries   Int                    @default(0) @map("matched_entries")
  unmatchedEntries Int                    @default(0) @map("unmatched_entries")
  // Lines that were already imported before (an overlapping or repeated statement) and so were not added again
  skippedEntries   Int                    @default(0) @map("skipped_entries")
  status           ImportStatus           @default(PROCESSING)
  importedBy       Int                    @map("imported_by")
  createdAt        DateTime               @default(now()) @map("created_at")
  association      Association            @relation(fields: [associationId], references: [id])
  bankAccount      AssociationBankAccount @relation(fields: [bankAccountId], references: [id])
  entries          BankStatementEntry[]

  @@index([associationId, status])
  @@map("bank_statement_imports")
}

// Bank Statement Entry (individual rows from imported statement)
model BankStatementEntry {
  id                    Int                 @id @default(autoincrement())
  importId              Int                 @map("import_id")
  transactionDate       DateTime            @map("transaction_date")
  valueDate             DateTime?           @map("value_date")
  reference             String?
  description           String
  debitAmount           Decimal?            @map("debit_amount") @db.Decimal(12, 2)
  creditAmount          Decimal?            @map("credit_amount") @db.Decimal(12, 2)
  balance               Decimal?            @db.Decimal(12, 2)
  matchStatus           MatchStatus         @default(UNMATCHED) @map("match_status")
  matchedTransactionId  Int?                @map("matched_transaction_id")
  matchedBankTransferId Int?                @map("matched_bank_transfer_id")
  matchConfidence       Int?                @map("match_confidence") // 0-100 percentage
  matchedAt             DateTime?           @map("matched_at")
  matchedBy             Int?                @map("matched_by")
  // Identity of the line (see statement-parser.ts): the same line is never imported twice for one bank account
  bankAccountId         Int?                @map("bank_account_id")
  fingerprint           String?
  createdAt             DateTime            @default(now()) @map("created_at")
  import                BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  bankAccount           AssociationBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, fingerprint])
  @@index([importId, matchStatus])
  @@index([reference])
  @@map("bank_statement_entries")
}

// Payment Reconciliation (TASK-PAY-003)
model PaymentReconciliation {
  id               Int                     @id @default(autoincrement())
  associationId    Int                     @map("association_id")
  transactionId    Int                     @map("transaction_id")
  statementEntryId Int?                    @map("statement_entry_id")
  matchType        ReconciliationMatchType @map("match_type")
  matchedAmount    Decimal                 @map("matched_amount") @db.Decimal(12, 2)
  variance         Decimal                 @default(0) @db.Decimal(12, 2) // Difference if any
  status           ReconciliationStatus    @default(PENDING)
  reconciledBy     Int?                    @map("reconciled_by")
  reconciledAt     DateTime?               @map("reconciled_at")
  // Who proposed the match: they cannot also confirm it
  createdBy        Int?                    @map("created_by")
  notes            String?
  createdAt        DateTime                @default(now()) @map("created_at")
  association      Association             @relation(fields: [associationId], references: [id])
  transaction      Transaction             @relation(fields: [transactionId], references: [id])
  bankTransfers    BankTransfer[]

  @@index([associationId, status])
  @@index([transactionId])
  @@map("payment_reconciliations")
}

// Payment Proof Upload (TASK-PAY-007)
model PaymentProof {
  id              Int                @id @default(autoincrement())
  associationId   Int                @map("association_id")
  transactionId   Int?               @map("transaction_id")
  // R7.2 (G17): a member can declare one payment covering several outstanding
  // transactions at once (the existing /me/pay UI already supports multi-select) —
  // transactionId alone can't represent that, so the member-declare flow uses this
  // instead. transactionId stays as-is for the pre-existing single-transaction
  // officer/bank-transfer-reconciliation use case.
  transactionIds  Int[]              @default([]) @map("transaction_ids")
  bankTransferId  Int?               @map("bank_transfer_id")
  memberId        Int                @map("member_id")
  // R7.2 (G17): nullable — a Cash/Card/POS self-declared payment has no file, only a
  // written declaration (declarationNote). Exactly one of (filename set) or
  // (declarationNote set) is required; enforced in application code, not the DB.
  filename        String?
  filepath        String?
  fileSize        Int?               @map("file_size")
  mimeType        String?            @map("mime_type")
  declarationNote String?            @map("declaration_note") @db.Text
  paymentMethod   String?            @map("payment_method")
  status          PaymentProofStatus @default(PENDING)
  uploadedAt      DateTime           @default(now()) @map("uploaded_at")
  verifiedBy      Int?               @map("verified_by")
  verifiedAt      DateTime?          @map("verified_at")
  rejectionReason String?            @map("rejection_reason")
  notes           String?
  association     Association        @relation(fields: [associationId], references: [id])
  transaction     Transaction?       @relation(fields: [transactionId], references: [id])
  bankTransfer    BankTransfer?      @relation(fields: [bankTransferId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])

  @@index([associationId, status])
  @@index([transactionId])
  @@index([memberId])
  @@map("payment_proofs")
}

enum BankTransferStatus {
  PENDING
  VERIFIED
  MATCHED
  REJECTED
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum MatchStatus {
  UNMATCHED
  AUTO_MATCHED
  MANUAL_MATCHED
  REJECTED
}

enum ReconciliationMatchType {
  AUTO_REFERENCE // Matched by reference number
  AUTO_AMOUNT // Matched by amount
  MANUAL // Manually matched by admin
}

enum ReconciliationStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// PHASE 8.5: COOPERATIVES & LOANS MODELS
// Enterprise Feature - Thrift & Savings, Loans, Guarantors
// ============================================

// Savings Account
model SavingsAccount {
  id                  Int                  @id @default(autoincrement())
  associationId       Int                  @map("association_id")
  memberId            Int                  @map("member_id")
  accountNumber       String               @map("account_number")
  accountType         SavingsAccountType   @default(REGULAR) @map("account_type")
  balance             Decimal              @default(0) @db.Decimal(12, 2)
  targetAmount        Decimal?             @map("target_amount") @db.Decimal(12, 2)
  monthlyContribution Decimal?             @map("monthly_contribution") @db.Decimal(12, 2)
  interestRate        Decimal              @default(0) @map("interest_rate") @db.Decimal(5, 2)
  accruedInterest     Decimal              @default(0) @map("accrued_interest") @db.Decimal(12, 2)
  totalDeposits       Decimal              @default(0) @map("total_deposits") @db.Decimal(12, 2)
  totalWithdrawals    Decimal              @default(0) @map("total_withdrawals") @db.Decimal(12, 2)
  status              SavingsAccountStatus @default(ACTIVE)
  maturityDate        DateTime?            @map("maturity_date")
  openedAt            DateTime             @default(now()) @map("opened_at")
  closedAt            DateTime?            @map("closed_at")
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  association         Association          @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member              Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transactions        SavingsTransaction[]
  depositRequests     SavingsDepositRequest[]

  @@unique([associationId, accountNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@map("savings_accounts")
}

// Savings Transaction
model SavingsTransaction {
  id               Int                    @id @default(autoincrement())
  associationId    Int                    @map("association_id")
  savingsAccountId Int                    @map("savings_account_id")
  type             SavingsTransactionType
  amount           Decimal                @db.Decimal(12, 2)
  balanceAfter     Decimal                @map("balance_after") @db.Decimal(12, 2)
  paymentMethod    String?                @map("payment_method")
  reference        String?
  processedBy      Int                    @map("processed_by")
  notes            String?
  createdAt        DateTime               @default(now()) @map("created_at")
  transactionDate  DateTime               @default(now()) @map("transaction_date")
  
  // Accounting integration sync tracking
  accountingSynced Boolean                @default(false) @map("accounting_synced")
  accountingEntryId Int?                  @map("accounting_entry_id")
  
  association      Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  savingsAccount   SavingsAccount         @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  processor        User                   @relation("SavingsTransactionProcessor", fields: [processedBy], references: [id])

  @@index([savingsAccountId])
  @@index([createdAt])
  @@map("savings_transactions")
}

// A member's claim that they paid money into the cooperative's bank account, with a receipt attached.
// It is pending until an officer confirms the money landed; only approval creates the real
// SavingsTransaction and raises the balance (the balance never moves on a pending request).
model SavingsDepositRequest {
  id                   Int                  @id @default(autoincrement())
  associationId        Int                  @map("association_id")
  savingsAccountId     Int                  @map("savings_account_id")
  memberId             Int                  @map("member_id")
  amount               Decimal              @db.Decimal(12, 2)
  paymentDate          DateTime             @map("payment_date")
  bankAccountId        Int?                 @map("bank_account_id")
  reference            String?
  memberNote           String?              @map("member_note")
  filename             String
  filepath             String // MinIO object key
  fileSize             Int?                 @map("file_size")
  mimeType             String?              @map("mime_type")
  status               SavingsDepositStatus @default(PENDING)
  reviewedBy           Int?                 @map("reviewed_by")
  reviewedAt           DateTime?            @map("reviewed_at")
  rejectionReason      String?              @map("rejection_reason")
  savingsTransactionId Int?                 @map("savings_transaction_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  association    Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  savingsAccount SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([memberId])
  @@index([savingsAccountId])
  @@map("savings_deposit_requests")
}

enum SavingsDepositStatus {
  PENDING
  APPROVED
  REJECTED
}

// Part of a member's savings held against an active loan. It is created when the loan is disbursed and
// released as the principal is repaid; while it is outstanding it cannot be withdrawn or borrowed against
// again. The savings balance itself is untouched — available = balance - outstanding liens.
model SavingsLien {
  id             Int              @id @default(autoincrement())
  associationId  Int              @map("association_id")
  memberId       Int              @map("member_id")
  loanId         Int              @unique @map("loan_id")
  amount         Decimal          @db.Decimal(12, 2)
  releasedAmount Decimal          @default(0) @map("released_amount") @db.Decimal(12, 2)
  status         SavingsLienStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([associationId, memberId, status])
  @@map("savings_liens")
}

enum SavingsLienStatus {
  ACTIVE
  RELEASED
}

// A member's claim that they paid money towards a loan, with a receipt attached. Pending until an officer
// confirms the money landed; only approval records the real LoanRepayment (which also releases held savings).
model LoanRepaymentRequest {
  id              Int                        @id @default(autoincrement())
  associationId   Int                        @map("association_id")
  loanId          Int                        @map("loan_id")
  memberId        Int                        @map("member_id")
  amount          Decimal                    @db.Decimal(12, 2)
  paymentDate     DateTime                   @map("payment_date")
  bankAccountId   Int?                       @map("bank_account_id")
  reference       String?
  memberNote      String?                    @map("member_note")
  filename        String
  filepath        String // MinIO object key
  fileSize        Int?                       @map("file_size")
  mimeType        String?                    @map("mime_type")
  status          LoanRepaymentRequestStatus @default(PENDING)
  reviewedBy      Int?                       @map("reviewed_by")
  reviewedAt      DateTime?                  @map("reviewed_at")
  rejectionReason String?                    @map("rejection_reason")
  loanRepaymentId Int?                       @map("loan_repayment_id")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([memberId])
  @@index([loanId])
  @@map("loan_repayment_requests")
}

enum LoanRepaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Loan Product
model LoanProduct {
  id                    Int               @id @default(autoincrement())
  associationId         Int               @map("association_id")
  name                  String
  description           String?
  minAmount             Decimal           @map("min_amount") @db.Decimal(12, 2)
  maxAmount             Decimal           @map("max_amount") @db.Decimal(12, 2)
  interestRate          Decimal           @map("interest_rate") @db.Decimal(5, 2)
  interestType          InterestType      @default(REDUCING_BALANCE) @map("interest_type")
  minTenureMonths       Int               @map("min_tenure_months")
  maxTenureMonths       Int               @map("max_tenure_months")
  processingFeePercent  Decimal           @default(0) @map("processing_fee_percent") @db.Decimal(5, 2)
  processingFeeFixed    Decimal           @default(0) @map("processing_fee_fixed") @db.Decimal(10, 2)
  requiresGuarantor     Boolean           @default(true) @map("requires_guarantor")
  minGuarantors         Int               @default(1) @map("min_guarantors")
  maxLoanToSavingsRatio Decimal?          @map("max_loan_to_savings_ratio") @db.Decimal(5, 2)
  // When set together with the ratio, disbursing a loan puts principal / ratio of the member's savings on
  // hold (a SavingsLien) until the loan is repaid. The balance is never debited — it is held, not spent.
  lockSavings           Boolean           @default(true) @map("lock_savings")
  gracePeriodDays       Int               @default(0) @map("grace_period_days")
  lateFeePercent        Decimal           @default(0) @map("late_fee_percent") @db.Decimal(5, 2)
  lateFeeFixed          Decimal           @default(0) @map("late_fee_fixed") @db.Decimal(10, 2)
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  association           Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  applications          LoanApplication[]
  loans                 Loan[]

  @@unique([associationId, name])
  @@index([associationId, isActive])
  @@map("loan_products")
}

// Loan Application
model LoanApplication {
  id                    Int                   @id @default(autoincrement())
  associationId         Int                   @map("association_id")
  applicationNumber     String                @map("application_number")
  memberId              Int                   @map("member_id")
  loanProductId         Int                   @map("loan_product_id")
  amount                Decimal               @db.Decimal(12, 2)
  tenureMonths          Int                   @map("tenure_months")
  interestRate          Decimal               @map("interest_rate") @db.Decimal(5, 2)
  interestType          InterestType          @map("interest_type")
  monthlyRepayment      Decimal               @map("monthly_repayment") @db.Decimal(12, 2)
  totalRepayment        Decimal               @map("total_repayment") @db.Decimal(12, 2)
  totalInterest         Decimal               @map("total_interest") @db.Decimal(12, 2)
  processingFee         Decimal               @default(0) @map("processing_fee") @db.Decimal(10, 2)
  purpose               String
  status                LoanApplicationStatus @default(DRAFT)
  collateralDescription String?               @map("collateral_description")
  collateralValue       Decimal?              @map("collateral_value") @db.Decimal(12, 2)
  appliedAt             DateTime              @default(now()) @map("applied_at")
  reviewedBy            Int?                  @map("reviewed_by")
  reviewedAt            DateTime?             @map("reviewed_at")
  reviewComments        String?               @map("review_comments")
  approvedBy            Int?                  @map("approved_by")
  approvedAt            DateTime?             @map("approved_at")
  rejectionReason       String?               @map("rejection_reason")
  disbursedAt           DateTime?             @map("disbursed_at")
  cancelledAt           DateTime?             @map("cancelled_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  association           Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member                Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanProduct           LoanProduct           @relation(fields: [loanProductId], references: [id])
  reviewer              User?                 @relation("LoanApplicationReviewer", fields: [reviewedBy], references: [id])
  approver              User?                 @relation("LoanApplicationApprover", fields: [approvedBy], references: [id])
  guarantors            LoanGuarantor[]
  loan                  Loan?

  @@unique([associationId, applicationNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@map("loan_applications")
}

// Loan Guarantor
model LoanGuarantor {
  id                Int             @id @default(autoincrement())
  associationId     Int             @map("association_id")
  loanApplicationId Int             @map("loan_application_id")
  guarantorMemberId Int             @map("guarantor_member_id")
  guaranteeAmount   Decimal         @map("guarantee_amount") @db.Decimal(12, 2)
  status            GuarantorStatus @default(PENDING)
  acceptedAt        DateTime?       @map("accepted_at")
  declinedAt        DateTime?       @map("declined_at")
  declineReason     String?         @map("decline_reason")
  releasedAt        DateTime?       @map("released_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  association       Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  guarantorMember   Member          @relation(fields: [guarantorMemberId], references: [id], onDelete: Cascade)

  @@unique([loanApplicationId, guarantorMemberId])
  @@index([loanApplicationId])
  @@index([guarantorMemberId, status])
  @@map("loan_guarantors")
}

// Active Loan
model Loan {
  id                 Int                     @id @default(autoincrement())
  associationId      Int                     @map("association_id")
  loanNumber         String                  @map("loan_number")
  applicationId      Int                     @unique @map("application_id")
  memberId           Int                     @map("member_id")
  loanProductId      Int                     @map("loan_product_id")
  principalAmount    Decimal                 @map("principal_amount") @db.Decimal(12, 2)
  interestRate       Decimal                 @map("interest_rate") @db.Decimal(5, 2)
  interestType       InterestType            @map("interest_type")
  tenureMonths       Int                     @map("tenure_months")
  monthlyRepayment   Decimal                 @map("monthly_repayment") @db.Decimal(12, 2)
  totalRepayment     Decimal                 @map("total_repayment") @db.Decimal(12, 2)
  totalInterest      Decimal                 @map("total_interest") @db.Decimal(12, 2)
  processingFee      Decimal                 @default(0) @map("processing_fee") @db.Decimal(10, 2)
  amountDisbursed    Decimal                 @map("amount_disbursed") @db.Decimal(12, 2)
  totalPaid          Decimal                 @default(0) @map("total_paid") @db.Decimal(12, 2)
  principalPaid      Decimal                 @default(0) @map("principal_paid") @db.Decimal(12, 2)
  interestPaid       Decimal                 @default(0) @map("interest_paid") @db.Decimal(12, 2)
  outstandingBalance Decimal                 @map("outstanding_balance") @db.Decimal(12, 2)
  nextPaymentDate    DateTime?               @map("next_payment_date") @db.Date
  nextPaymentAmount  Decimal?                @map("next_payment_amount") @db.Decimal(12, 2)
  status             LoanStatus              @default(ACTIVE)
  disbursedAt        DateTime                @map("disbursed_at")
  maturityDate       DateTime                @map("maturity_date") @db.Date
  closedAt           DateTime?               @map("closed_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  
  // Accounting integration sync tracking
  accountingSynced   Boolean                 @default(false) @map("accounting_synced")
  accountingEntryId  Int?                    @map("accounting_entry_id")
  
  association        Association             @relation(fields: [associationId], references: [id], onDelete: Cascade)
  application        LoanApplication         @relation(fields: [applicationId], references: [id])
  member             Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanProduct        LoanProduct             @relation(fields: [loanProductId], references: [id])
  repaymentSchedule  LoanRepaymentSchedule[]
  repayments         LoanRepayment[]
  savingsLien        SavingsLien?
  repaymentRequests  LoanRepaymentRequest[]

  @@unique([associationId, loanNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@index([nextPaymentDate])
  @@map("loans")
}

// Loan Repayment Schedule
model LoanRepaymentSchedule {
  id                Int             @id @default(autoincrement())
  loanId            Int             @map("loan_id")
  installmentNumber Int             @map("installment_number")
  dueDate           DateTime        @map("due_date") @db.Date
  principalDue      Decimal         @map("principal_due") @db.Decimal(12, 2)
  interestDue       Decimal         @map("interest_due") @db.Decimal(12, 2)
  totalDue          Decimal         @map("total_due") @db.Decimal(12, 2)
  principalPaid     Decimal         @default(0) @map("principal_paid") @db.Decimal(12, 2)
  interestPaid      Decimal         @default(0) @map("interest_paid") @db.Decimal(12, 2)
  totalPaid         Decimal         @default(0) @map("total_paid") @db.Decimal(12, 2)
  lateFee           Decimal         @default(0) @map("late_fee") @db.Decimal(10, 2)
  status            RepaymentStatus @default(PENDING)
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  loan              Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  repayments        LoanRepayment[]

  @@unique([loanId, installmentNumber])
  @@index([loanId])
  @@index([dueDate, status])
  @@map("loan_repayment_schedule")
}

// Loan Repayment
model LoanRepayment {
  id               Int                    @id @default(autoincrement())
  associationId    Int                    @map("association_id")
  loanId           Int                    @map("loan_id")
  scheduleItemId   Int?                   @map("schedule_item_id")
  amount           Decimal                @db.Decimal(12, 2)
  principalPortion Decimal                @map("principal_portion") @db.Decimal(12, 2)
  interestPortion  Decimal                @map("interest_portion") @db.Decimal(12, 2)
  lateFee          Decimal                @default(0) @map("late_fee") @db.Decimal(10, 2)
  paymentMethod    String                 @map("payment_method")
  reference        String?
  processedBy      Int                    @map("processed_by")
  notes            String?
  paidAt           DateTime               @default(now()) @map("paid_at")
  paymentDate      DateTime               @default(now()) @map("payment_date")
  createdAt        DateTime               @default(now()) @map("created_at")
  
  // Accounting integration sync tracking
  accountingSynced Boolean                @default(false) @map("accounting_synced")
  accountingEntryId Int?                  @map("accounting_entry_id")
  
  association      Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  loan             Loan                   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  scheduleItem     LoanRepaymentSchedule? @relation(fields: [scheduleItemId], references: [id])
  processor        User                   @relation("LoanRepaymentProcessor", fields: [processedBy], references: [id])

  @@index([loanId])
  @@index([paidAt])
  @@map("loan_repayments")
}

