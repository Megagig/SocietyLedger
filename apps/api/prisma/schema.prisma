model BankStatementEntry {
  id                    Int                 @id @default(autoincrement())
  importId              Int                 @map("import_id")
  transactionDate       DateTime            @map("transaction_date")
  valueDate             DateTime?           @map("value_date")
  reference             String?
  description           String
  debitAmount           Decimal?            @map("debit_amount") @db.Decimal(12, 2)
  creditAmount          Decimal?            @map("credit_amount") @db.Decimal(12, 2)
  balance               Decimal?            @db.Decimal(12, 2)
  matchStatus           MatchStatus         @default(UNMATCHED) @map("match_status")
  matchedTransactionId  Int?                @map("matched_transaction_id")
  matchedBankTransferId Int?                @map("matched_bank_transfer_id")
  matchConfidence       Int?                @map("match_confidence") // 0-100 percentage
  matchedAt             DateTime?           @map("matched_at")
  matchedBy             Int?                @map("matched_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  import                BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, matchStatus])
  @@index([reference])
  @@map("bank_statement_entries")
}

// Payment Reconciliation (TASK-PAY-003)
model PaymentReconciliation {
  id               Int                     @id @default(autoincrement())
  associationId    Int                     @map("association_id")
  transactionId    Int                     @map("transaction_id")
  statementEntryId Int?                    @map("statement_entry_id")
  matchType        ReconciliationMatchType @map("match_type")
  matchedAmount    Decimal                 @map("matched_amount") @db.Decimal(12, 2)
  variance         Decimal                 @default(0) @db.Decimal(12, 2) // Difference if any
  status           ReconciliationStatus    @default(PENDING)
  reconciledBy     Int?                    @map("reconciled_by")
  reconciledAt     DateTime?               @map("reconciled_at")
  notes            String?
  createdAt        DateTime                @default(now()) @map("created_at")
  association      Association             @relation(fields: [associationId], references: [id])
  transaction      Transaction             @relation(fields: [transactionId], references: [id])
  bankTransfers    BankTransfer[]

  @@index([associationId, status])
  @@index([transactionId])
  @@map("payment_reconciliations")
}

// Payment Proof Upload (TASK-PAY-007)
model PaymentProof {
  id              Int                @id @default(autoincrement())
  associationId   Int                @map("association_id")
  transactionId   Int?               @map("transaction_id")
  // R7.2 (G17): a member can declare one payment covering several outstanding
  // transactions at once (the existing /me/pay UI already supports multi-select) —
  // transactionId alone can't represent that, so the member-declare flow uses this
  // instead. transactionId stays as-is for the pre-existing single-transaction
  // officer/bank-transfer-reconciliation use case.
  transactionIds  Int[]              @default([]) @map("transaction_ids")
  bankTransferId  Int?               @map("bank_transfer_id")
  memberId        Int                @map("member_id")
  // R7.2 (G17): nullable — a Cash/Card/POS self-declared payment has no file, only a
  // written declaration (declarationNote). Exactly one of (filename set) or
  // (declarationNote set) is required; enforced in application code, not the DB.
  filename        String?
  filepath        String?
  fileSize        Int?               @map("file_size")
  mimeType        String?            @map("mime_type")
  declarationNote String?            @map("declaration_note") @db.Text
  paymentMethod   String?            @map("payment_method")
  status          PaymentProofStatus @default(PENDING)
  uploadedAt      DateTime           @default(now()) @map("uploaded_at")
  verifiedBy      Int?               @map("verified_by")
  verifiedAt      DateTime?          @map("verified_at")
  rejectionReason String?            @map("rejection_reason")
  notes           String?
  association     Association        @relation(fields: [associationId], references: [id])
  transaction     Transaction?       @relation(fields: [transactionId], references: [id])
  bankTransfer    BankTransfer?      @relation(fields: [bankTransferId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])

  @@index([associationId, status])
  @@index([transactionId])
  @@index([memberId])
  @@map("payment_proofs")
}

enum BankTransferStatus {
  PENDING
  VERIFIED
  MATCHED
  REJECTED
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum MatchStatus {
  UNMATCHED
  AUTO_MATCHED
  MANUAL_MATCHED
  REJECTED
}

enum ReconciliationMatchType {
  AUTO_REFERENCE // Matched by reference number
  AUTO_AMOUNT // Matched by amount
  MANUAL // Manually matched by admin
}

enum ReconciliationStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// PHASE 8.5: COOPERATIVES & LOANS MODELS
// Enterprise Feature - Thrift & Savings, Loans, Guarantors
// ============================================

// Savings Account
model SavingsAccount {
  id                  Int                  @id @default(autoincrement())
  associationId       Int                  @map("association_id")
  memberId            Int                  @map("member_id")
  accountNumber       String               @map("account_number")
  accountType         SavingsAccountType   @default(REGULAR) @map("account_type")
  balance             Decimal              @default(0) @db.Decimal(12, 2)
  targetAmount        Decimal?             @map("target_amount") @db.Decimal(12, 2)
  monthlyContribution Decimal?             @map("monthly_contribution") @db.Decimal(12, 2)
  interestRate        Decimal              @default(0) @map("interest_rate") @db.Decimal(5, 2)
  accruedInterest     Decimal              @default(0) @map("accrued_interest") @db.Decimal(12, 2)
  totalDeposits       Decimal              @default(0) @map("total_deposits") @db.Decimal(12, 2)
  totalWithdrawals    Decimal              @default(0) @map("total_withdrawals") @db.Decimal(12, 2)
  status              SavingsAccountStatus @default(ACTIVE)
  maturityDate        DateTime?            @map("maturity_date")
  openedAt            DateTime             @default(now()) @map("opened_at")
  closedAt            DateTime?            @map("closed_at")
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  association         Association          @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member              Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transactions        SavingsTransaction[]
  depositRequests     SavingsDepositRequest[]

  @@unique([associationId, accountNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@map("savings_accounts")
}

// Savings Transaction
model SavingsTransaction {
  id               Int                    @id @default(autoincrement())
  associationId    Int                    @map("association_id")
  savingsAccountId Int                    @map("savings_account_id")
  type             SavingsTransactionType
  amount           Decimal                @db.Decimal(12, 2)
  balanceAfter     Decimal                @map("balance_after") @db.Decimal(12, 2)
  paymentMethod    String?                @map("payment_method")
  reference        String?
  processedBy      Int                    @map("processed_by")
  notes            String?
  createdAt        DateTime               @default(now()) @map("created_at")
  transactionDate  DateTime               @default(now()) @map("transaction_date")
  
  // Accounting integration sync tracking
  accountingSynced Boolean                @default(false) @map("accounting_synced")
  accountingEntryId Int?                  @map("accounting_entry_id")
  
  association      Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  savingsAccount   SavingsAccount         @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  processor        User                   @relation("SavingsTransactionProcessor", fields: [processedBy], references: [id])

  @@index([savingsAccountId])
  @@index([createdAt])
  @@map("savings_transactions")
}

// A member's claim that they paid money into the cooperative's bank account, with a receipt attached.
// It is pending until an officer confirms the money landed; only approval creates the real
// SavingsTransaction and raises the balance (the balance never moves on a pending request).
model SavingsDepositRequest {
  id                   Int                  @id @default(autoincrement())
  associationId        Int                  @map("association_id")
  savingsAccountId     Int                  @map("savings_account_id")
  memberId             Int                  @map("member_id")
  amount               Decimal              @db.Decimal(12, 2)
  paymentDate          DateTime             @map("payment_date")
  bankAccountId        Int?                 @map("bank_account_id")
  reference            String?
  memberNote           String?              @map("member_note")
  filename             String
  filepath             String // MinIO object key
  fileSize             Int?                 @map("file_size")
  mimeType             String?              @map("mime_type")
  status               SavingsDepositStatus @default(PENDING)
  reviewedBy           Int?                 @map("reviewed_by")
  reviewedAt           DateTime?            @map("reviewed_at")
  rejectionReason      String?              @map("rejection_reason")
  savingsTransactionId Int?                 @map("savings_transaction_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  association    Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  savingsAccount SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([memberId])
  @@index([savingsAccountId])
  @@map("savings_deposit_requests")
}

enum SavingsDepositStatus {
  PENDING
  APPROVED
  REJECTED
}

// Part of a member's savings held against an active loan. It is created when the loan is disbursed and
// released as the principal is repaid; while it is outstanding it cannot be withdrawn or borrowed against
// again. The savings balance itself is untouched — available = balance - outstanding liens.
model SavingsLien {
  id             Int              @id @default(autoincrement())
  associationId  Int              @map("association_id")
  memberId       Int              @map("member_id")
  loanId         Int              @unique @map("loan_id")
  amount         Decimal          @db.Decimal(12, 2)
  releasedAmount Decimal          @default(0) @map("released_amount") @db.Decimal(12, 2)
  status         SavingsLienStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([associationId, memberId, status])
  @@map("savings_liens")
}

enum SavingsLienStatus {
  ACTIVE
  RELEASED
}

// A member's claim that they paid money towards a loan, with a receipt attached. Pending until an officer
// confirms the money landed; only approval records the real LoanRepayment (which also releases held savings).
model LoanRepaymentRequest {
  id              Int                        @id @default(autoincrement())
  associationId   Int                        @map("association_id")
  loanId          Int                        @map("loan_id")
  memberId        Int                        @map("member_id")
  amount          Decimal                    @db.Decimal(12, 2)
  paymentDate     DateTime                   @map("payment_date")
  bankAccountId   Int?                       @map("bank_account_id")
  reference       String?
  memberNote      String?                    @map("member_note")
  filename        String
  filepath        String // MinIO object key
  fileSize        Int?                       @map("file_size")
  mimeType        String?                    @map("mime_type")
  status          LoanRepaymentRequestStatus @default(PENDING)
  reviewedBy      Int?                       @map("reviewed_by")
  reviewedAt      DateTime?                  @map("reviewed_at")
  rejectionReason String?                    @map("rejection_reason")
  loanRepaymentId Int?                       @map("loan_repayment_id")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([memberId])
  @@index([loanId])
  @@map("loan_repayment_requests")
}

enum LoanRepaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Loan Product
model LoanProduct {
  id                    Int               @id @default(autoincrement())
  associationId         Int               @map("association_id")
  name                  String
  description           String?
  minAmount             Decimal           @map("min_amount") @db.Decimal(12, 2)
  maxAmount             Decimal           @map("max_amount") @db.Decimal(12, 2)
  interestRate          Decimal           @map("interest_rate") @db.Decimal(5, 2)
  interestType          InterestType      @default(REDUCING_BALANCE) @map("interest_type")
  minTenureMonths       Int               @map("min_tenure_months")
  maxTenureMonths       Int               @map("max_tenure_months")
  processingFeePercent  Decimal           @default(0) @map("processing_fee_percent") @db.Decimal(5, 2)
  processingFeeFixed    Decimal           @default(0) @map("processing_fee_fixed") @db.Decimal(10, 2)
  requiresGuarantor     Boolean           @default(true) @map("requires_guarantor")
  minGuarantors         Int               @default(1) @map("min_guarantors")
  maxLoanToSavingsRatio Decimal?          @map("max_loan_to_savings_ratio") @db.Decimal(5, 2)
  // When set together with the ratio, disbursing a loan puts principal / ratio of the member's savings on
  // hold (a SavingsLien) until the loan is repaid. The balance is never debited — it is held, not spent.
  lockSavings           Boolean           @default(true) @map("lock_savings")
  gracePeriodDays       Int               @default(0) @map("grace_period_days")
  lateFeePercent        Decimal           @default(0) @map("late_fee_percent") @db.Decimal(5, 2)
  lateFeeFixed          Decimal           @default(0) @map("late_fee_fixed") @db.Decimal(10, 2)
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  association           Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  applications          LoanApplication[]
  loans                 Loan[]

  @@unique([associationId, name])
  @@index([associationId, isActive])
  @@map("loan_products")
}

// Loan Application
model LoanApplication {
  id                    Int                   @id @default(autoincrement())
  associationId         Int                   @map("association_id")
  applicationNumber     String                @map("application_number")
  memberId              Int                   @map("member_id")
  loanProductId         Int                   @map("loan_product_id")
  amount                Decimal               @db.Decimal(12, 2)
  tenureMonths          Int                   @map("tenure_months")
  interestRate          Decimal               @map("interest_rate") @db.Decimal(5, 2)
  interestType          InterestType          @map("interest_type")
  monthlyRepayment      Decimal               @map("monthly_repayment") @db.Decimal(12, 2)
  totalRepayment        Decimal               @map("total_repayment") @db.Decimal(12, 2)
  totalInterest         Decimal               @map("total_interest") @db.Decimal(12, 2)
  processingFee         Decimal               @default(0) @map("processing_fee") @db.Decimal(10, 2)
  purpose               String
  status                LoanApplicationStatus @default(DRAFT)
  collateralDescription String?               @map("collateral_description")
  collateralValue       Decimal?              @map("collateral_value") @db.Decimal(12, 2)
  appliedAt             DateTime              @default(now()) @map("applied_at")
  reviewedBy            Int?                  @map("reviewed_by")
  reviewedAt            DateTime?             @map("reviewed_at")
  reviewComments        String?               @map("review_comments")
  approvedBy            Int?                  @map("approved_by")
  approvedAt            DateTime?             @map("approved_at")
  rejectionReason       String?               @map("rejection_reason")
  disbursedAt           DateTime?             @map("disbursed_at")
  cancelledAt           DateTime?             @map("cancelled_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  association           Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member                Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanProduct           LoanProduct           @relation(fields: [loanProductId], references: [id])
  reviewer              User?                 @relation("LoanApplicationReviewer", fields: [reviewedBy], references: [id])
  approver              User?                 @relation("LoanApplicationApprover", fields: [approvedBy], references: [id])
  guarantors            LoanGuarantor[]
  loan                  Loan?

  @@unique([associationId, applicationNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@map("loan_applications")
}

// Loan Guarantor
model LoanGuarantor {
  id                Int             @id @default(autoincrement())
  associationId     Int             @map("association_id")
  loanApplicationId Int             @map("loan_application_id")
  guarantorMemberId Int             @map("guarantor_member_id")
  guaranteeAmount   Decimal         @map("guarantee_amount") @db.Decimal(12, 2)
  status            GuarantorStatus @default(PENDING)
  acceptedAt        DateTime?       @map("accepted_at")
  declinedAt        DateTime?       @map("declined_at")
  declineReason     String?         @map("decline_reason")
  releasedAt        DateTime?       @map("released_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  association       Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  guarantorMember   Member          @relation(fields: [guarantorMemberId], references: [id], onDelete: Cascade)

  @@unique([loanApplicationId, guarantorMemberId])
  @@index([loanApplicationId])
  @@index([guarantorMemberId, status])
  @@map("loan_guarantors")
}

// Active Loan
model Loan {
  id                 Int                     @id @default(autoincrement())
  associationId      Int                     @map("association_id")
  loanNumber         String                  @map("loan_number")
  applicationId      Int                     @unique @map("application_id")
  memberId           Int                     @map("member_id")
  loanProductId      Int                     @map("loan_product_id")
  principalAmount    Decimal                 @map("principal_amount") @db.Decimal(12, 2)
  interestRate       Decimal                 @map("interest_rate") @db.Decimal(5, 2)
  interestType       InterestType            @map("interest_type")
  tenureMonths       Int                     @map("tenure_months")
  monthlyRepayment   Decimal                 @map("monthly_repayment") @db.Decimal(12, 2)
  totalRepayment     Decimal                 @map("total_repayment") @db.Decimal(12, 2)
  totalInterest      Decimal                 @map("total_interest") @db.Decimal(12, 2)
  processingFee      Decimal                 @default(0) @map("processing_fee") @db.Decimal(10, 2)
  amountDisbursed    Decimal                 @map("amount_disbursed") @db.Decimal(12, 2)
  totalPaid          Decimal                 @default(0) @map("total_paid") @db.Decimal(12, 2)
  principalPaid      Decimal                 @default(0) @map("principal_paid") @db.Decimal(12, 2)
  interestPaid       Decimal                 @default(0) @map("interest_paid") @db.Decimal(12, 2)
  outstandingBalance Decimal                 @map("outstanding_balance") @db.Decimal(12, 2)
  nextPaymentDate    DateTime?               @map("next_payment_date") @db.Date
  nextPaymentAmount  Decimal?                @map("next_payment_amount") @db.Decimal(12, 2)
  status             LoanStatus              @default(ACTIVE)
  disbursedAt        DateTime                @map("disbursed_at")
  maturityDate       DateTime                @map("maturity_date") @db.Date
  closedAt           DateTime?               @map("closed_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  
  // Accounting integration sync tracking
  accountingSynced   Boolean                 @default(false) @map("accounting_synced")
  accountingEntryId  Int?                    @map("accounting_entry_id")
  
  association        Association             @relation(fields: [associationId], references: [id], onDelete: Cascade)
  application        LoanApplication         @relation(fields: [applicationId], references: [id])
  member             Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanProduct        LoanProduct             @relation(fields: [loanProductId], references: [id])
  repaymentSchedule  LoanRepaymentSchedule[]
  repayments         LoanRepayment[]
  savingsLien        SavingsLien?
  repaymentRequests  LoanRepaymentRequest[]

  @@unique([associationId, loanNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@index([nextPaymentDate])
  @@map("loans")
}

// Loan Repayment Schedule
model LoanRepaymentSchedule {
  id                Int             @id @default(autoincrement())
  loanId            Int             @map("loan_id")
  installmentNumber Int             @map("installment_number")
  dueDate           DateTime        @map("due_date") @db.Date
  principalDue      Decimal         @map("principal_due") @db.Decimal(12, 2)
  interestDue       Decimal         @map("interest_due") @db.Decimal(12, 2)
  totalDue          Decimal         @map("total_due") @db.Decimal(12, 2)
  principalPaid     Decimal         @default(0) @map("principal_paid") @db.Decimal(12, 2)
  interestPaid      Decimal         @default(0) @map("interest_paid") @db.Decimal(12, 2)
  totalPaid         Decimal         @default(0) @map("total_paid") @db.Decimal(12, 2)
  lateFee           Decimal         @default(0) @map("late_fee") @db.Decimal(10, 2)
  status            RepaymentStatus @default(PENDING)
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  loan              Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  repayments        LoanRepayment[]

  @@unique([loanId, installmentNumber])
  @@index([loanId])
  @@index([dueDate, status])
  @@map("loan_repayment_schedule")
}

// Loan Repayment
model LoanRepayment {
  id               Int                    @id @default(autoincrement())
  associationId    Int                    @map("association_id")
  loanId           Int                    @map("loan_id")
  scheduleItemId   Int?                   @map("schedule_item_id")
  amount           Decimal                @db.Decimal(12, 2)
  principalPortion Decimal                @map("principal_portion") @db.Decimal(12, 2)
  interestPortion  Decimal                @map("interest_portion") @db.Decimal(12, 2)
  lateFee          Decimal                @default(0) @map("late_fee") @db.Decimal(10, 2)
  paymentMethod    String                 @map("payment_method")
  reference        String?
  processedBy      Int                    @map("processed_by")
  notes            String?
  paidAt           DateTime               @default(now()) @map("paid_at")
  paymentDate      DateTime               @default(now()) @map("payment_date")
  createdAt        DateTime               @default(now()) @map("created_at")
  
  // Accounting integration sync tracking
  accountingSynced Boolean                @default(false) @map("accounting_synced")
  accountingEntryId Int?                  @map("accounting_entry_id")
  
  association      Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  loan             Loan                   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  scheduleItem     LoanRepaymentSchedule? @relation(fields: [scheduleItemId], references: [id])
  processor        User                   @relation("LoanRepaymentProcessor", fields: [processedBy], references: [id])

  @@index([loanId])
  @@index([paidAt])
  @@map("loan_repayments")
}

// Enums for Cooperatives
enum SavingsAccountType {
  REGULAR
  THRIFT
  TARGET
  FIXED_DEPOSIT
}

enum SavingsAccountStatus {
  ACTIVE
  DORMANT
  CLOSED
  MATURED
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  TRANSFER_IN
  TRANSFER_OUT
  FEE
}

enum InterestType {
  FLAT
  REDUCING_BALANCE
  COMPOUND
}

enum LoanApplicationStatus {
  DRAFT
  PENDING_GUARANTORS
  PENDING_REVIEW
  UNDER_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DISBURSED
  CANCELLED
}

enum GuarantorStatus {
  PENDING
  ACCEPTED
  DECLINED
  RELEASED
}

enum LoanStatus {
  ACTIVE
  OVERDUE
  DEFAULTED
  PAID_OFF
  WRITTEN_OFF
}

enum RepaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

// ============================================
// MEMBER FINANCIAL LEDGER
// Single source of truth for member financial activity
// Append-only ledger for audit trail
// ============================================

model MemberFinancialLedger {
  id              Int             @id @default(autoincrement())
  associationId   Int             @map("association_id")
  memberId        Int             @map("member_id")
  entryType       LedgerEntryType @map("entry_type")
  category        LedgerCategory
  amount          Decimal         @db.Decimal(12, 2)
  runningBalance  Decimal         @default(0) @map("running_balance") @db.Decimal(12, 2)
  effectiveDate   DateTime        @map("effective_date")
  description     String
  // Source reference for audit trail
  sourceTable     String          @map("source_table") // transaction, payment, savings_transaction, loan_repayment, etc.
  sourceId        Int             @map("source_id")
  referenceNumber String?         @map("reference_number")
  // Metadata
  createdBy       Int             @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  // Relations
  association     Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member          Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, memberId])
  @@index([associationId, memberId, effectiveDate])
  @@index([sourceTable, sourceId])
  @@index([effectiveDate])
  @@map("member_financial_ledger")
}

enum LedgerEntryType {
  DEBIT // Outflow from member (charges, dues, penalties)
  CREDIT // Inflow to member (payments, refunds, waivers)
  ADJUSTMENT // Corrections
}

enum LedgerCategory {
  DUES
  LEVY
  PENALTY
  DONATION
  REFUND
  WAIVER
  ADJUSTMENT
  SAVINGS_DEPOSIT
  SAVINGS_WITHDRAWAL
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  OTHER
}

// ============================================
// PHASE 12.5: MEETINGS & ATTENDANCE MANAGEMENT
// Professional/Enterprise Feature
// ============================================

// Meeting Model
model Meeting {
  id                 Int                 @id @default(autoincrement())
  associationId      Int                 @map("association_id")
  title              String
  description        String?
  meetingType        MeetingType         @default(REGULAR) @map("meeting_type")
  location           String?
  virtualLink        String?             @map("virtual_link") // Zoom/Google Meet link
  startTime          DateTime            @map("start_time")
  endTime            DateTime?           @map("end_time")
  status             MeetingStatus       @default(SCHEDULED)
  quorumRequired     Int?                @map("quorum_required") // Minimum attendees needed
  createdBy          Int                 @map("created_by")
  cancelledBy        Int?                @map("cancelled_by")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancellationReason String?             @map("cancellation_reason")
  reminderSent       Boolean             @default(false) @map("reminder_sent")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  association        Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  creator            User                @relation("MeetingCreatedBy", fields: [createdBy], references: [id])
  canceller          User?               @relation("MeetingCancelledBy", fields: [cancelledBy], references: [id])
  agendaItems        MeetingAgenda[]
  attendances        MeetingAttendance[]
  minutes            MeetingMinutes?

  @@index([associationId, status])
  @@index([associationId, startTime])
  @@index([startTime])
  @@map("meetings")
}

// Meeting Agenda Items
model MeetingAgenda {
  id          Int      @id @default(autoincrement())
  meetingId   Int      @map("meeting_id")
  orderNumber Int      @map("order_number")
  title       String
  description String?
  duration    Int? // Duration in minutes
  presenter   String? // Name of person presenting this item
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, orderNumber])
  @@index([meetingId])
  @@map("meeting_agenda")
}

// Meeting Attendance
model MeetingAttendance {
  id            Int              @id @default(autoincrement())
  meetingId     Int              @map("meeting_id")
  memberId      Int              @map("member_id")
  status        AttendanceStatus @default(PENDING)
  checkInTime   DateTime?        @map("check_in_time")
  checkOutTime  DateTime?        @map("check_out_time")
  apologyReason String?          @map("apology_reason")
  markedBy      Int?             @map("marked_by") // Admin who marked attendance
  markedAt      DateTime?        @map("marked_at")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  meeting       Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member        Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  marker        User?            @relation("AttendanceMarkedBy", fields: [markedBy], references: [id])

  @@unique([meetingId, memberId])
  @@index([meetingId])
  @@index([memberId])
  @@map("meeting_attendance")
}

// Meeting Minutes
model MeetingMinutes {
  id              Int       @id @default(autoincrement())
  meetingId       Int       @unique @map("meeting_id")
  content         String    @db.Text // Rich text content
  decisions       String?   @db.Text // Key decisions made
  actionItems     String?   @db.Text // Action items from meeting
  nextMeetingDate DateTime? @map("next_meeting_date")
  recordedBy      Int       @map("recorded_by")
  approvedBy      Int?      @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recorder        User      @relation("MinutesRecordedBy", fields: [recordedBy], references: [id])
  approver        User?     @relation("MinutesApprovedBy", fields: [approvedBy], references: [id])

  @@map("meeting_minutes")
}

// Meeting Enums
enum MeetingType {
  REGULAR // Regular scheduled meeting
  EMERGENCY // Emergency/urgent meeting
  AGM // Annual General Meeting
  EGM // Extraordinary General Meeting
  COMMITTEE // Committee meeting
  SPECIAL // Special purpose meeting
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum AttendanceStatus {
  PENDING // Not yet marked
  PRESENT // Attended
  ABSENT // Did not attend
  APOLOGY // Sent apology/excuse
  LATE // Arrived late
}

// ============================================
// PHASE 5.5: WELFARE & SOCIAL FUNDS MODELS
// Nigerian/African Market Feature
// Bereavement, Medical, Education, Emergency Support
// ============================================

// Welfare Fund
model WelfareFund {
  id                      Int                    @id @default(autoincrement())
  associationId           Int                    @map("association_id")
  name                    String
  description             String?
  fundType                WelfareFundType        @default(GENERAL) @map("fund_type")
  targetBalance           Decimal?               @map("target_balance") @db.Decimal(12, 2)
  currentBalance          Decimal                @default(0) @map("current_balance") @db.Decimal(12, 2)
  monthlyContribution     Decimal?               @map("monthly_contribution") @db.Decimal(12, 2)
  isContributionMandatory Boolean                @default(false) @map("is_contribution_mandatory")
  minContribution         Decimal?               @map("min_contribution") @db.Decimal(12, 2)
  maxPayout               Decimal?               @map("max_payout") @db.Decimal(12, 2)
  waitingPeriodDays       Int                    @default(0) @map("waiting_period_days")
  minContributionMonths   Int                    @default(0) @map("min_contribution_months")
  status                  WelfareFundStatus      @default(ACTIVE)
  createdBy               Int                    @map("created_by")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  association             Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  creator                 User                   @relation("WelfareFundCreator", fields: [createdBy], references: [id])
  contributions           WelfareContribution[]
  payoutRequests          WelfarePayoutRequest[]

  @@unique([associationId, name])
  @@index([associationId, status])
  @@map("welfare_funds")
}

// Welfare Contribution
model WelfareContribution {
  id               Int                       @id @default(autoincrement())
  associationId    Int                       @map("association_id")
  fundId           Int                       @map("fund_id")
  memberId         Int                       @map("member_id")
  amount           Decimal                   @db.Decimal(12, 2)
  contributionDate DateTime                  @map("contribution_date")
  paymentMethod    String?                   @map("payment_method")
  reference        String?
  notes            String?
  status           WelfareContributionStatus @default(PENDING)
  confirmedBy      Int?                      @map("confirmed_by")
  confirmedAt      DateTime?                 @map("confirmed_at")
  /// Who recorded it, so the same officer can't also confirm it. Null on contributions made before this was kept.
  recordedBy       Int?                      @map("recorded_by")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  
  // Accounting integration sync tracking
  accountingSynced    Boolean                @default(false) @map("accounting_synced")
  accountingEntryId   Int?                   @map("accounting_entry_id")
  
  association      Association               @relation(fields: [associationId], references: [id], onDelete: Cascade)
  fund             WelfareFund               @relation(fields: [fundId], references: [id], onDelete: Cascade)
  member           Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  confirmer        User?                     @relation("WelfareContributionConfirmer", fields: [confirmedBy], references: [id])

  @@index([associationId, fundId])
  @@index([memberId])
  @@index([contributionDate])
  @@index([status])
  @@map("welfare_contributions")
}

// Welfare Payout Request
model WelfarePayoutRequest {
  id                    Int                 @id @default(autoincrement())
  associationId         Int                 @map("association_id")
  fundId                Int                 @map("fund_id")
  memberId              Int                 @map("member_id")
  requestNumber         String              @map("request_number")
  payoutType            WelfarePayoutType   @map("payout_type")
  amount                Decimal             @db.Decimal(12, 2)
  reason                String
  supportingDocuments   String?             @map("supporting_documents")
  status                WelfarePayoutStatus @default(PENDING)
  reviewedBy            Int?                @map("reviewed_by")
  reviewedAt            DateTime?           @map("reviewed_at")
  reviewComments        String?             @map("review_comments")
  approvedBy            Int?                @map("approved_by")
  approvedAt            DateTime?           @map("approved_at")
  approvedAmount        Decimal?            @map("approved_amount") @db.Decimal(12, 2)
  rejectionReason       String?             @map("rejection_reason")
  disbursedBy           Int?                @map("disbursed_by")
  disbursedAt           DateTime?           @map("disbursed_at")
  disbursementMethod    String?             @map("disbursement_method")
  disbursementReference String?             @map("disbursement_reference")
  requestedAt           DateTime            @default(now()) @map("requested_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  
  // Accounting integration sync tracking
  accountingSynced      Boolean             @default(false) @map("accounting_synced")
  accountingEntryId     Int?                @map("accounting_entry_id")
  
  association           Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  fund                  WelfareFund         @relation(fields: [fundId], references: [id], onDelete: Cascade)
  member                Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reviewer              User?               @relation("WelfarePayoutReviewer", fields: [reviewedBy], references: [id])
  approver              User?               @relation("WelfarePayoutApprover", fields: [approvedBy], references: [id])
  disburser             User?               @relation("WelfarePayoutDisburser", fields: [disbursedBy], references: [id])

  @@unique([associationId, requestNumber])
  @@index([associationId, status])
  @@index([fundId])
  @@index([memberId])
  @@index([requestedAt])
  @@map("welfare_payout_requests")
}

// Welfare Enums
enum WelfareFundType {
  GENERAL // General welfare fund
  BEREAVEMENT // Death/funeral support
  MEDICAL // Medical emergencies
  EDUCATION // Educational support
  EMERGENCY // General emergencies
  MATERNITY // Childbirth support
  WEDDING // Marriage support
}

enum WelfareFundStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WelfareContributionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum WelfarePayoutType {
  BEREAVEMENT // Death of member or family
  MEDICAL // Medical emergency
  EDUCATION // School fees, etc.
  EMERGENCY // General emergency
  MATERNITY // Childbirth
  WEDDING // Marriage
  OTHER // Other welfare needs
}

enum WelfarePayoutStatus {
  PENDING // Awaiting review
  UNDER_REVIEW // Being reviewed
  APPROVED // Approved, awaiting disbursement
  REJECTED // Request rejected
  DISBURSED // Payment made
  CANCELLED // Cancelled by requester
}

// ============================================
// PHASE 6.5: SMS & BULK COMMUNICATION
// ============================================

// SMS Message Log - Track all sent SMS messages
model SMSMessage {
  id              Int            @id @default(autoincrement())
  associationId   Int            @map("association_id")
  campaignId      Int?           @map("campaign_id")
  recipientPhone  String         @map("recipient_phone")
  recipientName   String?        @map("recipient_name")
  memberId        Int?           @map("member_id")
  message         String
  messageType     SMSMessageType @default(SINGLE) @map("message_type")
  status          SMSStatus      @default(PENDING)
  termiiMessageId String?        @map("termii_message_id")
  segments        Int            @default(1)
  cost            Decimal?       @db.Decimal(10, 4)
  errorMessage    String?        @map("error_message")
  sentAt          DateTime?      @map("sent_at")
  deliveredAt     DateTime?      @map("delivered_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  association     Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  campaign        SMSCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([associationId, status])
  @@index([campaignId])
  @@index([memberId])
  @@index([sentAt])
  @@map("sms_messages")
}

// SMS Campaign - For bulk SMS sends
model SMSCampaign {
  id              Int               @id @default(autoincrement())
  associationId   Int               @map("association_id")
  name            String
  message         String
  templateId      Int?              @map("template_id")
  recipientType   SMSRecipientType  @default(ALL_MEMBERS) @map("recipient_type")
  recipientFilter Json?             @map("recipient_filter") // Filter criteria for recipients
  totalRecipients Int               @default(0) @map("total_recipients")
  sentCount       Int               @default(0) @map("sent_count")
  deliveredCount  Int               @default(0) @map("delivered_count")
  failedCount     Int               @default(0) @map("failed_count")
  status          SMSCampaignStatus @default(DRAFT)
  scheduledAt     DateTime?         @map("scheduled_at")
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  createdBy       Int               @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  association     Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  template        SMSTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messages        SMSMessage[]

  @@index([associationId, status])
  @@index([scheduledAt])
  @@map("sms_campaigns")
}

// SMS Template - Reusable message templates
model SMSTemplate {
  id            Int                 @id @default(autoincrement())
  associationId Int                 @map("association_id")
  name          String
  content       String
  category      SMSTemplateCategory @default(GENERAL)
  placeholders  String[]            @default([]) // List of placeholders like {{name}}, {{amount}}
  isActive      Boolean             @default(true) @map("is_active")
  usageCount    Int                 @default(0) @map("usage_count")
  createdBy     Int                 @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  association   Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  campaigns     SMSCampaign[]

  @@unique([associationId, name])
  @@index([associationId, category])
  @@map("sms_templates")
}

// SMS Credit Balance - Track SMS credits per association
model SMSCreditBalance {
  id             Int                    @id @default(autoincrement())
  associationId  Int                    @unique @map("association_id")
  balance        Decimal                @default(0) @db.Decimal(12, 4)
  totalPurchased Decimal                @default(0) @map("total_purchased") @db.Decimal(12, 4)
  totalUsed      Decimal                @default(0) @map("total_used") @db.Decimal(12, 4)
  lastTopUpAt    DateTime?              @map("last_top_up_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  association    Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  transactions   SMSCreditTransaction[]

  @@map("sms_credit_balances")
}

// SMS Credit Transaction - Track credit purchases and usage
model SMSCreditTransaction {
  id          Int                      @id @default(autoincrement())
  balanceId   Int                      @map("balance_id")
  type        SMSCreditTransactionType
  amount      Decimal                  @db.Decimal(12, 4)
  description String?
  reference   String?
  campaignId  Int?                     @map("campaign_id")
  createdAt   DateTime                 @default(now()) @map("created_at")
  balance     SMSCreditBalance         @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  @@index([balanceId, type])
  @@index([createdAt])
  @@map("sms_credit_transactions")
}

// SMS Enums
enum SMSMessageType {
  SINGLE // Single recipient
  BULK // Part of bulk campaign
  AUTOMATED // Automated reminder/notification
}

enum SMSStatus {
  PENDING // Queued for sending
  SENT // Sent to provider
  DELIVERED // Confirmed delivered
  FAILED // Failed to send
  REJECTED // Rejected by provider
}

enum SMSCampaignStatus {
  DRAFT // Being created
  SCHEDULED // Scheduled for future
  IN_PROGRESS // Currently sending
  COMPLETED // All messages sent
  CANCELLED // Cancelled before completion
  FAILED // Failed to complete
}

enum SMSRecipientType {
  ALL_MEMBERS // All active members
  SELECTED_MEMBERS // Specific members selected
  MEMBER_CATEGORY // Members by category
  CUSTOM_NUMBERS // Custom phone numbers
  OWING_MEMBERS // Members with outstanding dues
  PAID_MEMBERS // Members who are paid up
}

enum SMSTemplateCategory {
  GENERAL // General announcements
  PAYMENT_REMINDER // Payment reminders
  MEETING // Meeting notifications
  DUES // Dues notifications
  LEVY // Levy notifications
  WELFARE // Welfare notifications
  ELECTION // Election/voting notifications
  CUSTOM // Custom templates
}

enum SMSCreditTransactionType {
  PURCHASE // Credit purchase
  USAGE // Credit used for SMS
  REFUND // Credit refunded
  BONUS // Bonus credits
  ADJUSTMENT // Manual adjustment
}

// SMS Credits Purchase - Track individual purchase transactions via Paystack
model SMSCreditsPurchase {
  id               Int         @id @default(autoincrement())
  associationId    Int         @map("association_id")
  userId           Int         @map("user_id")
  credits          Int         // Number of credits purchased
  amount           Decimal     @db.Decimal(12, 2) // Amount in NGN
  reference        String      @unique // Paystack reference
  status           String      @default("pending") // pending, success, failed
  provider         String      @default("paystack") // Payment provider
  paidAt           DateTime?   @map("paid_at")
  paystackResponse Json?       @map("paystack_response")
  metadata         Json?       // Additional metadata
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  
  association      Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@index([reference])
  @@index([status])
  @@map("sms_credits_purchases")
}

// ============================================
// PHASE 17: AI INTEGRATION MODELS
// ============================================

// AI Audit Log - Track all AI requests for compliance
model AIAuditLog {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  userId        Int         @map("user_id")
  promptType    String      @map("prompt_type") // financial_assistant, reminder_suggestions, report_generation, nl_query, chat
  modelUsed     String      @map("model_used")
  tokensInput   Int         @default(0) @map("tokens_input")
  tokensOutput  Int         @default(0) @map("tokens_output")
  costUsd       Decimal     @default(0) @map("cost_usd") @db.Decimal(10, 6)
  outputSummary String?     @map("output_summary") @db.Text
  status        String      @default("success") // success, error, rate_limited
  errorMessage  String?     @map("error_message")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
