generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Association {
  id                         Int                         @id @default(autoincrement())
  name                       String
  slug                       String                      @unique
  subdomain                  String                      @unique
  tier                       AssociationTier             @default(STARTER)
  status                     AssociationStatus           @default(ACTIVE)
  /// ASSOCIATION is every existing tenant; THRIFT_GROUP is an outsider's standalone Ajo group (core + Ajo modules only).
  kind                       AssociationKind             @default(ASSOCIATION)
  logo                       String?
  primaryColor               String?                     @map("primary_color")
  subscriptionExpiresAt      DateTime?                   @map("subscription_expires_at")
  // G79: tracks whether this association has EVER started a trial, independent of which
  // Subscription row/plan it was against — initializePayment/startTrial's own "does a
  // subscription already exist" check only looked at currently-active statuses, so an
  // expired/cancelled association could get a second free trial just by picking a new plan.
  hasEverTrialed             Boolean                     @default(false) @map("has_ever_trialed")
  // Phase 19: Platform Admin - Soft Delete
  deletedAt                  DateTime?                   @map("deleted_at")
  deletedBy                  Int?                        @map("deleted_by")
  deletionReason             String?                     @map("deletion_reason")
  // Phase 19: Platform Admin - Security Settings
  force2FA                   Boolean                     @default(false) @map("force_2fa")
  passwordPolicyLevel        String                      @default("standard") @map("password_policy_level")
  sessionTimeoutMinutes      Int                         @default(480) @map("session_timeout_minutes")
  ipRestrictions             String[]                    @default([]) @map("ip_restrictions")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  accounting                 AccountingEntry[]
  auditLogs                  AuditLog[]
  securityEventLogs          SecurityEventLog[]
  exports                    ExportHistory[]
  categories                 FinancialCategory[]
  memberInvites              MemberInvite[]
  members                    Member[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  paymentGatewayTransactions PaymentGatewayTransaction[]
  payments                   Payment[]
  settings                   Settings[]
  subscriptions              Subscription[]
  transactions               Transaction[]
  users                      User[]
  levyCampaigns              LevyCampaign[]
  penaltyRules               PenaltyRule[]
  penaltyWaivers             PenaltyWaiver[]
  donationAllocations        DonationAllocation[]
  // Phase 9: Accounting System
  chartOfAccounts            ChartOfAccount[]
  journalEntries             JournalEntry[]
  expenseVouchers            ExpenseVoucher[]
  budgets                    Budget[]
  accountingPeriods          AccountingPeriod[]
  // Phase 3.5: Nigerian Payment Features
  bankAccounts               AssociationBankAccount[]
  bankTransfers              BankTransfer[]
  bankStatementImports       BankStatementImport[]
  paymentReconciliations     PaymentReconciliation[]
  paymentProofs              PaymentProof[]
  // Phase 8.5: Cooperatives & Loans
  savingsAccounts            SavingsAccount[]
  savingsDepositRequests     SavingsDepositRequest[]
  loanRepaymentRequests      LoanRepaymentRequest[]
  savingsLiens               SavingsLien[]
  cashCollections             CashCollection[]
  cashReceipts                CashReceipt[]
  cashLodgments               CashLodgment[]
  // Track T: Thrift (Ajo) add-on
  ajoGroups                   AjoGroup[]
  savingsTransactions        SavingsTransaction[]
  loanProducts               LoanProduct[]
  loanApplications           LoanApplication[]
  loanGuarantors             LoanGuarantor[]
  loans                      Loan[]
  loanRepayments             LoanRepayment[]
  // Member Financial Ledger
  memberLedgerEntries        MemberFinancialLedger[]
  // Phase 12.5: Meetings & Attendance
  meetings                   Meeting[]
  // Phase 5.5: Welfare & Social Funds
  welfareFunds               WelfareFund[]
  welfareContributions       WelfareContribution[]
  welfarePayoutRequests      WelfarePayoutRequest[]
  // Phase 6.5: SMS & Bulk Communication
  smsMessages                SMSMessage[]
  smsCampaigns               SMSCampaign[]
  smsTemplates               SMSTemplate[]
  smsCreditBalance           SMSCreditBalance?
  smsCreditsPurchases        SMSCreditsPurchase[]
  // Phase 17: AI Integration
  aiAuditLogs                AIAuditLog[]
  aiCreditBalance            AICreditBalance?
  aiCreditPurchases          AICreditPurchase[]
  documentEmbeddings         DocumentEmbedding[]
  // Phase 4.5: Voting & Elections
  elections                  Election[]
  announcements              Announcement[]
  polls                      Poll[]

  // RBAC System Relations
  roles     Role[]
  userRoles UserRole[]

  // Phase 19: Platform Admin - Module & Feature Overrides
  tenantModules    TenantModule[]
  tenantFeatures   TenantFeature[]
  billingOverrides BillingOverride[]

  // Phase 21: Help & Support
  helpArticles   HelpArticle[]
  faqItems       FAQItem[]
  supportTickets SupportTicket[]
  // Phase 14: Webhooks Management
  webhookEventLogs WebhookEventLog[]

  // Phase 22: Hybrid Super Admin Architecture
  isPlatformAssociation Boolean @default(false) @map("is_platform_association")

  // A1.3 — Impersonation handoff back-relation
  impersonationHandoffs ImpersonationHandoff[]

  @@index([deletedAt])
  @@index([isPlatformAssociation])
  @@map("associations")
}

model User {
  id                            Int                    @id @default(autoincrement())
  associationId                 Int?                   @map("association_id")
  email                         String
  passwordHash                  String                 @map("password_hash")
  role                          String                 @default("member")
  platformRole                  PlatformRole?          @map("platform_role")
  isActive                      Boolean                @default(false) @map("is_active")
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")
  emailVerified                 Boolean                @default(false) @map("email_verified")
  passwordResetExpiresAt        DateTime?              @map("password_reset_expires_at")
  passwordResetToken            String?                @map("password_reset_token")
  verificationCode              String?                @map("verification_code")
  verificationExpiresAt         DateTime?              @map("verification_expires_at")
  approvedAccountingEntries     AccountingEntry[]      @relation("AccountingEntryApprovedBy")
  createdAccountingEntries      AccountingEntry[]      @relation("AccountingEntryCreatedBy")
  auditLogs                     AuditLog[]
  exports                       ExportHistory[]
  sentMemberInvites             MemberInvite[]         @relation("MemberInvitedBy")
  member                        Member?
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  confirmedPayments             Payment[]              @relation("PaymentConfirmedBy")
  settingsUpdates               Settings[]             @relation("SettingsUpdatedBy")
  createdTransactions           Transaction[]          @relation("TransactionCreatedBy")
  approvedUsers                 UserApproval[]         @relation("UserApprovedBy")
  userApproval                  UserApproval?
  association                   Association?           @relation(fields: [associationId], references: [id])
  // Phase 9: Accounting System
  createdJournalEntries         JournalEntry[]         @relation("JournalEntryCreatedBy")
  approvedJournalEntries        JournalEntry[]         @relation("JournalEntryApprovedBy")
  rejectedJournalEntries        JournalEntry[]         @relation("JournalEntryRejectedBy")
  createdBudgets                Budget[]               @relation("BudgetCreatedBy")
  approvedBudgets               Budget[]               @relation("BudgetApprovedBy")
  closedPeriods                 AccountingPeriod[]     @relation("PeriodClosedBy")
  // Phase 8.5: Cooperatives & Loans
  processedSavingsTransactions  SavingsTransaction[]   @relation("SavingsTransactionProcessor")
  reviewedLoanApplications      LoanApplication[]      @relation("LoanApplicationReviewer")
  approvedLoanApplications      LoanApplication[]      @relation("LoanApplicationApprover")
  processedLoanRepayments       LoanRepayment[]        @relation("LoanRepaymentProcessor")
  // Phase 12.5: Meetings & Attendance
  createdMeetings               Meeting[]              @relation("MeetingCreatedBy")
  cancelledMeetings             Meeting[]              @relation("MeetingCancelledBy")
  markedAttendances             MeetingAttendance[]    @relation("AttendanceMarkedBy")
  recordedMinutes               MeetingMinutes[]       @relation("MinutesRecordedBy")
  approvedMinutes               MeetingMinutes[]       @relation("MinutesApprovedBy")
  // Phase 5.5: Welfare & Social Funds
  createdWelfareFunds           WelfareFund[]          @relation("WelfareFundCreator")
  confirmedWelfareContributions WelfareContribution[]  @relation("WelfareContributionConfirmer")
  reviewedWelfarePayouts        WelfarePayoutRequest[] @relation("WelfarePayoutReviewer")
  approvedWelfarePayouts        WelfarePayoutRequest[] @relation("WelfarePayoutApprover")
  disbursedWelfarePayouts       WelfarePayoutRequest[] @relation("WelfarePayoutDisburser")
  // Phase 17: AI Integration
  aiAuditLogs                   AIAuditLog[]
  aiCreditPurchases             AICreditPurchase[]
  // Phase 4.5: Voting & Elections
  createdElections              Election[]             @relation("ElectionCreatedBy")
  publishedElections            Election[]             @relation("ElectionPublishedBy")
  cancelledElections            Election[]             @relation("ElectionCancelledBy")
  nominatedCandidates           Candidate[]            @relation("CandidateNominatedBy")
  approvedCandidates            Candidate[]            @relation("CandidateApprovedBy")
  createdPolls                  Poll[]                 @relation("PollCreatedBy")

  // RBAC System Relations
  userRoles         UserRole[]
  assignedUserRoles UserRole[] @relation("UserRoleAssigner")

  // Phase 21: Help & Support
  createdTickets    SupportTicket[]    @relation("TicketCreator")
  assignedTickets   SupportTicket[]    @relation("TicketAssignee")
  ticketResponses   TicketResponse[]
  ticketAttachments TicketAttachment[]

  // Phase 6.5: SMS Credits
  smsCreditsPurchases SMSCreditsPurchase[]

  // Blog & Documentation relations
  blogPosts       BlogPost[]    @relation("BlogPostAuthor")
  blogComments    BlogComment[] @relation("BlogCommentAuthor")
  docPages        DocPage[]     @relation("DocPageAuthor")
  docFeedback     DocFeedback[]  @relation("DocFeedbackUser")

  // A1.3 — Impersonation handoff
  impersonationHandoffs ImpersonationHandoff[]

  // A2.12 — Platform admin invites
  platformAdminInvitesSent PlatformAdminInvite[] @relation("PlatformAdminInvitedBy")

  // A1.4 — TOTP 2FA for platform users (stored only on platform-role users)
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  lastLoginAt     DateTime? @map("last_login_at")
  totpSecretEnc   String?   @map("totp_secret_enc")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  recoveryCodes   RecoveryCode[]
  loginChallenges AdminLoginChallenge[]

  // F0.2 — Mobile push notifications
  deviceTokens DeviceToken[]

  // F0.3 — Mobile refresh-token sessions
  refreshTokens RefreshToken[]

  @@unique([associationId, email])
  @@index([associationId, email])
  @@map("users")
}

model UserApproval {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  approvalStatus  String    @default("pending") @map("approval_status")
  approvedById    Int?      @map("approved_by")
  approvalDate    DateTime? @map("approval_date")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  approvedBy      User?     @relation("UserApprovedBy", fields: [approvedById], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_approvals")
}

model Member {
  id                           Int                      @id @default(autoincrement())
  associationId                Int                      @map("association_id")
  userId                       Int?                     @unique @map("user_id")
  memberId                     String                   @map("member_id")
  firstName                    String                   @map("first_name")
  lastName                     String                   @map("last_name")
  email                        String?
  phone                        String?
  address                      String?
  joinDate                     DateTime?                @map("join_date")
  status                       String                   @default("active")
  category                     String                   @default("regular")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  city                         String?
  country                      String?
  dateOfBirth                  DateTime?                @map("date_of_birth")
  emergencyContactName         String?                  @map("emergency_contact_name")
  emergencyContactPhone        String?                  @map("emergency_contact_phone")
  emergencyContactRelationship String?                  @map("emergency_contact_relationship")
  gender                       String                   @default("male")
  notes                        String?
  occupation                   String?
  state                        String?
  loginStatus                  String                   @default("no_login") @map("login_status")
  /// Storage keys of the profile photo (512px) and its list thumbnail (128px). Null = no photo, the apps show initials.
  photoKey                     String?                  @map("photo_key")
  photoThumbKey                String?                  @map("photo_thumb_key")
  photoUpdatedAt               DateTime?                @map("photo_updated_at")
  invites                      MemberInvite[]
  association                  Association              @relation(fields: [associationId], references: [id])
  user                         User?                    @relation(fields: [userId], references: [id])
  transactions                 Transaction[]
  levyAssignments              LevyCampaignAssignment[]
  // Phase 3.5: Nigerian Payment Features
  bankTransfers                BankTransfer[]
  paymentProofs                PaymentProof[]
  // Phase 8.5: Cooperatives & Loans
  savingsAccounts              SavingsAccount[]
  savingsDepositRequests       SavingsDepositRequest[]
  loanRepaymentRequests        LoanRepaymentRequest[]
  savingsLiens                 SavingsLien[]
  cashReceipts                CashReceipt[]
  loanApplications             LoanApplication[]
  guaranteedLoans              LoanGuarantor[]
  loans                        Loan[]
  // Member Financial Ledger
  ledgerEntries                MemberFinancialLedger[]
  // Phase 12.5: Meetings & Attendance
  meetingAttendances           MeetingAttendance[]
  // Phase 5.5: Welfare & Social Funds
  welfareContributions         WelfareContribution[]
  welfarePayoutRequests        WelfarePayoutRequest[]
  // Phase 4.5: Voting & Elections
  candidacies                  Candidate[]
  eligibilityExceptions        ElectionEligibilityException[]
  votes                        Vote[]
  pollResponses                PollResponse[]
  // Track T: Thrift (Ajo) add-on
  ajoMemberships               AjoMembership[]
  ajoPayoutAccount             AjoPayoutAccount?
  ajoVerifications             AjoVerification[]

  @@unique([associationId, memberId])
  // Phase 12: Performance indexes
  @@index([associationId, status])
  @@index([associationId, category])
  @@index([associationId, createdAt])
  @@index([loginStatus])
  @@index([email])
  @@map("members")
}

model MemberInvite {
  id                   Int         @id @default(autoincrement())
  associationId        Int         @map("association_id")
  memberId             Int         @map("member_id")
  email                String?
  phone                String?
  inviteToken          String      @unique @map("invite_token")
  inviteTokenExpiresAt DateTime    @map("invite_token_expires_at")
  // Phase 8: the officer role this invite grants when accepted (null = an ordinary member).
  roleName             String?     @map("role_name")
  status               String      @default("pending")
  invitedById          Int         @map("invited_by")
  acceptedAt           DateTime?   @map("accepted_at")
  revokedAt            DateTime?   @map("revoked_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  association          Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  invitedBy            User        @relation("MemberInvitedBy", fields: [invitedById], references: [id])
  member               Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([memberId])
  @@map("member_invites")
}

model FinancialCategory {
  id            Int            @id @default(autoincrement())
  associationId Int            @map("association_id")
  name          String
  type          String
  amount        Decimal?       @db.Decimal(10, 2)
  frequency     String?
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  association   Association    @relation(fields: [associationId], references: [id])
  transactions  Transaction[]
  levyCampaigns LevyCampaign[]
  penaltyRules  PenaltyRule[]

  @@index([associationId, type])
  @@map("financial_categories")
}

model Transaction {
  id                  Int                         @id @default(autoincrement())
  associationId       Int                         @map("association_id")
  memberId            Int                         @map("member_id")
  categoryId          Int                         @map("category_id")
  amount              Decimal                     @db.Decimal(10, 2)
  paymentDate         DateTime?                   @map("payment_date")
  dueDate             DateTime?                   @map("due_date")
  paymentMethod       String?                     @map("payment_method")
  referenceNumber     String?                     @map("reference_number")
  status              String                      @default("pending")
  notes               String?
  createdBy           Int                         @map("created_by")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  
  // R3.4/G43: tracks when the last automated payment reminder was sent, so
  // the daily job doesn't re-send the same reminder more than once per day.
  lastReminderSentAt  DateTime?                   @map("last_reminder_sent_at")

  // Edit and void tracking
  isVoided            Boolean                     @default(false) @map("is_voided")
  voidReason          String?                     @map("void_reason")
  voidedAt            DateTime?                   @map("voided_at")
  voidedBy            Int?                        @map("voided_by")
  replacedBy          Int?                        @map("replaced_by")
  replaces            Int?                        @map("replaces")
  editHistory         Json?                       @map("edit_history")
  lastEditedBy        Int?                        @map("last_edited_by")
  lastEditedAt        DateTime?                   @map("last_edited_at")
  
  // Accounting integration sync tracking
  accountingSynced    Boolean                     @default(false) @map("accounting_synced")
  accountingEntryId   Int?                        @map("accounting_entry_id")
  
  gatewayTransactions PaymentGatewayTransaction[]
  payments            Payment[]
  association         Association                 @relation(fields: [associationId], references: [id])
  category            FinancialCategory           @relation(fields: [categoryId], references: [id])
  creator             User                        @relation("TransactionCreatedBy", fields: [createdBy], references: [id])
  member              Member                      @relation(fields: [memberId], references: [id])
  levyAssignment      LevyCampaignAssignment?
  donationRecord      DonationRecord?
  penaltyWaivers      PenaltyWaiver[]
  sourcePenalties     AppliedPenalty[]            @relation("SourceTransaction")
  asPenalty           AppliedPenalty?             @relation("PenaltyTransaction")
  // Phase 3.5: Nigerian Payment Features
  bankTransfers       BankTransfer[]
  reconciliations     PaymentReconciliation[]
  paymentProofs       PaymentProof[]

  // Phase 12: Performance indexes
  @@index([associationId, status])
  @@index([associationId, memberId])
  @@index([associationId, categoryId])
  @@index([associationId, createdAt])
  @@index([associationId, dueDate])
  @@index([memberId, status])
  @@map("transactions")
}

model Payment {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  transactionId Int         @map("transaction_id")
  amountPaid    Decimal     @map("amount_paid") @db.Decimal(10, 2)
  paymentDate   DateTime    @map("payment_date")
  paymentMethod String?     @map("payment_method")
  receiptNumber String?     @unique @map("receipt_number")
  confirmedBy   Int?        @map("confirmed_by")
  confirmedAt   DateTime?   @map("confirmed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  
  // Accounting integration sync tracking
  accountingSynced    Boolean   @default(false) @map("accounting_synced")
  accountingEntryId   Int?      @map("accounting_entry_id")
  
  association   Association @relation(fields: [associationId], references: [id])
  confirmer     User?       @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // Phase 12: Performance indexes
  @@index([associationId, paymentDate])
  @@index([transactionId])
  @@index([associationId, createdAt])
  @@map("payments")
}

model AccountingEntry {
  id              Int         @id @default(autoincrement())
  associationId   Int         @map("association_id")
  entryType       String      @map("entry_type")
  category        String
  subcategory     String?
  amount          Decimal     @db.Decimal(10, 2)
  description     String?
  transactionDate DateTime    @map("transaction_date")
  referenceNumber String?     @map("reference_number")
  receiptFilePath String?     @map("receipt_file_path")
  createdBy       Int         @map("created_by")
  approvedBy      Int?        @map("approved_by")
  approvalStatus  String      @default("pending") @map("approval_status")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  approver        User?       @relation("AccountingEntryApprovedBy", fields: [approvedBy], references: [id])
  association     Association @relation(fields: [associationId], references: [id])
  creator         User        @relation("AccountingEntryCreatedBy", fields: [createdBy], references: [id])

  @@index([associationId, entryType])
  @@map("accounting_entries")
}

model ExportHistory {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  userId        Int         @map("user_id")
  type          String
  format        String
  filename      String
  filepath      String
  fileSize      Int         @map("file_size")
  expiresAt     DateTime    @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([associationId, type])
  @@index([expiresAt])
  @@map("export_history")
}

model Notification {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  userId        Int         @map("user_id")
  title         String
  message       String
  type          String
  entityId      Int?        @map("entity_id") // F0.2: the entity (payment, meeting, election...) this notification is about, for push deep-link routing. Nullable — existing rows and writers that don't pass one are unaffected.
  pushType      String?     @map("push_type") // Deep-link type (same vocabulary as the push `data.type`), so the inbox can route a tap to the right screen. Null on older rows.
  isRead        Boolean     @default(false) @map("is_read")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([associationId, type])
  @@map("notifications")
}

// R3.6/G14/G42: replaces the in-memory Map that previously backed
// notification preferences — lost on every restart, and nothing ever read
// it to gate a real send. One row per user per association.
model NotificationPreference {
  id                    Int         @id @default(autoincrement())
  associationId         Int         @map("association_id")
  userId                Int         @map("user_id")
  emailEnabled          Boolean     @default(true) @map("email_enabled")
  smsEnabled            Boolean     @default(false) @map("sms_enabled")
  inAppEnabled          Boolean     @default(true) @map("in_app_enabled")
  pushEnabled           Boolean     @default(true) @map("push_enabled") // F0.2: master toggle for mobile push, independent of the in-app feed. Per-kind push granularity (like email/SMS/inApp have) can be added later if a mobile settings screen needs it — not required for v1.
  paymentDueEmail       Boolean     @default(true) @map("payment_due_email")
  paymentDueSMS         Boolean     @default(false) @map("payment_due_sms")
  paymentDueInApp       Boolean     @default(true) @map("payment_due_in_app")
  paymentReceivedEmail  Boolean     @default(true) @map("payment_received_email")
  paymentReceivedSMS    Boolean     @default(false) @map("payment_received_sms")
  paymentReceivedInApp  Boolean     @default(true) @map("payment_received_in_app")
  systemEmail           Boolean     @default(true) @map("system_email")
  systemSMS             Boolean     @default(false) @map("system_sms")
  systemInApp           Boolean     @default(true) @map("system_in_app")
  approvalEmail         Boolean     @default(true) @map("approval_email")
  approvalSMS           Boolean     @default(false) @map("approval_sms")
  approvalInApp         Boolean     @default(true) @map("approval_in_app")
  announcementEmail     Boolean     @default(true) @map("announcement_email")
  announcementSMS       Boolean     @default(false) @map("announcement_sms")
  // "Don't send me text messages": stops announcement and campaign texts from officers, whatever the default for announcements is.
  announcementSmsOptOut Boolean     @default(false) @map("announcement_sms_opt_out")
  announcementInApp     Boolean     @default(true) @map("announcement_in_app")
  quietHoursEnabled     Boolean     @default(false) @map("quiet_hours_enabled")
  quietHoursStart       String      @default("22:00") @map("quiet_hours_start")
  quietHoursEnd         String      @default("08:00") @map("quiet_hours_end")
  quietHoursTimezone    String      @default("UTC") @map("quiet_hours_timezone")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  association           Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([associationId, userId])
  @@map("notification_preferences")
}

// F0.2 — a registered Expo push token for one install of the mobile app.
// associationId is nullable: a device can be registered before the user has
// selected/switched a tenant in some flows, and one physical device token is
// re-used/reassigned across associations if the same phone signs into more
// than one (register upserts by expoPushToken, not by user).
model DeviceToken {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  associationId Int?      @map("association_id")
  expoPushToken String    @unique @map("expo_push_token")
  platform      String // 'ios' | 'android'
  deviceName    String?   @map("device_name")
  appVersion    String?   @map("app_version")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  disabledAt    DateTime? @map("disabled_at") // set by the receipts job on a DeviceNotRegistered receipt
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, associationId])
  @@map("device_tokens")
}

// F0.3 — one row per issued mobile refresh token. `tokenHash` is the sha256
// of the opaque token the client holds (the plaintext is never stored).
// `familyId` groups every token descended from one login via rotation; a
// reuse of a revoked token revokes the whole family (theft detection).
// `replacedById` is informational only (no enforced FK, matching
// architecture.md's own schema exactly) — which row a rotation replaced.
model RefreshToken {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  associationId Int?      @map("association_id")
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id")
  deviceName    String?   @map("device_name")
  platform      String?
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedById  Int?      @map("replaced_by_id")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Settings {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  key           String
  value         String?
  description   String?
  updatedBy     Int         @map("updated_by")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  association   Association @relation(fields: [associationId], references: [id])
  updater       User        @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([associationId, key])
  @@map("settings")
}

model AuditLog {
  id            Int          @id @default(autoincrement())
  associationId Int?         @map("association_id")
  userId        Int          @map("user_id")
  action        String
  tableName     String       @map("table_name")
  recordId      Int?         @map("record_id")
  oldValues     Json?        @map("old_values")
  newValues     Json?        @map("new_values")
  createdAt     DateTime     @default(now()) @map("created_at")
  association   Association? @relation(fields: [associationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@index([associationId, tableName])
  @@map("audit_log")
}

enum SecurityEventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum SecurityEventActorType {
  ADMIN
  USER
  SYSTEM
}

// Immutable security-relevant event log across all tenants (logins, 2FA,
// impersonation, password resets, suspensions, approvals, etc). Distinct
// from AuditLog above, which only tracks generic record changes
// (action/tableName/oldValues/newValues) and has no severity or actor-type
// concept. Written via lib/security-audit-log.ts's logSecurityEvent().
model SecurityEventLog {
  id            Int                     @id @default(autoincrement())
  eventType     String                  @map("event_type")
  severity      SecurityEventSeverity   @default(INFO)
  actorType     SecurityEventActorType  @map("actor_type")
  // Loose reference, not a Prisma relation — actorType can be SYSTEM (no
  // user at all), and the actor may later be deleted; a real FK would force
  // the opposite (losing immutable history when the actor is removed).
  actorId       Int?                    @map("actor_id")
  actorEmail    String?                 @map("actor_email")
  targetType    String?                 @map("target_type")
  targetId      String?                 @map("target_id")
  targetName    String?                 @map("target_name")
  ipAddress     String?                 @map("ip_address")
  userAgent     String?                 @map("user_agent")
  details       Json?
  associationId Int?                    @map("association_id")
  association   Association?            @relation(fields: [associationId], references: [id])
  occurredAt    DateTime                @default(now()) @map("occurred_at")

  @@index([severity])
  @@index([actorType])
  @@index([associationId])
  @@index([occurredAt])
  @@map("security_event_logs")
}

/// A plan's identity and marketing copy. Everything that is part of the customer's commercial terms (prices, limits, modules,
/// features) lives on `PlanVersion`, so editing copy never changes what an existing subscriber agreed to.
model Plan {
  id               Int                 @id @default(autoincrement())
  name             String
  code             String              @unique
  description      String?
  /// Short marketing bullets shown on pricing cards (string[]).
  highlights       Json?
  /// Optional ribbon text such as "Most popular".
  badgeLabel       String?             @map("badge_label")
  currency         String              @default("NGN")
  /// Can be bought by a new or returning subscriber. Existing subscriptions keep working when this is off.
  isActive         Boolean             @default(true) @map("is_active")
  /// Shown on the public pricing surfaces.
  isPublic         Boolean             @default(true) @map("is_public")
  /// Which kind of tenant may buy it: associations see ASSOCIATION plans, standalone thrift groups see THRIFT_GROUP plans.
  audience         AssociationKind     @default(ASSOCIATION)
  isRecommended    Boolean             @default(false) @map("is_recommended")
  isArchived       Boolean             @default(false) @map("is_archived")
  sortOrder        Int                 @default(0) @map("sort_order")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  subscriptions    Subscription[]
  versions         PlanVersion[]
  addonEligibility AddonEligiblePlan[]
  migrations       PlanMigration[]

  @@index([isActive, isPublic, isArchived])
  @@map("plans")
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// An immutable-once-published snapshot of a plan's commercial terms. A subscription points at the version it was sold on.
model PlanVersion {
  id               Int                  @id @default(autoincrement())
  planId           Int                  @map("plan_id")
  version          Int
  status           PlanVersionStatus    @default(DRAFT)
  /// Prices in integer kobo (NGN 10,000.00 = 1_000_000).
  priceMonthlyKobo Int                  @map("price_monthly_kobo")
  priceAnnualKobo  Int                  @map("price_annual_kobo")
  /// Quotas by limit key, e.g. { "members": 500 }. A missing key or null means unlimited.
  limits           Json?
  changeNote       String?              @map("change_note")
  createdBy        Int?                 @map("created_by")
  publishedBy      Int?                 @map("published_by")
  publishedAt      DateTime?            @map("published_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  plan             Plan                 @relation(fields: [planId], references: [id])
  modules          PlanVersionModule[]
  features         PlanVersionFeature[]
  subscriptions    Subscription[]
  terms            SubscriptionTerm[]
  migrationsFrom   PlanMigration[]      @relation("MigrationFrom")
  migrationsTo     PlanMigration[]      @relation("MigrationTo")

  @@unique([planId, version])
  @@index([planId, status])
  @@map("plan_versions")
}

model PlanVersionModule {
  id            Int            @id @default(autoincrement())
  planVersionId Int            @map("plan_version_id")
  moduleId      Int            @map("module_id")
  planVersion   PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  module        PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, moduleId])
  @@index([moduleId])
  @@map("plan_version_modules")
}

model PlanVersionFeature {
  id            Int             @id @default(autoincrement())
  planVersionId Int             @map("plan_version_id")
  featureId     Int             @map("feature_id")
  planVersion   PlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  feature       PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, featureId])
  @@index([featureId])
  @@map("plan_version_features")
}

enum SubscriptionSource {
  ONBOARDING
  PURCHASE
  MANUAL
  COMPLIMENTARY
}

model Subscription {
  id                  Int                @id @default(autoincrement())
  associationId       Int                @map("association_id")
  planId              Int                @map("plan_id")
  /// The exact terms (prices, modules, features, limits) this subscription was sold on.
  planVersionId       Int                @map("plan_version_id")
  source              SubscriptionSource @default(PURCHASE)
  status              SubscriptionStatus @default(TRIALING)
  billingCycle        BillingCycle       @default(MONTHLY) @map("billing_cycle")
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodStart  DateTime           @map("current_period_start")
  currentPeriodEnd    DateTime           @map("current_period_end")
  cancelAtPeriodEnd   Boolean            @default(false) @map("cancel_at_period_end")
  renewalDate         DateTime?          @map("renewal_date")
  pendingPlanId       Int?               @map("pending_plan_id")
  pendingBillingCycle BillingCycle?      @map("pending_billing_cycle")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  payments            PaymentHistory[]
  association         Association        @relation(fields: [associationId], references: [id])
  plan                Plan               @relation(fields: [planId], references: [id])
  planVersion         PlanVersion        @relation(fields: [planVersionId], references: [id])
  terms               SubscriptionTerm[]
  tenantAddons        TenantAddon[]

  @@index([associationId, status])
  @@index([planVersionId])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

enum SubscriptionTermKind {
  ONBOARDING
  PURCHASE
  RENEWAL
  PLAN_CHANGE
  MANUAL
  EXTENSION
  MIGRATION
}

/// One row per period a subscription was granted: who got what terms, for how long, and why. Never rewritten.
model SubscriptionTerm {
  id               Int                  @id @default(autoincrement())
  subscriptionId   Int                  @map("subscription_id")
  associationId    Int                  @map("association_id")
  planVersionId    Int                  @map("plan_version_id")
  kind             SubscriptionTermKind
  billingCycle     BillingCycle         @map("billing_cycle")
  startsAt         DateTime             @map("starts_at")
  endsAt           DateTime             @map("ends_at")
  /// What was charged for this term in kobo; 0 for complimentary and trial terms (no payment exists).
  amountKobo       Int                  @default(0) @map("amount_kobo")
  /// Set when a verified payment created this term. Unique, so a repeated callback cannot create a second term.
  paymentHistoryId Int?                 @unique @map("payment_history_id")
  actorId          Int?                 @map("actor_id")
  reason           String?
  createdAt        DateTime             @default(now()) @map("created_at")
  subscription     Subscription         @relation(fields: [subscriptionId], references: [id])
  planVersion      PlanVersion          @relation(fields: [planVersionId], references: [id])

  @@index([subscriptionId])
  @@index([associationId, endsAt])
  @@map("subscription_terms")
}

model PaymentHistory {
  id                 Int           @id @default(autoincrement())
  subscriptionId     Int           @map("subscription_id")
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("NGN")
  status             PaymentStatus @default(PENDING)
  provider           String        @default("paystack")
  reference          String?       @unique
  paidAt             DateTime?     @map("paid_at")
  metadata           Json?
  createdAt          DateTime      @default(now()) @map("created_at")
  accessCode         String?       @map("access_code")
  authorizationUrl   String?       @map("authorization_url")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  /// What this checkout buys: SUBSCRIPTION (new term), PLAN_CHANGE (upgrade) or ADDON.
  purpose            String        @default("SUBSCRIPTION")
  /// The server-computed price at checkout, in kobo. A verified payment must match it exactly to activate anything.
  expectedAmountKobo Int?          @map("expected_amount_kobo")
  /// The plan version and cycle that were quoted (and, for add-ons, the add-on versions), so activation never trusts gateway metadata.
  quote              Json?
  /// Claimed once by whichever of webhook/verify gets there first; makes activation idempotent.
  appliedAt          DateTime?     @map("applied_at")
  /// A verified payment whose amount did not match the quote: kept for staff review, nothing was activated.
  needsReview        Boolean       @default(false) @map("needs_review")
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, status])
  @@index([reference])
  @@index([needsReview])
  @@map("payment_history")
}

model PaymentGatewayTransaction {
  id               Int          @id @default(autoincrement())
  associationId    Int          @map("association_id")
  transactionId    Int?         @map("transaction_id")
  provider         String
  reference        String       @unique
  amount           Decimal      @db.Decimal(10, 2)
  status           String       @default("pending")
  metadata         Json?
  webhookReceived  Boolean      @default(false) @map("webhook_received")
  paystackResponse Json?        @map("paystack_response")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  nombaResponse    Json?        @map("nomba_response")
  association      Association  @relation(fields: [associationId], references: [id])
  transaction      Transaction? @relation(fields: [transactionId], references: [id])

  @@index([associationId, status])
  @@index([reference])
  @@index([transactionId])
  @@map("payment_gateway_transactions")
}

model OnboardingProgress {
  id                 Int       @id @default(autoincrement())
  associationId      Int       @unique @map("association_id")
  currentStep        Int       @default(1) @map("current_step")
  completedSteps     Json      @default("[]") @map("completed_steps")
  // Phase 8: steps the admin chose to skip, kept apart from the ones they finished so the final checklist is honest.
  skippedSteps       Json      @default("[]") @map("skipped_steps")
  profileCompleted   Boolean   @default(false) @map("profile_completed")
  teamInvited        Boolean   @default(false) @map("team_invited")
  membersImported    Boolean   @default(false) @map("members_imported")
  financeConfigured  Boolean   @default(false) @map("finance_configured")
  onboardingComplete Boolean   @default(false) @map("onboarding_complete")
  skippedAt          DateTime? @map("skipped_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("onboarding_progress")
}

enum AssociationTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum AssociationStatus {
