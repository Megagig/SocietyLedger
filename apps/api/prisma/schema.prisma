// Welfare Contribution
model WelfareContribution {
  id               Int                       @id @default(autoincrement())
  associationId    Int                       @map("association_id")
  fundId           Int                       @map("fund_id")
  memberId         Int                       @map("member_id")
  amount           Decimal                   @db.Decimal(12, 2)
  contributionDate DateTime                  @map("contribution_date")
  paymentMethod    String?                   @map("payment_method")
  reference        String?
  notes            String?
  status           WelfareContributionStatus @default(PENDING)
  confirmedBy      Int?                      @map("confirmed_by")
  confirmedAt      DateTime?                 @map("confirmed_at")
  /// Who recorded it, so the same officer can't also confirm it. Null on contributions made before this was kept.
  recordedBy       Int?                      @map("recorded_by")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  
  // Accounting integration sync tracking
  accountingSynced    Boolean                @default(false) @map("accounting_synced")
  accountingEntryId   Int?                   @map("accounting_entry_id")
  
  association      Association               @relation(fields: [associationId], references: [id], onDelete: Cascade)
  fund             WelfareFund               @relation(fields: [fundId], references: [id], onDelete: Cascade)
  member           Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  confirmer        User?                     @relation("WelfareContributionConfirmer", fields: [confirmedBy], references: [id])

  @@index([associationId, fundId])
  @@index([memberId])
  @@index([contributionDate])
  @@index([status])
  @@map("welfare_contributions")
}

// Welfare Payout Request
model WelfarePayoutRequest {
