// ============================================
// PHASE 6.5: SMS & BULK COMMUNICATION
// ============================================

// SMS Message Log - Track all sent SMS messages
model SMSMessage {
  id              Int            @id @default(autoincrement())
  associationId   Int            @map("association_id")
  campaignId      Int?           @map("campaign_id")
  announcementId  Int?           @map("announcement_id")
  recipientPhone  String         @map("recipient_phone")
  recipientName   String?        @map("recipient_name")
  memberId        Int?           @map("member_id")
  message         String
  messageType     SMSMessageType @default(SINGLE) @map("message_type")
  status          SMSStatus      @default(PENDING)
  termiiMessageId String?        @map("termii_message_id")
  segments        Int            @default(1)
  cost            Decimal?       @db.Decimal(10, 4)
  errorMessage    String?        @map("error_message")
  sentAt          DateTime?      @map("sent_at")
  deliveredAt     DateTime?      @map("delivered_at")
  // A credit is only spent on a text that went out: set once the credit for a failed or interrupted text has been given back.
  refunded        Boolean        @default(false)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  association     Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  campaign        SMSCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  announcement    Announcement?  @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([associationId, status])
  @@index([campaignId])
  @@index([announcementId])
  @@index([memberId])
  @@index([sentAt])
  @@map("sms_messages")
}

// SMS Campaign - For bulk SMS sends
model SMSCampaign {
  id              Int               @id @default(autoincrement())
  associationId   Int               @map("association_id")
  name            String
  message         String
  templateId      Int?              @map("template_id")
  recipientType   SMSRecipientType  @default(ALL_MEMBERS) @map("recipient_type")
  recipientFilter Json?             @map("recipient_filter") // Filter criteria for recipients
  totalRecipients Int               @default(0) @map("total_recipients")
  sentCount       Int               @default(0) @map("sent_count")
  deliveredCount  Int               @default(0) @map("delivered_count")
  failedCount     Int               @default(0) @map("failed_count")
  status          SMSCampaignStatus @default(DRAFT)
  scheduledAt     DateTime?         @map("scheduled_at")
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  createdBy       Int               @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  association     Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  template        SMSTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messages        SMSMessage[]

  @@index([associationId, status])
  @@index([scheduledAt])
  @@map("sms_campaigns")
}

// SMS Template - Reusable message templates
enum AnnouncementAudience {
  ALL // Every active member
  CATEGORY // Members of the chosen categories
  SELECTED // Hand-picked members
}

enum AnnouncementStatus {
  SENDING // Texts still going out
  COMPLETED
  INTERRUPTED // Cut short by a server restart
}

// One message from the officers to chosen members: in their app feed with a push, and optionally by email and SMS. Kept so officers can
// see what was sent, to whom and what happened to it.
model Announcement {
  id              Int                     @id @default(autoincrement())
  associationId   Int                     @map("association_id")
  title           String
  message         String                  @db.Text
  priority        String                  @default("info")
  audience        AnnouncementAudience    @default(ALL)
  audienceFilter  Json?                   @map("audience_filter")
  sendEmail       Boolean                 @default(false) @map("send_email")
  sendSms         Boolean                 @default(false) @map("send_sms")
  smsText         String?                 @map("sms_text")
  status          AnnouncementStatus      @default(COMPLETED)
  // Who the audience was, and how each part of it was reached
  memberCount     Int                     @default(0) @map("member_count")
  inAppCount      Int                     @default(0) @map("in_app_count")
  noLoginCount    Int                     @default(0) @map("no_login_count")
  emailCount      Int                     @default(0) @map("email_count")
  smsRequested    Int                     @default(0) @map("sms_requested")
  smsSent         Int                     @default(0) @map("sms_sent")
  smsFailed       Int                     @default(0) @map("sms_failed")
  noPhoneCount    Int                     @default(0) @map("no_phone_count")
  optedOutCount   Int                     @default(0) @map("opted_out_count")
  creditsUsed     Decimal                 @default(0) @map("credits_used") @db.Decimal(12, 4)
  createdBy       Int                     @map("created_by")
  createdAt       DateTime                @default(now()) @map("created_at")
  completedAt     DateTime?               @map("completed_at")
  association     Association             @relation(fields: [associationId], references: [id], onDelete: Cascade)
  messages        SMSMessage[]

  @@index([associationId, createdAt])
  @@map("announcements")
}

model SMSTemplate {
  id            Int                 @id @default(autoincrement())
  associationId Int                 @map("association_id")
  name          String
  content       String
  category      SMSTemplateCategory @default(GENERAL)
  placeholders  String[]            @default([]) // List of placeholders like {{name}}, {{amount}}
  isActive      Boolean             @default(true) @map("is_active")
  usageCount    Int                 @default(0) @map("usage_count")
  createdBy     Int                 @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  association   Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  campaigns     SMSCampaign[]

  @@unique([associationId, name])
  @@index([associationId, category])
  @@map("sms_templates")
}

// SMS Credit Balance - Track SMS credits per association
model SMSCreditBalance {
  id             Int                    @id @default(autoincrement())
  associationId  Int                    @unique @map("association_id")
  balance        Decimal                @default(0) @db.Decimal(12, 4)
  totalPurchased Decimal                @default(0) @map("total_purchased") @db.Decimal(12, 4)
  totalUsed      Decimal                @default(0) @map("total_used") @db.Decimal(12, 4)
  lastTopUpAt    DateTime?              @map("last_top_up_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  association    Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  transactions   SMSCreditTransaction[]

  @@map("sms_credit_balances")
}

// SMS Credit Transaction - Track credit purchases and usage
model SMSCreditTransaction {
  id          Int                      @id @default(autoincrement())
  balanceId   Int                      @map("balance_id")
  type        SMSCreditTransactionType
  amount      Decimal                  @db.Decimal(12, 4)
  description String?
  reference   String?
  campaignId  Int?                     @map("campaign_id")
  createdAt   DateTime                 @default(now()) @map("created_at")
  balance     SMSCreditBalance         @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  @@index([balanceId, type])
  @@index([createdAt])
  @@map("sms_credit_transactions")
}

// SMS Enums
enum SMSMessageType {
  SINGLE // Single recipient
  BULK // Part of bulk campaign
  AUTOMATED // Automated reminder/notification
}

enum SMSStatus {
  PENDING // Queued for sending
  SENT // Sent to provider
  DELIVERED // Confirmed delivered
  FAILED // Failed to send
  REJECTED // Rejected by provider
}

enum SMSCampaignStatus {
  DRAFT // Being created
  SCHEDULED // Scheduled for future
  IN_PROGRESS // Currently sending
  COMPLETED // All messages sent
  CANCELLED // Cancelled before completion
  FAILED // Failed to complete
  INTERRUPTED // Cut short by a server restart; the credits for the unsent texts were given back
}

enum SMSRecipientType {
  ALL_MEMBERS // All active members
  SELECTED_MEMBERS // Specific members selected
  MEMBER_CATEGORY // Members by category
  CUSTOM_NUMBERS // Custom phone numbers
  OWING_MEMBERS // Members with outstanding dues
  PAID_MEMBERS // Members who are paid up
}

enum SMSTemplateCategory {
  GENERAL // General announcements
  PAYMENT_REMINDER // Payment reminders
  MEETING // Meeting notifications
  DUES // Dues notifications
  LEVY // Levy notifications
  WELFARE // Welfare notifications
  ELECTION // Election/voting notifications
  CUSTOM // Custom templates
}

enum SMSCreditTransactionType {
  PURCHASE // Credit purchase
  USAGE // Credit used for SMS
  REFUND // Credit refunded
  BONUS // Bonus credits
  ADJUSTMENT // Manual adjustment
}

// SMS Credits Purchase - Track individual purchase transactions via Paystack
model SMSCreditsPurchase {
  id               Int         @id @default(autoincrement())
  associationId    Int         @map("association_id")
  userId           Int         @map("user_id")
  credits          Int         // Number of credits purchased
  amount           Decimal     @db.Decimal(12, 2) // Amount in NGN
  reference        String      @unique // Paystack reference
  status           String      @default("pending") // pending, success, failed
  provider         String      @default("paystack") // Payment provider
  paidAt           DateTime?   @map("paid_at")
  paystackResponse Json?       @map("paystack_response")
  metadata         Json?       // Additional metadata
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  
  association      Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@index([reference])
  @@index([status])
  @@map("sms_credits_purchases")
}

// ============================================
// PHASE 17: AI INTEGRATION MODELS
// ============================================

// AI Audit Log - Track all AI requests for compliance
// AI credits: bought on top of the plan's daily allowance. They never expire; the allowance is spent first.
model AICreditBalance {
  id             Int         @id @default(autoincrement())
  associationId  Int         @unique @map("association_id")
  balance        Int         @default(0)
  totalPurchased Int         @default(0) @map("total_purchased")
  totalUsed      Int         @default(0) @map("total_used")
  lastTopUpAt    DateTime?   @map("last_top_up_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  association    Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@map("ai_credit_balances")
}

model AICreditPurchase {
  id               Int         @id @default(autoincrement())
  associationId    Int         @map("association_id")
  userId           Int         @map("user_id")
  credits          Int
  pricePerCredit   Decimal     @map("price_per_credit") @db.Decimal(10, 2)
  amount           Decimal     @db.Decimal(12, 2)
  reference        String      @unique // Paystack reference (AIC-...)
  status           String      @default("pending") // pending, success, failed
  paidAt           DateTime?   @map("paid_at")
  paystackResponse Json?       @map("paystack_response")
  metadata         Json?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  association      Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@index([status])
  @@map("ai_credit_purchases")
}

model AIAuditLog {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  userId        Int         @map("user_id")
  promptType    String      @map("prompt_type") // financial_assistant, reminder_suggestions, report_generation, nl_query, chat
  modelUsed     String      @map("model_used")
  tokensInput   Int         @default(0) @map("tokens_input")
  tokensOutput  Int         @default(0) @map("tokens_output")
  costUsd       Decimal     @default(0) @map("cost_usd") @db.Decimal(10, 6)
  outputSummary String?     @map("output_summary") @db.Text
  status        String      @default("success") // pending (held while the model works), success, error, rate_limited
  errorMessage  String?     @map("error_message")
  /// What the request cost in units, and how many came from the day's allowance and from bought credits
  units          Int         @default(1)
  allowanceUnits Int         @default(0) @map("allowance_units")
  creditUnits    Int         @default(0) @map("credit_units")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([associationId, createdAt])
  @@index([userId])
  @@index([promptType])
  @@index([status])
  @@map("ai_audit_logs")
}

// Document Embedding - For RAG-based document Q&A (Phase 17 - Future)
model DocumentEmbedding {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  documentType  String      @map("document_type") // constitution, bylaw, policy, minutes, other
  filename      String
  content       String      @db.Text
  chunkIndex    Int         @default(0) @map("chunk_index")
  // Note: embedding vector stored as JSON until pgvector is enabled
  // For production, use: embedding Unsupported("vector(1536)")?
  embeddingJson String?     @map("embedding_json") @db.Text
  metadata      Json?
  isProcessed   Boolean     @default(false) @map("is_processed")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, documentType])
  @@index([associationId, isProcessed])
  @@map("document_embeddings")
}

// ============================================
// PHASE 4.5: VOTING & ELECTIONS MODELS
// Digital voting, elections, and polls
// ============================================

// Election Model
model Election {
  id                  Int                @id @default(autoincrement())
  associationId       Int                @map("association_id")
  title               String
  description         String?            @db.Text
  electionType        ElectionType       @default(GENERAL) @map("election_type")
  status              ElectionStatus     @default(DRAFT)
  nominationStartDate DateTime?          @map("nomination_start_date")
  nominationEndDate   DateTime?          @map("nomination_end_date")
  votingStartDate     DateTime           @map("voting_start_date")
  votingEndDate       DateTime           @map("voting_end_date")
  maxVotesPerMember   Int                @default(1) @map("max_votes_per_member")
  allowAbstention     Boolean            @default(true) @map("allow_abstention")
  isAnonymous         Boolean            @default(true) @map("is_anonymous")
  requiresQuorum      Boolean            @default(false) @map("requires_quorum")
  quorumPercentage    Int?               @map("quorum_percentage")
  eligibleVoterCount  Int                @default(0) @map("eligible_voter_count")
  totalVotesCast      Int                @default(0) @map("total_votes_cast")
  createdBy           Int                @map("created_by")
  publishedBy         Int?               @map("published_by")
  publishedAt         DateTime?          @map("published_at")
  cancelledBy         Int?               @map("cancelled_by")
  cancelledAt         DateTime?          @map("cancelled_at")
  cancellationReason  String?            @map("cancellation_reason")
  // Who may vote and who may stand, set by the association (null = every active member, the default). See eligibility-rules.ts.
  eligibilityRules    Json?              @map("eligibility_rules")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  association         Association        @relation(fields: [associationId], references: [id], onDelete: Cascade)
  creator             User               @relation("ElectionCreatedBy", fields: [createdBy], references: [id])
  publisher           User?              @relation("ElectionPublishedBy", fields: [publishedBy], references: [id])
  canceller           User?              @relation("ElectionCancelledBy", fields: [cancelledBy], references: [id])
  positions           ElectionPosition[]
  candidates          Candidate[]
  votes               Vote[]
  eligibilityExceptions ElectionEligibilityException[]

  @@index([associationId, status])
  @@index([associationId, votingStartDate])
  @@index([votingStartDate, votingEndDate])
  @@map("elections")
}

// Election Position (for elections with multiple positions)
model ElectionPosition {
  id            Int         @id @default(autoincrement())
  electionId    Int         @map("election_id")
  title         String
  description   String?
  maxCandidates Int         @default(1) @map("max_candidates")
  orderNumber   Int         @default(0) @map("order_number")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  election      Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates    Candidate[]
  votes         Vote[]

  @@unique([electionId, orderNumber])
  @@index([electionId])
  @@map("election_positions")
}

// A named member let in, or kept out, of one election's vote or candidacy, whatever the rules say — with the reason on record.
model ElectionEligibilityException {
  id         Int      @id @default(autoincrement())
  electionId Int      @map("election_id")
  memberId   Int      @map("member_id")
  scope      String // VOTE | STAND
  kind       String // ALLOW | BAR
  reason     String
  createdBy  Int      @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([electionId, memberId, scope])
  @@index([electionId])
  @@map("election_eligibility_exceptions")
}

// Candidate Model
model Candidate {
  id               Int               @id @default(autoincrement())
  electionId       Int               @map("election_id")
  positionId       Int?              @map("position_id")
  memberId         Int               @map("member_id")
  manifesto        String?           @db.Text
  photoUrl         String?           @map("photo_url")
  status           CandidateStatus   @default(PENDING)
  nominatedBy      Int?              @map("nominated_by")
  nominatedAt      DateTime          @default(now()) @map("nominated_at")
  approvedBy       Int?              @map("approved_by")
  approvedAt       DateTime?         @map("approved_at")
  rejectionReason  String?           @map("rejection_reason")
  withdrawnAt      DateTime?         @map("withdrawn_at")
  withdrawalReason String?           @map("withdrawal_reason")
  voteCount        Int               @default(0) @map("vote_count")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  election         Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position         ElectionPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  member           Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  nominator        User?             @relation("CandidateNominatedBy", fields: [nominatedBy], references: [id])
  approver         User?             @relation("CandidateApprovedBy", fields: [approvedBy], references: [id])
  votes            Vote[]

  @@unique([electionId, positionId, memberId])
  @@index([electionId, status])
  @@index([positionId])
  @@index([memberId])
  @@map("candidates")
}

// Vote Model
model Vote {
  id           Int               @id @default(autoincrement())
  electionId   Int               @map("election_id")
  positionId   Int?              @map("position_id")
  candidateId  Int?              @map("candidate_id")
  voterId      Int               @map("voter_id")
  voteHash     String            @map("vote_hash") // For verification without revealing voter
  isAbstention Boolean           @default(false) @map("is_abstention")
  votedAt      DateTime          @default(now()) @map("voted_at")
  election     Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position     ElectionPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  candidate    Candidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  voter        Member            @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([electionId, positionId, voterId])
  @@index([electionId])
  @@index([candidateId])
  @@index([voterId])
  @@map("votes")
}

// Poll Model
model Poll {
  id                   Int            @id @default(autoincrement())
  associationId        Int            @map("association_id")
  title                String
  description          String?        @db.Text
  pollType             PollType       @default(SINGLE_CHOICE) @map("poll_type")
  status               PollStatus     @default(DRAFT)
  startDate            DateTime       @map("start_date")
  endDate              DateTime       @map("end_date")
  allowMultipleVotes   Boolean        @default(false) @map("allow_multiple_votes")
  maxChoices           Int?           @map("max_choices")
  isAnonymous          Boolean        @default(true) @map("is_anonymous")
  showResultsBeforeEnd Boolean        @default(false) @map("show_results_before_end")
  totalResponses       Int            @default(0) @map("total_responses")
  createdBy            Int            @map("created_by")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  association          Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  creator              User           @relation("PollCreatedBy", fields: [createdBy], references: [id])
  options              PollOption[]
  responses            PollResponse[]

  @@index([associationId, status])
  @@index([associationId, startDate])
  @@index([startDate, endDate])
  @@map("polls")
}

// Poll Option Model
model PollOption {
  id          Int            @id @default(autoincrement())
  pollId      Int            @map("poll_id")
  optionText  String         @map("option_text")
  orderNumber Int            @default(0) @map("order_number")
  voteCount   Int            @default(0) @map("vote_count")
  createdAt   DateTime       @default(now()) @map("created_at")
  poll        Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses   PollResponse[]

  @@unique([pollId, orderNumber])
  @@index([pollId])
  @@map("poll_options")
}

// Poll Response Model
model PollResponse {
  id           Int        @id @default(autoincrement())
  pollId       Int        @map("poll_id")
  optionId     Int        @map("option_id")
  responderId  Int        @map("responder_id")
  responseHash String     @map("response_hash") // For verification without revealing responder
  respondedAt  DateTime   @default(now()) @map("responded_at")
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option       PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  responder    Member     @relation(fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, responderId])
  @@index([pollId])
  @@index([optionId])
  @@index([responderId])
  @@map("poll_responses")
}

// Voting Enums
enum ElectionType {
  GENERAL // General election for all positions
  EXECUTIVE // Executive committee election
  COMMITTEE // Committee member election
  SPECIAL // Special purpose election
}

enum ElectionStatus {
  DRAFT // Being created
  NOMINATIONS_OPEN // Accepting nominations
  NOMINATIONS_CLOSED // Nominations closed, candidates being finalised before voting
  VOTING_OPEN // Voting in progress
  VOTING_CLOSED // Voting ended, results being processed
  RESULTS_PUBLISHED // Results announced
  CANCELLED // Election cancelled
}

enum CandidateStatus {
  PENDING // Awaiting approval
  APPROVED // Approved to contest
  REJECTED // Nomination rejected
  WITHDRAWN // Candidate withdrew
}

enum PollType {
  YES_NO // Simple yes/no poll
  MULTIPLE_CHOICE // Select multiple options
  SINGLE_CHOICE // Select one option
  RATING // Rating scale (1-5, 1-10, etc.)
}

enum PollStatus {
  DRAFT // Being created
  ACTIVE // Poll is live
  CLOSED // Poll ended
  CANCELLED // Poll cancelled
}

// ============================================
// RBAC SYSTEM MODELS - Database-driven Roles & Permissions
// ============================================

// Permission Model - Global permissions registry
model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique // e.g., "members.view", "ledger.create"
  description     String
  module          String // e.g., "Members", "Finance/Ledger"
  examples        String[]         @default([]) // Usage examples
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@index([module])
  @@index([isActive])
  @@map("permissions")
}

// Role Model - Association-scoped roles (except platform roles)
model Role {
  id            Int              @id @default(autoincrement())
  associationId Int?             @map("association_id") // NULL for platform roles
  name          String
  displayName   String           @map("display_name")
  description   String?
  isSystemRole  Boolean          @default(false) @map("is_system_role") // Cannot be deleted/modified
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  association   Association?     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  userRoles     UserRole[]

  @@unique([associationId, name])
  @@index([associationId, isActive])
  @@index([isSystemRole])
  @@map("roles")
}

// Role-Permission Junction Table
model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// User-Role Junction Table - Users can have multiple roles per association
model UserRole {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  roleId        Int         @map("role_id")
  associationId Int         @map("association_id")
  assignedBy    Int?        @map("assigned_by")
  assignedAt    DateTime    @default(now()) @map("assigned_at")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  assigner      User?       @relation("UserRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId, associationId])
  @@index([userId, associationId])
  @@index([roleId])
  @@index([associationId])
  @@map("user_roles")
}

// ============================================
// PHASE 19: SAAS OWNER / SUPER ADMIN PLATFORM CONTROLS
// Module & Feature Flags, Billing Overrides, Platform Action Logging
// ============================================

// Platform Module Definition - High-level modules
model PlatformModule {
  id            Int               @id @default(autoincrement())
  code          String            @unique // e.g., "members", "ledger", "payments"
  name          String
  description   String?
  isCore        Boolean           @default(false) @map("is_core") // Core modules can't be disabled
  sortOrder     Int               @default(0) @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  features      PlatformFeature[]
  planVersionModules PlanVersionModule[]
  addonVersionModules AddonVersionModule[]
  tenantModules TenantModule[]

  @@index([isCore])
  @@map("platform_modules")
}

// Platform Feature Definition - Fine-grained features within modules
model PlatformFeature {
  id             Int             @id @default(autoincrement())
  moduleId       Int             @map("module_id")
  code           String          @unique // e.g., "ledger.export", "audit.export"
  name           String
  description    String?
  isCore         Boolean         @default(false) @map("is_core")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  module         PlatformModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  planVersionFeatures PlanVersionFeature[]
  addonVersionFeatures AddonVersionFeature[]
  tenantFeatures TenantFeature[]

  @@index([moduleId])
  @@map("platform_features")
}

// Tenant-Module Override - Per-tenant module overrides
model TenantModule {
  id            Int            @id @default(autoincrement())
  associationId Int            @map("association_id")
  moduleId      Int            @map("module_id")
  isEnabled     Boolean        @map("is_enabled")
  overrideType  OverrideType   @default(MANUAL) @map("override_type")
  reason        String?
  overriddenBy  Int            @map("overridden_by")
  expiresAt     DateTime?      @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  association   Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  module        PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([associationId, moduleId])
  @@index([associationId])
  @@index([moduleId])
  @@index([expiresAt])
  @@map("tenant_modules")
}

// Tenant-Feature Override - Per-tenant feature overrides
model TenantFeature {
  id            Int             @id @default(autoincrement())
  associationId Int             @map("association_id")
  featureId     Int             @map("feature_id")
  isEnabled     Boolean         @map("is_enabled")
  overrideType  OverrideType    @default(MANUAL) @map("override_type")
  reason        String?
  overriddenBy  Int             @map("overridden_by")
  expiresAt     DateTime?       @map("expires_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  association   Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  feature       PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([associationId, featureId])
  @@index([associationId])
  @@index([featureId])
  @@index([expiresAt])
  @@map("tenant_features")
}

// Add-ons: optional extras sold on top of a plan, with their own versioned price and entitlements.
model Addon {
  id            Int                 @id @default(autoincrement())
  code          String              @unique
  name          String
  description   String?
  highlights    Json?
  /// Add-ons in one family are tiers of one product: a tenant holds at most one of them, and changing tier swaps the held one.
  family        String?
  isActive      Boolean             @default(true) @map("is_active")
  isPublic      Boolean             @default(true) @map("is_public")
  isArchived    Boolean             @default(false) @map("is_archived")
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  versions      AddonVersion[]
  /// Empty means every plan may buy it.
  eligiblePlans AddonEligiblePlan[]

  @@map("addons")
}

model AddonEligiblePlan {
  id      Int   @id @default(autoincrement())
  addonId Int   @map("addon_id")
  planId  Int   @map("plan_id")
  addon   Addon @relation(fields: [addonId], references: [id], onDelete: Cascade)
  plan    Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([addonId, planId])
  @@map("addon_eligible_plans")
}

model AddonVersion {
  id               Int                   @id @default(autoincrement())
  addonId          Int                   @map("addon_id")
  version          Int
  status           PlanVersionStatus     @default(DRAFT)
  priceMonthlyKobo Int                   @map("price_monthly_kobo")
  priceAnnualKobo  Int                   @map("price_annual_kobo")
  /// Extra quota this add-on grants, added to the plan's limits, e.g. { "members": 200 }.
  limits           Json?
  changeNote       String?               @map("change_note")
  createdBy        Int?                  @map("created_by")
  publishedBy      Int?                  @map("published_by")
  publishedAt      DateTime?             @map("published_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  addon            Addon                 @relation(fields: [addonId], references: [id])
  modules          AddonVersionModule[]
  features         AddonVersionFeature[]
  tenantAddons     TenantAddon[]

  @@unique([addonId, version])
  @@index([addonId, status])
  @@map("addon_versions")
}

model AddonVersionModule {
  id             Int            @id @default(autoincrement())
  addonVersionId Int            @map("addon_version_id")
  moduleId       Int            @map("module_id")
  addonVersion   AddonVersion   @relation(fields: [addonVersionId], references: [id], onDelete: Cascade)
  module         PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([addonVersionId, moduleId])
  @@map("addon_version_modules")
}

model AddonVersionFeature {
  id             Int             @id @default(autoincrement())
  addonVersionId Int             @map("addon_version_id")
  featureId      Int             @map("feature_id")
  addonVersion   AddonVersion    @relation(fields: [addonVersionId], references: [id], onDelete: Cascade)
  feature        PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([addonVersionId, featureId])
  @@map("addon_version_features")
}

enum TenantAddonStatus {
  ACTIVE
  ENDED
}

/// An add-on a tenant holds. It always ends with the subscription period it was bought into (renewals extend it in the same payment).
model TenantAddon {
  id                Int                @id @default(autoincrement())
  associationId     Int                @map("association_id")
  subscriptionId    Int                @map("subscription_id")
  addonVersionId    Int                @map("addon_version_id")
  status            TenantAddonStatus  @default(ACTIVE)
  billingCycle      BillingCycle       @map("billing_cycle")
  startsAt          DateTime           @map("starts_at")
  /// Equals the subscription's current period end, so the add-on renews with the plan.
  endsAt            DateTime           @map("ends_at")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  source            SubscriptionSource @default(PURCHASE)
  amountPaidKobo    Int                @default(0) @map("amount_paid_kobo")
  paymentHistoryId  Int?               @map("payment_history_id")
  actorId           Int?               @map("actor_id")
  reason            String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  subscription      Subscription       @relation(fields: [subscriptionId], references: [id])
  addonVersion      AddonVersion       @relation(fields: [addonVersionId], references: [id])

  @@index([associationId, status])
  @@index([subscriptionId])
  @@index([paymentHistoryId])
  @@map("tenant_addons")
}

enum PlanMigrationStatus {
  SCHEDULED
  APPLIED
  CANCELLED
}

/// Moves existing subscribers of a plan from one version to another on a chosen date. Nothing moves without one of these.
model PlanMigration {
  id            Int                 @id @default(autoincrement())
  planId        Int                 @map("plan_id")
  fromVersionId Int                 @map("from_version_id")
  toVersionId   Int                 @map("to_version_id")
  status        PlanMigrationStatus @default(SCHEDULED)
  effectiveAt   DateTime            @map("effective_at")
  reason        String
  /// Snapshot of what the preview showed (tenant count, price change, dropped add-ons) when it was scheduled.
  summary       Json?
  affectedCount Int                 @default(0) @map("affected_count")
  createdBy     Int                 @map("created_by")
  appliedAt     DateTime?           @map("applied_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  plan          Plan                @relation(fields: [planId], references: [id])
  fromVersion   PlanVersion         @relation("MigrationFrom", fields: [fromVersionId], references: [id])
  toVersion     PlanVersion         @relation("MigrationTo", fields: [toVersionId], references: [id])

  @@index([status, effectiveAt])
  @@map("plan_migrations")
}

// Billing Override - Billing exceptions and manual controls
model BillingOverride {
  id            Int                 @id @default(autoincrement())
  associationId Int                 @map("association_id")
  overrideType  BillingOverrideType @map("override_type")
  value         String? // JSON or simple value depending on type
  reason        String
  startDate     DateTime            @default(now()) @map("start_date")
  endDate       DateTime?           @map("end_date")
  isActive      Boolean             @default(true) @map("is_active")
  createdBy     Int                 @map("created_by")
  revokedBy     Int?                @map("revoked_by")
  revokedAt     DateTime?           @map("revoked_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  association   Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, isActive])
  @@index([overrideType])
  @@index([endDate])
  @@map("billing_overrides")
}

// Platform Action Log - Comprehensive audit trail for platform admin actions
model PlatformActionLog {
  id            Int      @id @default(autoincrement())
  actorId       Int      @map("actor_id")
  actorRole     String   @map("actor_role")
  actionType    String   @map("action_type")
  targetType    String   @map("target_type") // association, user, module, feature, billing
  targetId      Int?     @map("target_id")
  associationId Int?     @map("association_id")
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  reason        String?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([actionType])
  @@index([targetType])
  @@index([associationId])
  @@index([createdAt])
  @@map("platform_action_logs")
}

// Override Type Enum - Types of tenant overrides
enum OverrideType {
  MANUAL // Admin manually set
  TRIAL // Trial period override
  PROMOTION // Promotional access
  SUPPORT // Support-granted access
  COMPLIANCE // Compliance requirement
}

// Billing Override Type Enum - Types of billing exceptions
enum BillingOverrideType {
  BYPASS_BILLING // Skip all billing
  EXTEND_TRIAL // Extend trial period
  PAUSE_BILLING // Pause billing temporarily
  APPLY_CREDIT // Apply credit to account
  MARK_PAID_EXTERNAL // Paid outside system
  OVERRIDE_PLAN // Force specific plan
  GRACE_PERIOD // Grace period for payment
}

// ============================================
// PHASE 21: HELP & SUPPORT MODULE
// ============================================

// Help Article - Knowledge base articles
model HelpArticle {
  id              Int          @id @default(autoincrement())
  associationId   Int?         @map("association_id") // null = global article
  slug            String       @unique
  title           String
  content         String       @db.Text
  excerpt         String?
  category        String // getting_started, members, finance, reports, settings, troubleshooting
  tags            String[]     @default([])
  roleVisibility  String[]     @default(["admin", "treasurer", "member"]) @map("role_visibility")
  isPublished     Boolean      @default(true) @map("is_published")
  isFeatured      Boolean      @default(false) @map("is_featured")
  viewCount       Int          @default(0) @map("view_count")
  helpfulCount    Int          @default(0) @map("helpful_count")
  notHelpfulCount Int          @default(0) @map("not_helpful_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  association     Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([isPublished, isFeatured])
  @@index([associationId])
  @@map("help_articles")
}

// FAQ Item - Frequently asked questions
model FAQItem {
  id             Int          @id @default(autoincrement())
  associationId  Int?         @map("association_id") // null = global FAQ
  question       String
  answer         String       @db.Text
  category       String // general, payments, members, reports, technical
  roleVisibility String[]     @default(["admin", "treasurer", "member"]) @map("role_visibility")
  sortOrder      Int          @default(0) @map("sort_order")
  isActive       Boolean      @default(true) @map("is_active")
  viewCount      Int          @default(0) @map("view_count")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  association    Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([category, isActive])
  @@index([associationId])
  @@map("faq_items")
}

// Support Ticket - User support requests
model SupportTicket {
  id                      Int                @id @default(autoincrement())
  associationId           Int                @map("association_id")
  userId                  Int                @map("user_id")
  ticketNumber            String             @unique @map("ticket_number") // TKT-YYYYMMDD-XXXX
  subject                 String
  description             String             @db.Text
  category                TicketCategory
  priority                TicketPriority     @default(MEDIUM)
  status                  TicketStatus       @default(OPEN)
  audience                TicketAudience     @default(ASSOCIATION)
  // Set on a Tier 2 ticket an officer opened by escalating a member's ticket (the member's ticket is never shared)
  escalatedFromId         Int?               @map("escalated_from_id")
  // AI-generated fields
  aiCategory              String?            @map("ai_category")
  aiCategoryConfidence    Float?             @map("ai_category_confidence")
  aiSentiment             String?            @map("ai_sentiment") // positive, neutral, negative, urgent
  aiSentimentScore        Float?             @map("ai_sentiment_score")
  aiEscalationRecommended Boolean            @default(false) @map("ai_escalation_recommended")
  // Assignment
  assignedToId            Int?               @map("assigned_to_id")
  // Timestamps
  resolvedAt              DateTime?          @map("resolved_at")
  closedAt                DateTime?          @map("closed_at")
  firstResponseAt         DateTime?          @map("first_response_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  // Relations
  association             Association        @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user                    User               @relation("TicketCreator", fields: [userId], references: [id])
  assignedTo              User?              @relation("TicketAssignee", fields: [assignedToId], references: [id])
  escalatedFrom           SupportTicket?     @relation("TicketEscalation", fields: [escalatedFromId], references: [id], onDelete: SetNull)
  escalations             SupportTicket[]    @relation("TicketEscalation")
  responses               TicketResponse[]
  attachments             TicketAttachment[]

  @@index([associationId, status])
  @@index([audience, status])
  @@index([escalatedFromId])
  @@index([userId])
  @@index([assignedToId])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@map("support_tickets")
}

// Ticket Response - Replies to support tickets
model TicketResponse {
  id            Int                @id @default(autoincrement())
  ticketId      Int                @map("ticket_id")
  userId        Int                @map("user_id")
  message       String             @db.Text
  isStaff       Boolean            @default(false) @map("is_staff")
  isInternal    Boolean            @default(false) @map("is_internal") // Internal notes not visible to user
  // AI-generated response
  isAiGenerated Boolean            @default(false) @map("is_ai_generated")
  aiConfidence  Float?             @map("ai_confidence")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  // Relations
  ticket        SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id])
  attachments   TicketAttachment[]

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_responses")
}

// Ticket Attachment - Files attached to tickets/responses
model TicketAttachment {
  id           Int             @id @default(autoincrement())
  ticketId     Int             @map("ticket_id")
  responseId   Int?            @map("response_id")
  userId       Int             @map("user_id")
  filename     String
  originalName String          @map("original_name")
  mimeType     String          @map("mime_type")
  fileSize     Int             @map("file_size") // bytes
  filePath     String          @map("file_path")
  createdAt    DateTime        @default(now()) @map("created_at")
  // Relations
  ticket       SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  response     TicketResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([responseId])
  @@map("ticket_attachments")
}

// Ticket Category Enum
enum TicketCategory {
  ACCESS // Login, permissions, account issues
  PAYMENTS // Payment processing, reconciliation
  REPORTS // Report generation, exports
  MEMBERS // Member management issues
  TECHNICAL // Technical issues, bugs
  BUG // Bug reports
  FEATURE_REQUEST // Feature requests
  BILLING // Subscription, plans, invoices (Tier 2: association admin to SocietyLedger)
  DATA // Data corrections and imports (Tier 2)
  OTHER // Other inquiries
}

// Who a ticket is for. ASSOCIATION = a member asking their own association's admins (Tier 1);
// PLATFORM = an association admin asking SocietyLedger support (Tier 2).
enum TicketAudience {
  ASSOCIATION
  PLATFORM
}

// Ticket Priority Enum
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Ticket Status Enum
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  WAITING_ON_STAFF
  RESOLVED
  CLOSED
}

// ============================================
// PHASE 14: WEBHOOKS MANAGEMENT MODELS
// ============================================

// Webhook Event Log - Track all webhook events (incoming and test)
model WebhookEventLog {
  id                  Int                  @id @default(autoincrement())
  associationId       Int                  @map("association_id")
  eventType           String               @map("event_type")
  status              WebhookEventStatus   @default(PENDING)
  statusCode          Int?                 @map("status_code")
  duration            Int?                 @map("duration")
  payload             Json?                @map("payload")
  responseBody        Json?                @map("response_body")
  errorMessage        String?              @map("error_message")
  source              String               @default("paystack") @map("source")
  endpoint            String?              @map("endpoint")
  retryCount          Int                  @default(0) @map("retry_count")
  isTest              Boolean              @default(false) @map("is_test")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  association         Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([associationId, eventType])
  @@index([associationId, source])
  @@index([associationId, createdAt])
  @@index([isTest])
  @@map("webhook_event_logs")
}

enum WebhookEventStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// ============================================
// BLOG & DOCUMENTATION SYSTEM MODELS
// Platform-level CMS for Super Admins
// ============================================

// Blog & Documentation Enums
enum ContentScope {
  PLATFORM
  ASSOCIATION  // Future extensibility
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

enum DocStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Blog Post Model
model BlogPost {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  coverImage      String?   // Cloudinary URL
  status          PostStatus @default(DRAFT)
  scope           ContentScope @default(PLATFORM)
  publishedAt     DateTime?
  viewCount       Int       @default(0)
  readTimeMinutes Int?
  
  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]  @default([])
  
  // Full-text search vector (managed by PostgreSQL triggers)
  searchVector    Unsupported("tsvector")?
  
  // Relations
  authorId        Int
  author          User      @relation("BlogPostAuthor", fields: [authorId], references: [id])
  categoryId      Int?
  category        BlogCategory? @relation(fields: [categoryId], references: [id])
  tags            BlogPostTag[]
  comments        BlogComment[]
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@map("blog_posts")
  @@index([status, publishedAt])
  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([status, viewCount], name: "blog_posts_status_viewcount_idx")
  @@index([searchVector], type: Gin, name: "blog_posts_search_idx")
}

// Blog Category Model
model BlogCategory {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  color       String?     // Hex color for UI
  posts       BlogPost[]
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  @@map("blog_categories")
}

// Blog Tag Model
model BlogTag {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String        @unique
  posts     BlogPostTag[]
  
  createdAt DateTime      @default(now()) @map("created_at")
  
  @@map("blog_tags")
}

// Blog Post Tag Junction Table
model BlogPostTag {
  postId    Int
  tagId     Int
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([postId, tagId])
  @@map("blog_post_tags")
}

// Blog Comment Model
model BlogComment {
  id        Int       @id @default(autoincrement())
  content   String    @db.Text
  status    CommentStatus @default(PENDING)
  
  postId    Int
  post      BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Authenticated user (optional)
  authorId  Int?
  author    User?     @relation("BlogCommentAuthor", fields: [authorId], references: [id])
  
  // Guest comments (optional)
  guestName  String?
  guestEmail String?
  
  // Threading
  parentId  Int?
  parent    BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   BlogComment[] @relation("CommentReplies")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  @@map("blog_comments")
  @@index([postId, status])
}

// Documentation Page Model
model DocPage {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  content         String    @db.Text
  excerpt         String?
  order           Int       @default(0)
  scope           ContentScope @default(PLATFORM)
  
  // Hierarchy
  parentId        Int?
  parent          DocPage?  @relation("DocPageHierarchy", fields: [parentId], references: [id])
  children        DocPage[] @relation("DocPageHierarchy")
  
  // Section
  sectionId       Int?
  section         DocSection? @relation(fields: [sectionId], references: [id])
  
  // SEO
  metaTitle       String?
  metaDescription String?
  
  // Versioning
  version         String    @default("1.0")
  isLatest        Boolean   @default(true)
  
  // Status
  status          DocStatus @default(DRAFT)
  publishedAt     DateTime?
  
  // Analytics
  viewCount       Int       @default(0)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  
  // Full-text search vector (managed by PostgreSQL triggers)
  searchVector    Unsupported("tsvector")?
  
  // Relations
  authorId        Int
  author          User      @relation("DocPageAuthor", fields: [authorId], references: [id])
  feedback        DocFeedback[]
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@map("doc_pages")
  @@index([status, publishedAt])
  @@index([slug])
  @@index([sectionId])
  @@index([parentId])
  @@index([status, viewCount], name: "doc_pages_status_viewcount_idx")
  @@index([searchVector], type: Gin, name: "doc_pages_search_idx")
}

// Documentation Section Model
model DocSection {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  icon        String?   // Icon name (e.g., "rocket", "book")
  order       Int       @default(0)
  pages       DocPage[]
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  @@map("doc_sections")
  @@index([order])
}

// Documentation Feedback Model
model DocFeedback {
  id        Int      @id @default(autoincrement())
  pageId    Int
  page      DocPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  isHelpful Boolean
  comment   String?  @db.Text

  // Authenticated user (optional)
  userId    Int?
  user      User?    @relation("DocFeedbackUser", fields: [userId], references: [id])

  // Anonymous feedback
  email     String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("doc_feedback")
  @@index([pageId])
}

// ============================================================
// A1.3 — Impersonation handoff (B4)
// One-time 60s code so the admin console never passes a JWT in a URL
// ============================================================
model ImpersonationHandoff {
  id              Int       @id @default(autoincrement())
  codeHash        String    @unique @map("code_hash")
  adminUserId     Int       @map("admin_user_id")
  adminUser       User      @relation(fields: [adminUserId], references: [id])
  associationId   Int       @map("association_id")
  association     Association @relation(fields: [associationId], references: [id])
  reason          String
  durationMinutes Int       @default(240) @map("duration_minutes")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("impersonation_handoffs")
}

// ============================================================
// A2.12 — Platform admin invites: email-link invite flow for adding
// new platform admin console users. tokenHash follows the same
// SHA-256-of-a-random-token pattern as ImpersonationHandoff above
// (never store the raw token — only what's needed to verify it).
// ============================================================
model PlatformAdminInvite {
  id           Int          @id @default(autoincrement())
  email        String
  platformRole PlatformRole @map("platform_role")
  tokenHash    String       @unique @map("token_hash")
  invitedById  Int          @map("invited_by")
  invitedBy    User         @relation("PlatformAdminInvitedBy", fields: [invitedById], references: [id])
  expiresAt    DateTime     @map("expires_at")
  acceptedAt   DateTime?    @map("accepted_at")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("platform_admin_invites")
}

// ============================================================
// A1.4 — TOTP 2FA for platform users (B5)
// ============================================================
model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("recovery_codes")
}

model AdminLoginChallenge {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("admin_login_challenges")
}

// ============================================
// Cash collections & lodgments
// ============================================
// Officers collect cash from members at meetings and later lodge it into an association bank account. Additive: the existing
// payment, savings, welfare, donation and loan tables are untouched — a receipt item points at the record it created by (kind, source_id).

// One occasion (a meeting or a day) on which an officer collects cash. Owned by the collector.
model CashCollection {
  id            Int                  @id @default(autoincrement())
  associationId Int                  @map("association_id")
  meetingId     Int?                 @map("meeting_id")
  title         String
  collectedBy   Int                  @map("collected_by") // User id of the officer holding the cash
  status        CashCollectionStatus @default(OPEN)
  notes         String?
  openedAt      DateTime             @default(now()) @map("opened_at")
  closedAt      DateTime?            @map("closed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  association Association              @relation(fields: [associationId], references: [id], onDelete: Cascade)
  receipts    CashReceipt[]
  allocations CashLodgmentAllocation[]

  @@index([associationId, status])
  @@index([associationId, collectedBy])
  @@index([meetingId])
  @@map("cash_collections")
}

// One member's cash payment inside a collection. It credits the member at once; the idempotency key makes a retry safe.
model CashReceipt {
  id             Int               @id @default(autoincrement())
  associationId  Int               @map("association_id")
  collectionId   Int               @map("collection_id")
  memberId       Int               @map("member_id")
  receiptNumber  String            @unique @map("receipt_number")
  idempotencyKey String            @map("idempotency_key")
  totalAmount    Decimal           @map("total_amount") @db.Decimal(12, 2)
  status         CashReceiptStatus @default(ACTIVE)
  createdBy      Int               @map("created_by")
  voidedBy       Int?              @map("voided_by")
  voidedAt       DateTime?         @map("voided_at")
  voidReason     String?           @map("void_reason")
  createdAt      DateTime          @default(now()) @map("created_at")

  association Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  collection  CashCollection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items       CashReceiptItem[]

  @@unique([associationId, idempotencyKey])
  @@index([collectionId, status])
  @@index([associationId, memberId])
  @@map("cash_receipts")
}

// What a receipt paid: one line per thing, pointing at the record the existing flow created.
model CashReceiptItem {
  id        Int          @id @default(autoincrement())
  receiptId Int          @map("receipt_id")
  kind      CashItemKind
  sourceId  Int?         @map("source_id") // payments / savings_transactions / welfare_contributions / donation_records / loan_repayments id
  label     String
  amount    Decimal      @db.Decimal(12, 2)

  receipt CashReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([kind, sourceId])
  @@map("cash_receipt_items")
}

// Cash paid into an association bank account, with a deposit-slip photo. A different officer verifies it against the statement.
model CashLodgment {
  id                Int                @id @default(autoincrement())
  associationId     Int                @map("association_id")
  bankAccountId     Int                @map("bank_account_id")
  lodgedBy          Int                @map("lodged_by")
  amount            Decimal            @db.Decimal(12, 2)
  expectedAmount    Decimal            @map("expected_amount") @db.Decimal(12, 2)
  shortfallReason   String?            @map("shortfall_reason")
  depositDate       DateTime           @map("deposit_date")
  bankReference     String?            @map("bank_reference")
  slipKey           String?            @map("slip_key")
  status            CashLodgmentStatus @default(PENDING)
  verifiedBy        Int?               @map("verified_by")
  verifiedAt        DateTime?          @map("verified_at")
  rejectionReason   String?            @map("rejection_reason")
  accountingEntryId Int?               @map("accounting_entry_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  association Association              @relation(fields: [associationId], references: [id], onDelete: Cascade)
  allocations CashLodgmentAllocation[]

  @@index([associationId, status])
  @@index([associationId, lodgedBy])
  @@map("cash_lodgments")
}

// How much of a lodgment came out of which collection.
model CashLodgmentAllocation {
  id           Int     @id @default(autoincrement())
  lodgmentId   Int     @map("lodgment_id")
  collectionId Int     @map("collection_id")
  amount       Decimal @db.Decimal(12, 2)

  lodgment   CashLodgment   @relation(fields: [lodgmentId], references: [id], onDelete: Cascade)
  collection CashCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([lodgmentId, collectionId])
  @@index([collectionId])
  @@map("cash_lodgment_allocations")
}

enum CashCollectionStatus {
  OPEN
  CLOSED
}

enum CashReceiptStatus {
  ACTIVE
  VOIDED
}

enum CashItemKind {
  DUES
  LEVY
  SAVINGS
  WELFARE
  DONATION
  LOAN_REPAYMENT
}

enum CashLodgmentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ============================================
// APP DOWNLOADS (website APK download with lead capture)
// ============================================

// One published build of the Android app. The file lives in object storage; we keep only the link the admin pasted.
model AppRelease {
  id        Int      @id @default(autoincrement())
  version   String
  url       String
  notes     String?  @db.Text
  isCurrent Boolean  @default(false) @map("is_current")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  downloads DownloadEvent[]

  @@index([isCurrent, isActive])
  @@map("app_releases")
}

// One person who asked to download the app. Unique by lower-cased email, so a returning visitor updates the row.
model DownloadLead {
  id           Int      @id @default(autoincrement())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  phone        String
  consent      Boolean  @default(false)
  consentedAt  DateTime? @map("consented_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  downloads DownloadEvent[]

  @@index([createdAt])
  @@map("download_leads")
}

// Every time the link was handed out. Analytics read this table; it is not proof the install finished.
model DownloadEvent {
  id         Int      @id @default(autoincrement())
  leadId     Int      @map("lead_id")
  releaseId  Int      @map("release_id")
  device     String   @default("other") // android | ios | desktop | other
  createdAt  DateTime @default(now()) @map("created_at")

  lead    DownloadLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  release AppRelease   @relation(fields: [releaseId], references: [id])

  @@index([createdAt])
  @@index([releaseId, createdAt])
  @@index([leadId])
  @@map("download_events")
}

// =====================================================================================================================
// Thrift (Ajo) add-on — Track T1.1. Specification: context/thrift-ajo-spec.md, contract: context/architecture.md §18.
// Rules these models keep true:
//  - SocietyLedger records group money; it never holds or moves it. Nothing here references a payment provider.
//  - Money is integer kobo in BigInt columns (a rotating pot can pass the 32-bit limit of ₦21,474,836.47).
//  - AjoLedgerEntry, AjoPayoutOrderEvent and rule versions are append-only; a correction is a new row that points at the original.
//  - Every table carries the tenant (`associationId`) so every query can be scoped to one association.
// =====================================================================================================================

enum AssociationKind {
  ASSOCIATION
  THRIFT_GROUP
}

enum AjoModel {
  COLLECTOR_THRIFT
  ROTATING_POT
}

enum AjoFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum AjoGroupStatus {
  DRAFT
  OPEN
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AjoFeeType {
  NONE
  FIXED
  PERCENT
  DAYS
}

enum AjoMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
  DEFAULTED
}

enum AjoInstallmentStatus {
  DUE
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum AjoContributionMethod {
  CASH
  TRANSFER
}

enum AjoContributionStatus {
  REPORTED
  CASH_RECEIVED
  CONFIRMED
  REVERSED
  /// A reported transfer an officer turned down, with a reason. Never counted, so there is nothing to reverse.
  REJECTED
}

enum AjoReceiptMoment {
  RECORDED
  CONFIRMED
  REJECTED
  MISSING
  REVERSED
}

enum AjoReceiptState {
  SENT
  QUEUED
  SKIPPED
  FAILED
}

enum AjoPayoutStatus {
  PREPARED
  APPROVED
  PAID
  VOID
  /// Was recorded as paid, then reversed by an admin with a reason (the money came back, or it was recorded in error).
  REVERSED
}

enum AjoLevyKind {
  CYCLE
  PARTICIPANT
  /// A negative amount: the same levy was paid twice, so the extra is kept as a credit against the next levy.
  CREDIT
}

enum AjoLevyStatus {
  ACCRUED
  BILLED
  PAID
  WAIVED
  VOID
}

enum AjoLedgerEntryType {
  CONTRIBUTION
  REVERSAL
  FEE
  PAYOUT
  ADJUSTMENT
}

enum AjoLedgerDirection {
  CREDIT
  DEBIT
}

enum AjoVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AjoLateFeeStatus {
  PENDING
  PAYABLE
  WAIVED
}

enum AjoTrustBand {
  EXCELLENT
  GOOD
  FAIR
  AT_RISK
  NO_HISTORY
}

enum AjoOrderEventType {
  DRAW
  SWAP
  EXCEPTION
}

enum AjoDisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum AjoDefaultCaseStatus {
  OPEN
  PLAN_AGREED
  RESOLVED
  CLOSED_UNRESOLVED
}

enum AjoRepaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// A circle: collector thrift or rotating pot. Money fields lock once the group is ACTIVE (enforced in the service).
model AjoGroup {
  id                  Int             @id @default(autoincrement())
  associationId       Int             @map("association_id")
  name                String
  model               AjoModel
  frequency           AjoFrequency
  contributionKobo    BigInt          @map("contribution_kobo")
  startDate           DateTime        @map("start_date") @db.Date
  /// Number of periods in a collector-thrift cycle.
  cycleLength         Int?            @map("cycle_length")
  /// Number of rounds in a rotating pot (equals the participants).
  rounds              Int?
  maxParticipants     Int             @map("max_participants")
  collectorFeeType    AjoFeeType      @default(NONE) @map("collector_fee_type")
  /// Kobo for FIXED, whole days of contribution for DAYS, basis points for PERCENT.
  collectorFeeValue   BigInt          @default(0) @map("collector_fee_value")
  /// The group's OWN bank account, where contributors pay. Shown masked everywhere except to the person entering it and ajo.manage.
  bankName            String?         @map("bank_name")
  /// Encrypted at rest (AES-256-GCM, bound to the group). Contributors need the full number to pay, so group members see it; every
  /// list, audit row and notification carries the masked form built from bankAccountLast4.
  bankAccountEnc      String?         @map("bank_account_enc")
  bankAccountLast4    String?         @map("bank_account_last4")
  bankAccountName     String?         @map("bank_account_name")
  timezone            String          @default("Africa/Lagos")
  /// "HH:mm" in the group's timezone; a payment after it counts for the next day.
  cutoffTime          String          @default("18:00") @map("cutoff_time")
  requirePhoneConfirm Boolean         @default(false) @map("require_phone_confirm")
  /// Rotating pot: the most shares (payout slots) one participant may hold.
  maxSharesPerMember  Int             @default(2) @map("max_shares_per_member")
  /// Collector thrift: may people join after the group has started?
  allowLateJoin       Boolean         @default(true) @map("allow_late_join")
  status              AjoGroupStatus  @default(DRAFT)
  startedAt           DateTime?       @map("started_at")
  /// The last due date of the schedule, fixed at start so a late joiner's schedule ends where everyone else's does.
  endsOn              DateTime?       @map("ends_on") @db.Date
  cancelledAt         DateTime?       @map("cancelled_at")
  cancelReason        String?         @map("cancel_reason")
  createdBy           Int?            @map("created_by")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  association         Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  ruleVersions        AjoGroupRuleVersion[]
  memberships         AjoMembership[]
  contributions       AjoContribution[]
  payouts             AjoPayout[]
  ledgerEntries       AjoLedgerEntry[]
  orderEvents         AjoPayoutOrderEvent[]
  slots               AjoPayoutSlot[]
  orderRequests       AjoOrderChangeRequest[]
  handovers           AjoCashHandover[]
  defaultCases        AjoDefaultCase[]

  @@index([associationId, status])
  @@map("ajo_groups")
}

/// Versioned rules. Never edited: a change adds a version that applies from `effectiveFrom`.
model AjoGroupRuleVersion {
  id                  Int          @id @default(autoincrement())
  associationId       Int          @map("association_id")
  groupId             Int          @map("group_id")
  version             Int
  /// NONE | FIXED | PERCENT; the amount is kobo for FIXED and basis points for PERCENT.
  lateFeeType         AjoFeeType   @default(NONE) @map("late_fee_type")
  lateFeeValue        BigInt       @default(0) @map("late_fee_value")
  lateFeeCapKobo      BigInt?      @map("late_fee_cap_kobo")
  graceDays           Int          @default(3) @map("grace_days")
  /// NOT_REQUIRED | OPTIONAL | REQUIRED
  guarantorPolicy     String       @default("OPTIONAL") @map("guarantor_policy")
  /// NOTIFY_ADMIN | REPAYMENT_PLAN | CASE_AND_PLAN
  defaultProcedure    String       @default("CASE_AND_PLAN") @map("default_procedure")
  remindersEnabled    Boolean      @default(true) @map("reminders_enabled")
  /// Optional rotating-pot rule: AT_RISK participants cannot take the first positions.
  blockAtRiskEarly    Boolean      @default(false) @map("block_at_risk_early")
  effectiveFrom       DateTime     @map("effective_from")
  createdBy           Int?         @map("created_by")
  createdAt           DateTime     @default(now()) @map("created_at")
  group               AjoGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  acceptances         AjoRuleAcceptance[]

  @@unique([groupId, version])
  @@index([associationId])
  @@map("ajo_group_rule_versions")
}

model AjoRuleAcceptance {
  id              Int                 @id @default(autoincrement())
  associationId   Int                 @map("association_id")
  membershipId    Int                 @map("membership_id")
  ruleVersionId   Int                 @map("rule_version_id")
  acceptedAt      DateTime            @default(now()) @map("accepted_at")
  /// Where the acceptance came from, e.g. { channel: "mobile", device: "..." }.
  evidence        Json?
  membership      AjoMembership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  ruleVersion     AjoGroupRuleVersion @relation(fields: [ruleVersionId], references: [id])

  @@unique([membershipId, ruleVersionId])
  @@index([associationId])
  @@map("ajo_rule_acceptances")
}

/// A contributor's place in a group. The contributor is an existing Member (no parallel identity table).
model AjoMembership {
  id                    Int                 @id @default(autoincrement())
  associationId         Int                 @map("association_id")
  groupId               Int                 @map("group_id")
  memberId              Int                 @map("member_id")
  status                AjoMembershipStatus @default(PENDING)
  approvedBy            Int?                @map("approved_by")
  approvedAt            DateTime?           @map("approved_at")
  /// Rotating pot: how many rounds this person takes (and how many times the contribution they pay every round). Fixed at start.
  shares                Int                 @default(1)
  guarantorAgreementId  Int?                @unique @map("guarantor_agreement_id")
  phoneConfirmedAt      DateTime?           @map("phone_confirmed_at")
  /// The normalised number that was confirmed; a different number on the Member clears the confirmation.
  phoneConfirmedNumber  String?             @map("phone_confirmed_number")
  /// Keyed hash of the SMS code (never the code). Cleared once used, locked or expired.
  phoneCodeHash         String?             @map("phone_code_hash")
  phoneCodeExpiresAt    DateTime?           @map("phone_code_expires_at")
  phoneCodeAttempts     Int                 @default(0) @map("phone_code_attempts")
  phoneCodeSentAt       DateTime?           @map("phone_code_sent_at")
  /// Codes sent on phoneCodeDay, counted across all of the person's memberships for the daily cap.
  phoneCodeDay          DateTime?           @map("phone_code_day") @db.Date
  phoneCodeDayCount     Int                 @default(0) @map("phone_code_day_count")
  acceptedRuleVersionId Int?                @map("accepted_rule_version_id")
  joinedAt              DateTime?           @map("joined_at")
  leftAt                DateTime?           @map("left_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  group                 AjoGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member                Member              @relation(fields: [memberId], references: [id])
  guarantorAgreement    AjoGuarantorAgreement? @relation(fields: [guarantorAgreementId], references: [id])
  acceptances           AjoRuleAcceptance[]
  installments          AjoInstallment[]
  contributions         AjoContribution[]
  assignments           AjoCollectorAssignment[]
  slots                 AjoPayoutSlot[]
  payouts               AjoPayout[]
  ledgerEntries         AjoLedgerEntry[]
  trustSnapshots        AjoTrustSnapshot[]
  disputes              AjoDispute[]
  defaultCases          AjoDefaultCase[]

  @@unique([groupId, memberId])
  @@index([associationId, status])
  @@index([memberId])
  @@map("ajo_memberships")
}

model AjoInstallment {
  id            Int                  @id @default(autoincrement())
  associationId Int                  @map("association_id")
  membershipId  Int                  @map("membership_id")
  dueDate       DateTime             @map("due_date") @db.Date
  amountKobo    BigInt               @map("amount_kobo")
  paidKobo      BigInt               @default(0) @map("paid_kobo")
  status        AjoInstallmentStatus @default(DUE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  membership    AjoMembership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  contributions AjoContribution[]
  allocations   AjoContributionAllocation[]
  lateFees      AjoLateFeeAssessment[]

  @@unique([membershipId, dueDate])
  @@index([associationId, status, dueDate])
  @@map("ajo_installments")
}

/// One recorded payment. Amount and identity never change; only the confirmation status moves forward, and a correction is a new
/// row with status REVERSED that points at the original through `reversalOfId`.
model AjoContribution {
  id             Int                   @id @default(autoincrement())
  associationId  Int                   @map("association_id")
  groupId        Int                   @map("group_id")
  membershipId   Int                   @map("membership_id")
  installmentId  Int?                  @map("installment_id")
  amountKobo     BigInt                @map("amount_kobo")
  method         AjoContributionMethod
  status         AjoContributionStatus @default(REPORTED)
  collectorId    Int?                  @map("collector_id")
  reference      String
  proofKey       String?               @map("proof_key")
  idempotencyKey String                @unique @map("idempotency_key")
  reason         String?
  receivedAt     DateTime              @map("received_at")
  confirmedAt    DateTime?             @map("confirmed_at")
  confirmedBy    Int?                  @map("confirmed_by")
  reversalOfId   Int?                  @unique @map("reversal_of_id")
  recordedBy     Int?                  @map("recorded_by")
  /// The calendar day the payment counts for in the group's timezone, after the cutoff time (see ajo-schedule.ts businessDay).
  businessDate   DateTime?             @map("business_date") @db.Date
  /// SHA-256 of the proof file, and what the contributor typed. Used to flag the same proof being used twice.
  proofHash      String?               @map("proof_hash")
  bankReference  String?               @map("bank_reference")
  paidOn         DateTime?             @map("paid_on") @db.Date
  /// Set when another contribution in the association has the same proof hash or bank reference.
  duplicateOfId  Int?                  @map("duplicate_of_id")
  duplicateAckBy Int?                  @map("duplicate_ack_by")
  duplicateAckNote String?             @map("duplicate_ack_note")
  /// Cash: the handover it was handed in with, and whether the officer found it missing from that handover.
  handoverId     Int?                  @map("handover_id")
  missingFromHandover Boolean          @default(false) @map("missing_from_handover")
  /// Confirmed by the same person who recorded it, which is allowed only for a sole reconciler, with a note.
  selfConfirmed  Boolean               @default(false) @map("self_confirmed")
  confirmNote    String?               @map("confirm_note")
  rejectedBy     Int?                  @map("rejected_by")
  rejectedAt     DateTime?             @map("rejected_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  group          AjoGroup              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership     AjoMembership         @relation(fields: [membershipId], references: [id])
  installment    AjoInstallment?       @relation(fields: [installmentId], references: [id])
  reversalOf     AjoContribution?      @relation("AjoContributionReversal", fields: [reversalOfId], references: [id])
  reversedBy     AjoContribution?      @relation("AjoContributionReversal")
  handover       AjoCashHandover?      @relation(fields: [handoverId], references: [id])
  allocations    AjoContributionAllocation[]
  receipts       AjoReceipt[]
  disputes       AjoDispute[]

  @@index([associationId, groupId, status])
  @@index([membershipId, receivedAt])
  @@index([associationId, proofHash])
  @@index([associationId, bankReference])
  @@index([handoverId])
  @@index([groupId, collectorId, businessDate])
  @@map("ajo_contributions")
}

model AjoCollectorAssignment {
  id              Int           @id @default(autoincrement())
  associationId   Int           @map("association_id")
  /// The collector is a User (a login), not a Member.
  collectorUserId Int           @map("collector_user_id")
  membershipId    Int           @map("membership_id")
  dailyTargetKobo BigInt?       @map("daily_target_kobo")
  startsOn        DateTime      @map("starts_on") @db.Date
  endsOn          DateTime?     @map("ends_on") @db.Date
  createdBy       Int?          @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  membership      AjoMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([associationId, collectorUserId])
  @@index([membershipId])
  @@map("ajo_collector_assignments")
}

model AjoCashHandover {
  id               Int       @id @default(autoincrement())
  associationId    Int       @map("association_id")
  groupId          Int       @map("group_id")
  collectorUserId  Int       @map("collector_user_id")
  forDate          DateTime  @map("for_date") @db.Date
  expectedKobo     BigInt    @map("expected_kobo")
  collectedKobo    BigInt    @map("collected_kobo")
  handedOverKobo   BigInt    @map("handed_over_kobo")
  differenceKobo   BigInt    @map("difference_kobo")
  idempotencyKey   String    @unique @map("idempotency_key")
  reconciledBy     Int?      @map("reconciled_by")
  reconciledAt     DateTime? @map("reconciled_at")
  note             String?
  /// What the officer counted, the sum of the daily targets of the collector's people (frozen), and the officer's note.
  countedKobo      BigInt?   @map("counted_kobo")
  targetKobo       BigInt?   @map("target_kobo")
  reconcileNote    String?   @map("reconcile_note")
  createdAt        DateTime  @default(now()) @map("created_at")
  group            AjoGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contributions    AjoContribution[]

  @@unique([groupId, collectorUserId, forDate])
  @@index([associationId])
  @@map("ajo_cash_handovers")
}

/// A member's payout account: recorded, not verified by any service. The number is masked in every response.
model AjoPayoutAccount {
  id            Int      @id @default(autoincrement())
  associationId Int      @map("association_id")
  memberId      Int      @unique @map("member_id")
  bankName      String   @map("bank_name")
  /// AES-256-GCM, bound to the member (see modules/ajo/ajo-secrets.ts). The full number is never stored in readable form.
  accountNumberEnc String @map("account_number_enc")
  /// The last four digits, so lists and masked responses never need to decrypt anything.
  last4         String   @map("last4")
  accountName   String   @map("account_name")
  changedAt     DateTime @default(now()) @map("changed_at")
  changedBy     Int?     @map("changed_by")
  /// A payout cannot be approved before this time after a change.
  coolOffUntil  DateTime? @map("cool_off_until")
  createdAt     DateTime @default(now()) @map("created_at")
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@map("ajo_payout_accounts")
}

model AjoPayout {
  id                    Int             @id @default(autoincrement())
  associationId         Int             @map("association_id")
  groupId               Int             @map("group_id")
  membershipId          Int             @map("membership_id")
  /// The round for a rotating pot; null for collector thrift.
  round                 Int?
  grossKobo             BigInt          @map("gross_kobo")
  collectorFeeKobo      BigInt          @default(0) @map("collector_fee_kobo")
  shortfallKobo         BigInt          @default(0) @map("shortfall_kobo")
  netKobo               BigInt          @map("net_kobo")
  /// Everything confirmed for this round (or this participant's cycle) when the payout was prepared, in all payouts so far.
  confirmedKobo         BigInt          @default(0) @map("confirmed_kobo")
  /// 1 for the first payout of a round, 2.. for supplementary payouts made when late money arrived.
  sequence              Int             @default(1)
  status                AjoPayoutStatus @default(PREPARED)
  preparedBy            Int             @map("prepared_by")
  preparedAt            DateTime        @default(now()) @map("prepared_at")
  approvedBy            Int?            @map("approved_by")
  approvedAt            DateTime?       @map("approved_at")
  /// Set when a single-admin group approved its own preparation with the extra confirmation.
  selfApprovalConfirmed Boolean         @default(false) @map("self_approval_confirmed")
  /// Masked snapshot of the payout account at preparation: { bankName, accountName, last4 }.
  accountSnapshot       Json            @map("account_snapshot")
  paidReference         String?         @map("paid_reference")
  paidRecordedBy        Int?            @map("paid_recorded_by")
  paidAt                DateTime?       @map("paid_at")
  voidReason            String?         @map("void_reason")
  /// A voided payout that was voided because the bank transfer failed (the admins are told).
  failed                Boolean         @default(false)
  voidedBy              Int?            @map("voided_by")
  voidedAt              DateTime?       @map("voided_at")
  approvalNote          String?         @map("approval_note")
  /// The bank's reference, as typed, and the same with case, spaces and dashes removed (for the duplicate check).
  paidReferenceKey      String?         @map("paid_reference_key")
  proofKey              String?         @map("proof_key")
  reversedBy            Int?            @map("reversed_by")
  reversedAt            DateTime?       @map("reversed_at")
  reverseReason         String?         @map("reverse_reason")
  idempotencyKey        String          @unique @map("idempotency_key")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  group                 AjoGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership            AjoMembership   @relation(fields: [membershipId], references: [id])

  @@index([associationId, groupId, status])
  @@index([membershipId])
  @@index([associationId, paidReferenceKey])
  @@map("ajo_payouts")
}

model AjoLateFeeAssessment {
  id             Int              @id @default(autoincrement())
  associationId  Int              @map("association_id")
  installmentId  Int              @map("installment_id")
  ruleVersionId  Int              @map("rule_version_id")
  basisKobo      BigInt           @map("basis_kobo")
  feeKobo        BigInt           @map("fee_kobo")
  capApplied     Boolean          @default(false) @map("cap_applied")
  /// The stored calculation, shown to the member: { type, value, basisKobo, rawKobo, capKobo }.
  calculation    Json
  status         AjoLateFeeStatus @default(PENDING)
  waivedBy       Int?             @map("waived_by")
  waivedReason   String?          @map("waived_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  installment    AjoInstallment   @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@unique([installmentId, ruleVersionId])
  @@index([associationId, status])
  @@map("ajo_late_fee_assessments")
}

model AjoDefaultCase {
  id                  Int                  @id @default(autoincrement())
  associationId       Int                  @map("association_id")
  groupId             Int                  @map("group_id")
  membershipId        Int                  @map("membership_id")
  status              AjoDefaultCaseStatus @default(OPEN)
  outstandingKobo     BigInt               @map("outstanding_kobo")
  memberResponse      String?              @map("member_response")
  resolution          String?
  openedBy            Int?                 @map("opened_by")
  openedAt            DateTime             @default(now()) @map("opened_at")
  closedAt            DateTime?            @map("closed_at")
  group               AjoGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership          AjoMembership        @relation(fields: [membershipId], references: [id])
  plans               AjoRepaymentPlan[]

  @@index([associationId, status])
  @@map("ajo_default_cases")
}

model AjoRepaymentPlan {
  id            Int                    @id @default(autoincrement())
  associationId Int                    @map("association_id")
  caseId        Int                    @map("case_id")
  status        AjoRepaymentPlanStatus @default(ACTIVE)
  /// [{ dueDate, amountKobo }]
  schedule      Json
  agreedBy      Int?                   @map("agreed_by")
  createdAt     DateTime               @default(now()) @map("created_at")
  defaultCase   AjoDefaultCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@map("ajo_repayment_plans")
}

/// A recorded consent only. SocietyLedger does not create or enforce a legal guarantee.
model AjoGuarantorAgreement {
  id             Int            @id @default(autoincrement())
  associationId  Int            @map("association_id")
  name           String
  phone          String
  relationship   String
  /// The exact wording the guarantor accepted, stored as shown.
  wording        String
  acceptedAt     DateTime?      @map("accepted_at")
  /// The officer who recorded the consent, and how it was given: { channel: "officer", note }.
  recordedBy     Int?           @map("recorded_by")
  evidence       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  membership     AjoMembership?

  @@index([associationId])
  @@map("ajo_guarantor_agreements")
}

/// Append-only money record. Balances are derived from these rows, never stored as the source of truth.
model AjoLedgerEntry {
  id             Int                @id @default(autoincrement())
  associationId  Int                @map("association_id")
  groupId        Int                @map("group_id")
  membershipId   Int?               @map("membership_id")
  type           AjoLedgerEntryType
  direction      AjoLedgerDirection
  amountKobo     BigInt             @map("amount_kobo")
  refType        String             @map("ref_type")
  refId          Int?               @map("ref_id")
  idempotencyKey String             @unique @map("idempotency_key")
  /// A reversal points at the entry it cancels; one entry can be reversed once.
  reversalOfId   Int?               @unique @map("reversal_of_id")
  reason         String?
  createdBy      Int?               @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  group          AjoGroup           @relation(fields: [groupId], references: [id])
  membership     AjoMembership?     @relation(fields: [membershipId], references: [id])
  reversalOf     AjoLedgerEntry?    @relation("AjoLedgerReversal", fields: [reversalOfId], references: [id])
  reversedBy     AjoLedgerEntry?    @relation("AjoLedgerReversal")

  @@index([associationId, groupId, createdAt])
  @@index([membershipId])
  @@index([refType, refId])
  @@map("ajo_ledger_entries")
}

model AjoTrustSnapshot {
  id            Int           @id @default(autoincrement())
  associationId Int           @map("association_id")
  membershipId  Int           @map("membership_id")
  /// Basis points (9500 = 95.00%); null when there is no history yet.
  onTimeBps     Int?          @map("on_time_bps")
  onTimeCount   Int           @map("on_time_count")
  dueCount      Int           @map("due_count")
  band          AjoTrustBand
  computedAt    DateTime      @default(now()) @map("computed_at")
  membership    AjoMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, computedAt])
  @@index([associationId])
  @@map("ajo_trust_snapshots")
}

/// Step two of joining: SocietyLedger staff check name, phone, address and payout account name. No ID numbers or photos.
model AjoVerification {
  id                   Int                   @id @default(autoincrement())
  associationId        Int                   @map("association_id")
  memberId             Int                   @map("member_id")
  submittedName        String                @map("submitted_name")
  submittedPhone       String?               @map("submitted_phone")
  submittedAddress     String?               @map("submitted_address")
  submittedAccountName String?               @map("submitted_account_name")
  status               AjoVerificationStatus @default(PENDING)
  nameMatchesAccount   Boolean?              @map("name_matches_account")
  phoneConfirmed       Boolean?              @map("phone_confirmed")
  addressFilled        Boolean?              @map("address_filled")
  reviewedBy           Int?                  @map("reviewed_by")
  reviewedAt           DateTime?             @map("reviewed_at")
  rejectionReason      String?               @map("rejection_reason")
  createdAt            DateTime              @default(now()) @map("created_at")
  member               Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([memberId, createdAt])
  @@map("ajo_verifications")
}

/// Rotating-pot order history. Append-only.
model AjoPayoutOrderEvent {
  id             Int               @id @default(autoincrement())
  associationId  Int               @map("association_id")
  groupId        Int               @map("group_id")
  type           AjoOrderEventType
  /// DRAW: { seed, positions: [{ membershipId, position }] }. SWAP: { a, b }. EXCEPTION: { membershipId, newPosition }.
  detail         Json
  reason         String?
  requestedBy    Int?              @map("requested_by")
  approvedBy     Int?              @map("approved_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  group          AjoGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([associationId, groupId, createdAt])
  @@map("ajo_payout_order_events")
}

/// How one confirmed payment was split across installments (oldest first). A reversal reads these rows to undo exactly what was paid.
model AjoContributionAllocation {
  id             Int             @id @default(autoincrement())
  associationId  Int             @map("association_id")
  contributionId Int             @map("contribution_id")
  installmentId  Int             @map("installment_id")
  amountKobo     BigInt          @map("amount_kobo")
  createdAt      DateTime        @default(now()) @map("created_at")
  contribution   AjoContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  installment    AjoInstallment  @relation(fields: [installmentId], references: [id])

  @@unique([contributionId, installmentId])
  @@index([installmentId])
  @@index([associationId])
  @@map("ajo_contribution_allocations")
}

/// One receipt per contribution per moment. The unique key is what makes "exactly one receipt" true however often a request is repeated.
model AjoReceipt {
  id             Int              @id @default(autoincrement())
  associationId  Int              @map("association_id")
  contributionId Int              @map("contribution_id")
  moment         AjoReceiptMoment
  state          AjoReceiptState  @default(QUEUED)
  /// The text that goes to the contributor, written when the receipt is created.
  message        String
  /// Which channels carried it: { inApp, email, sms }.
  channels       Json?
  attempts       Int              @default(0)
  lastError      String?          @map("last_error")
  /// When the admins were told that receipts are waiting for SMS credits (once, not per message).
  alertedAt      DateTime?        @map("alerted_at")
  sentAt         DateTime?        @map("sent_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  contribution   AjoContribution  @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([contributionId, moment])
  @@index([associationId, state])
  @@map("ajo_receipts")
}

/// SocietyLedger's own platform levy on a group (never part of contribution money). Immutable except for its status, which staff and the
/// billing system move. Every record carries the calculation that produced it.
model AjoLevyAssessment {
  id              Int            @id @default(autoincrement())
  associationId   Int            @map("association_id")
  groupId         Int            @map("group_id")
  /// Set for a participant levy.
  membershipId    Int?           @map("membership_id")
  kind            AjoLevyKind
  status          AjoLevyStatus  @default(ACCRUED)
  /// Makes assessing twice a no-op: "cycle:<groupId>", "participant:<membershipId>" or "credit:<paymentId>:<n>".
  dedupeKey       String         @unique @map("dedupe_key")
  /// What the levy is worked out from, in kobo (the scheduled contributions), and the settings it was worked out with.
  baseKobo        BigInt         @map("base_kobo")
  rateBps         Int            @map("rate_bps")
  minKobo         BigInt         @map("min_kobo")
  maxKobo         BigInt         @map("max_kobo")
  /// Signed: a CREDIT is negative.
  amountKobo      BigInt         @map("amount_kobo")
  addonCode       String         @map("addon_code")
  calculation     String
  /// The checkout payment it is currently on, and the payment that settled it.
  billedPaymentId Int?           @map("billed_payment_id")
  paidPaymentId   Int?           @map("paid_payment_id")
  statusReason    String?        @map("status_reason")
  statusBy        Int?           @map("status_by")
  statusAt        DateTime?      @map("status_at")
  accruedAt       DateTime       @default(now()) @map("accrued_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([associationId, status])
  @@index([groupId])
  @@map("ajo_levy_assessments")
}

enum AjoRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// One payout slot = one share in a rotating pot. Created by the draw; `position` is the round the slot is paid in (1..total shares).
model AjoPayoutSlot {
  id            Int           @id @default(autoincrement())
  associationId Int           @map("association_id")
  groupId       Int           @map("group_id")
  membershipId  Int           @map("membership_id")
  /// 1..shares for this membership.
  shareNo       Int           @map("share_no")
  position      Int
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  group         AjoGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership    AjoMembership @relation(fields: [membershipId], references: [id])

  @@unique([groupId, membershipId, shareNo])
  @@unique([groupId, position])
  @@index([associationId, groupId])
  @@map("ajo_payout_slots")
}

/// A proposed swap of two slots, waiting for the admin. Applying it writes an AjoPayoutOrderEvent; this row is the request, not the history.
model AjoOrderChangeRequest {
  id            Int              @id @default(autoincrement())
  associationId Int              @map("association_id")
  groupId       Int              @map("group_id")
  slotAId       Int              @map("slot_a_id")
  slotBId       Int              @map("slot_b_id")
  reason        String?
  status        AjoRequestStatus @default(PENDING)
  requestedBy   Int              @map("requested_by")
  decidedBy     Int?             @map("decided_by")
  decidedAt     DateTime?        @map("decided_at")
  decisionNote  String?          @map("decision_note")
  createdAt     DateTime         @default(now()) @map("created_at")
  group         AjoGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([associationId, groupId, status])
  @@map("ajo_order_change_requests")
}

model AjoDispute {
  id             Int              @id @default(autoincrement())
  associationId  Int              @map("association_id")
  membershipId   Int              @map("membership_id")
  contributionId Int?             @map("contribution_id")
  claim          String
  evidenceKey    String?          @map("evidence_key")
  status         AjoDisputeStatus @default(OPEN)
  resolution     String?
  resolvedBy     Int?             @map("resolved_by")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  membership     AjoMembership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  contribution   AjoContribution? @relation(fields: [contributionId], references: [id])

  @@index([associationId, status])
  @@map("ajo_disputes")
}
