generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Association {
  id                         Int                         @id @default(autoincrement())
  name                       String
  slug                       String                      @unique
  subdomain                  String                      @unique
  tier                       AssociationTier             @default(STARTER)
  status                     AssociationStatus           @default(ACTIVE)
  logo                       String?
  primaryColor               String?                     @map("primary_color")
  subscriptionExpiresAt      DateTime?                   @map("subscription_expires_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  accounting                 AccountingEntry[]
  auditLogs                  AuditLog[]
  exports                    ExportHistory[]
  categories                 FinancialCategory[]
  memberInvites              MemberInvite[]
  members                    Member[]
  notifications              Notification[]
  paymentGatewayTransactions PaymentGatewayTransaction[]
  payments                   Payment[]
  settings                   Settings[]
  subscriptions              Subscription[]
  transactions               Transaction[]
  users                      User[]
  levyCampaigns              LevyCampaign[]
  penaltyRules               PenaltyRule[]
  penaltyWaivers             PenaltyWaiver[]
  donationAllocations        DonationAllocation[]
  // Phase 9: Accounting System
  chartOfAccounts            ChartOfAccount[]
  journalEntries             JournalEntry[]
  budgets                    Budget[]
  accountingPeriods          AccountingPeriod[]
  // Phase 3.5: Nigerian Payment Features
  bankAccounts               AssociationBankAccount[]
  bankTransfers              BankTransfer[]
  bankStatementImports       BankStatementImport[]
  paymentReconciliations     PaymentReconciliation[]
  paymentProofs              PaymentProof[]
  // Phase 8.5: Cooperatives & Loans
  savingsAccounts            SavingsAccount[]
  savingsTransactions        SavingsTransaction[]
  loanProducts               LoanProduct[]
  loanApplications           LoanApplication[]
  loanGuarantors             LoanGuarantor[]
  loans                      Loan[]
  loanRepayments             LoanRepayment[]
  // Member Financial Ledger
  memberLedgerEntries        MemberFinancialLedger[]

  @@map("associations")
}

model User {
  id                           Int                  @id @default(autoincrement())
  associationId                Int?                 @map("association_id")
  email                        String
  passwordHash                 String               @map("password_hash")
  role                         String               @default("member")
  platformRole                 PlatformRole?        @map("platform_role")
  isActive                     Boolean              @default(false) @map("is_active")
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")
  emailVerified                Boolean              @default(false) @map("email_verified")
  passwordResetExpiresAt       DateTime?            @map("password_reset_expires_at")
  passwordResetToken           String?              @map("password_reset_token")
  verificationCode             String?              @map("verification_code")
  verificationExpiresAt        DateTime?            @map("verification_expires_at")
  approvedAccountingEntries    AccountingEntry[]    @relation("AccountingEntryApprovedBy")
  createdAccountingEntries     AccountingEntry[]    @relation("AccountingEntryCreatedBy")
  auditLogs                    AuditLog[]
  exports                      ExportHistory[]
  sentMemberInvites            MemberInvite[]       @relation("MemberInvitedBy")
  member                       Member?
  notifications                Notification[]
  confirmedPayments            Payment[]            @relation("PaymentConfirmedBy")
  settingsUpdates              Settings[]           @relation("SettingsUpdatedBy")
  createdTransactions          Transaction[]        @relation("TransactionCreatedBy")
  approvedUsers                UserApproval[]       @relation("UserApprovedBy")
  userApproval                 UserApproval?
  association                  Association?         @relation(fields: [associationId], references: [id])
  // Phase 9: Accounting System
  createdJournalEntries        JournalEntry[]       @relation("JournalEntryCreatedBy")
  approvedJournalEntries       JournalEntry[]       @relation("JournalEntryApprovedBy")
  rejectedJournalEntries       JournalEntry[]       @relation("JournalEntryRejectedBy")
  createdBudgets               Budget[]             @relation("BudgetCreatedBy")
  approvedBudgets              Budget[]             @relation("BudgetApprovedBy")
  closedPeriods                AccountingPeriod[]   @relation("PeriodClosedBy")
  // Phase 8.5: Cooperatives & Loans
  processedSavingsTransactions SavingsTransaction[] @relation("SavingsTransactionProcessor")
  reviewedLoanApplications     LoanApplication[]    @relation("LoanApplicationReviewer")
  approvedLoanApplications     LoanApplication[]    @relation("LoanApplicationApprover")
  processedLoanRepayments      LoanRepayment[]      @relation("LoanRepaymentProcessor")

  @@unique([associationId, email])
  @@index([associationId, email])
  @@map("users")
}

model UserApproval {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  approvalStatus  String    @default("pending") @map("approval_status")
  approvedById    Int?      @map("approved_by")
  approvalDate    DateTime? @map("approval_date")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  approvedBy      User?     @relation("UserApprovedBy", fields: [approvedById], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_approvals")
}

model Member {
  id                           Int                      @id @default(autoincrement())
  associationId                Int                      @map("association_id")
  userId                       Int?                     @unique @map("user_id")
  memberId                     String                   @map("member_id")
  firstName                    String                   @map("first_name")
  lastName                     String                   @map("last_name")
  email                        String?
  phone                        String?
  address                      String?
  joinDate                     DateTime?                @map("join_date")
  status                       String                   @default("active")
  category                     String                   @default("regular")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  city                         String?
  country                      String?
  dateOfBirth                  DateTime?                @map("date_of_birth")
  emergencyContactName         String?                  @map("emergency_contact_name")
  emergencyContactPhone        String?                  @map("emergency_contact_phone")
  emergencyContactRelationship String?                  @map("emergency_contact_relationship")
  gender                       String                   @default("male")
  notes                        String?
  occupation                   String?
  state                        String?
  loginStatus                  String                   @default("no_login") @map("login_status")
  invites                      MemberInvite[]
  association                  Association              @relation(fields: [associationId], references: [id])
  user                         User?                    @relation(fields: [userId], references: [id])
  transactions                 Transaction[]
  levyAssignments              LevyCampaignAssignment[]
  // Phase 3.5: Nigerian Payment Features
  bankTransfers                BankTransfer[]
  paymentProofs                PaymentProof[]
  // Phase 8.5: Cooperatives & Loans
  savingsAccounts              SavingsAccount[]
  loanApplications             LoanApplication[]
  guaranteedLoans              LoanGuarantor[]
  loans                        Loan[]
  // Member Financial Ledger
  ledgerEntries                MemberFinancialLedger[]

  @@unique([associationId, memberId])
  @@index([associationId, status])
  @@index([loginStatus])
  @@map("members")
}

model MemberInvite {
  id                   Int         @id @default(autoincrement())
  associationId        Int         @map("association_id")
  memberId             Int         @map("member_id")
  email                String?
  phone                String?
  inviteToken          String      @unique @map("invite_token")
  inviteTokenExpiresAt DateTime    @map("invite_token_expires_at")
  status               String      @default("pending")
  invitedById          Int         @map("invited_by")
  acceptedAt           DateTime?   @map("accepted_at")
  revokedAt            DateTime?   @map("revoked_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  association          Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  invitedBy            User        @relation("MemberInvitedBy", fields: [invitedById], references: [id])
  member               Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([memberId])
  @@map("member_invites")
}

model FinancialCategory {
  id            Int            @id @default(autoincrement())
  associationId Int            @map("association_id")
  name          String
  type          String
  amount        Decimal?       @db.Decimal(10, 2)
  frequency     String?
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  association   Association    @relation(fields: [associationId], references: [id])
  transactions  Transaction[]
  levyCampaigns LevyCampaign[]
  penaltyRules  PenaltyRule[]

  @@index([associationId, type])
  @@map("financial_categories")
}

model Transaction {
  id                  Int                         @id @default(autoincrement())
  associationId       Int                         @map("association_id")
  memberId            Int                         @map("member_id")
  categoryId          Int                         @map("category_id")
  amount              Decimal                     @db.Decimal(10, 2)
  paymentDate         DateTime?                   @map("payment_date")
  dueDate             DateTime?                   @map("due_date")
  paymentMethod       String?                     @map("payment_method")
  referenceNumber     String?                     @map("reference_number")
  status              String                      @default("pending")
  notes               String?
  createdBy           Int                         @map("created_by")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  gatewayTransactions PaymentGatewayTransaction[]
  payments            Payment[]
  association         Association                 @relation(fields: [associationId], references: [id])
  category            FinancialCategory           @relation(fields: [categoryId], references: [id])
  creator             User                        @relation("TransactionCreatedBy", fields: [createdBy], references: [id])
  member              Member                      @relation(fields: [memberId], references: [id])
  levyAssignment      LevyCampaignAssignment?
  donationRecord      DonationRecord?
  penaltyWaivers      PenaltyWaiver[]
  sourcePenalties     AppliedPenalty[]            @relation("SourceTransaction")
  asPenalty           AppliedPenalty?             @relation("PenaltyTransaction")
  // Phase 3.5: Nigerian Payment Features
  bankTransfers       BankTransfer[]
  reconciliations     PaymentReconciliation[]
  paymentProofs       PaymentProof[]

  @@index([associationId, status])
  @@map("transactions")
}

model Payment {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  transactionId Int         @map("transaction_id")
  amountPaid    Decimal     @map("amount_paid") @db.Decimal(10, 2)
  paymentDate   DateTime    @map("payment_date")
  paymentMethod String?     @map("payment_method")
  receiptNumber String?     @unique @map("receipt_number")
  confirmedBy   Int?        @map("confirmed_by")
  confirmedAt   DateTime?   @map("confirmed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id])
  confirmer     User?       @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([associationId, paymentDate])
  @@map("payments")
}

model AccountingEntry {
  id              Int         @id @default(autoincrement())
  associationId   Int         @map("association_id")
  entryType       String      @map("entry_type")
  category        String
  subcategory     String?
  amount          Decimal     @db.Decimal(10, 2)
  description     String?
  transactionDate DateTime    @map("transaction_date")
  referenceNumber String?     @map("reference_number")
  receiptFilePath String?     @map("receipt_file_path")
  createdBy       Int         @map("created_by")
  approvedBy      Int?        @map("approved_by")
  approvalStatus  String      @default("pending") @map("approval_status")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  approver        User?       @relation("AccountingEntryApprovedBy", fields: [approvedBy], references: [id])
  association     Association @relation(fields: [associationId], references: [id])
  creator         User        @relation("AccountingEntryCreatedBy", fields: [createdBy], references: [id])

  @@index([associationId, entryType])
  @@map("accounting_entries")
}

model ExportHistory {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  userId        Int         @map("user_id")
  type          String
  format        String
  filename      String
  filepath      String
  fileSize      Int         @map("file_size")
  expiresAt     DateTime    @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([associationId, type])
  @@index([expiresAt])
  @@map("export_history")
}

model Notification {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  userId        Int         @map("user_id")
  title         String
  message       String
  type          String
  isRead        Boolean     @default(false) @map("is_read")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([associationId, type])
  @@map("notifications")
}

model Settings {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  key           String
  value         String?
  description   String?
  updatedBy     Int         @map("updated_by")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  association   Association @relation(fields: [associationId], references: [id])
  updater       User        @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([associationId, key])
  @@map("settings")
}

model AuditLog {
  id            Int          @id @default(autoincrement())
  associationId Int?         @map("association_id")
  userId        Int          @map("user_id")
  action        String
  tableName     String       @map("table_name")
  recordId      Int?         @map("record_id")
  oldValues     Json?        @map("old_values")
  newValues     Json?        @map("new_values")
  createdAt     DateTime     @default(now()) @map("created_at")
  association   Association? @relation(fields: [associationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@index([associationId, tableName])
  @@map("audit_log")
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  description   String?
  priceMonthly  Decimal        @map("price_monthly") @db.Decimal(10, 2)
  priceAnnual   Decimal        @map("price_annual") @db.Decimal(10, 2)
  memberLimit   Int?           @map("member_limit")
  features      Json?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  associationId      Int                @map("association_id")
  planId             Int                @map("plan_id")
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  renewalDate        DateTime?          @map("renewal_date")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  payments           PaymentHistory[]
  association        Association        @relation(fields: [associationId], references: [id])
  plan               Plan               @relation(fields: [planId], references: [id])

  @@unique([associationId, planId], name: "associationId_planId")
  @@index([associationId, status])
  @@map("subscriptions")
}

model PaymentHistory {
  id               Int           @id @default(autoincrement())
  subscriptionId   Int           @map("subscription_id")
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("NGN")
  status           PaymentStatus @default(PENDING)
  provider         String        @default("paystack")
  reference        String?       @unique
  paidAt           DateTime?     @map("paid_at")
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  accessCode       String?       @map("access_code")
  authorizationUrl String?       @map("authorization_url")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, status])
  @@index([reference])
  @@map("payment_history")
}

model PaymentGatewayTransaction {
  id               Int          @id @default(autoincrement())
  associationId    Int          @map("association_id")
  transactionId    Int?         @map("transaction_id")
  provider         String
  reference        String       @unique
  amount           Decimal      @db.Decimal(10, 2)
  status           String       @default("pending")
  metadata         Json?
  webhookReceived  Boolean      @default(false) @map("webhook_received")
  paystackResponse Json?        @map("paystack_response")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  nombaResponse    Json?        @map("nomba_response")
  association      Association  @relation(fields: [associationId], references: [id])
  transaction      Transaction? @relation(fields: [transactionId], references: [id])

  @@index([associationId, status])
  @@index([reference])
  @@index([transactionId])
  @@map("payment_gateway_transactions")
}

model OnboardingProgress {
  id                 Int       @id @default(autoincrement())
  associationId      Int       @unique @map("association_id")
  currentStep        Int       @default(1) @map("current_step")
  completedSteps     Json      @default("[]") @map("completed_steps")
  profileCompleted   Boolean   @default(false) @map("profile_completed")
  teamInvited        Boolean   @default(false) @map("team_invited")
  membersImported    Boolean   @default(false) @map("members_imported")
  financeConfigured  Boolean   @default(false) @map("finance_configured")
  onboardingComplete Boolean   @default(false) @map("onboarding_complete")
  skippedAt          DateTime? @map("skipped_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("onboarding_progress")
}

enum AssociationTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum AssociationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_AGENT
}

// ============================================
// PHASE 4: ADVANCED FEATURES MODELS
// ============================================

// Levy Campaign Management (TASK-ADV-001, TASK-ADV-002)
model LevyCampaign {
  id              Int                      @id @default(autoincrement())
  associationId   Int                      @map("association_id")
  categoryId      Int                      @map("category_id")
  name            String
  description     String?
  targetAmount    Decimal                  @map("target_amount") @db.Decimal(12, 2)
  amountPerMember Decimal?                 @map("amount_per_member") @db.Decimal(10, 2)
  deadline        DateTime
  status          LevyCampaignStatus       @default(ACTIVE)
  createdBy       Int                      @map("created_by")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  association     Association              @relation(fields: [associationId], references: [id])
  category        FinancialCategory        @relation(fields: [categoryId], references: [id])
  assignments     LevyCampaignAssignment[]

  @@index([associationId, status])
  @@map("levy_campaigns")
}

model LevyCampaignAssignment {
  id            Int          @id @default(autoincrement())
  campaignId    Int          @map("campaign_id")
  memberId      Int          @map("member_id")
  transactionId Int?         @unique @map("transaction_id")
  amount        Decimal      @db.Decimal(10, 2)
  status        String       @default("pending") // pending, paid, partial, waived
  assignedAt    DateTime     @default(now()) @map("assigned_at")
  campaign      LevyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member        Member       @relation(fields: [memberId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([campaignId, memberId])
  @@index([campaignId, status])
  @@map("levy_campaign_assignments")
}

enum LevyCampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// Donation Allocation Tracking (TASK-ADV-004)
model DonationAllocation {
  id            Int              @id @default(autoincrement())
  associationId Int              @map("association_id")
  name          String
  description   String?
  type          String           @default("general") // general, project, emergency, other
  targetAmount  Decimal?         @map("target_amount") @db.Decimal(12, 2)
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  association   Association      @relation(fields: [associationId], references: [id])
  donations     DonationRecord[]

  @@index([associationId, type])
  @@map("donation_allocations")
}

model DonationRecord {
  id            Int                 @id @default(autoincrement())
  transactionId Int                 @unique @map("transaction_id")
  allocationId  Int?                @map("allocation_id")
  receiptNumber String              @unique @map("receipt_number")
  donorMessage  String?             @map("donor_message")
  isAnonymous   Boolean             @default(false) @map("is_anonymous")
  createdAt     DateTime            @default(now()) @map("created_at")
  transaction   Transaction         @relation(fields: [transactionId], references: [id])
  allocation    DonationAllocation? @relation(fields: [allocationId], references: [id])

  @@index([allocationId])
  @@map("donation_records")
}

// Penalty Configuration Rules (TASK-ADV-005)
model PenaltyRule {
  id               Int                @id @default(autoincrement())
  associationId    Int                @map("association_id")
  categoryId       Int?               @map("category_id") // If null, applies to all categories
  name             String
  description      String?
  triggerType      String             @default("late_payment") // late_payment, missed_meeting, custom
  gracePeriodDays  Int                @default(0) @map("grace_period_days")
  feeType          String             @default("fixed") // fixed, percentage
  feeAmount        Decimal            @map("fee_amount") @db.Decimal(10, 2)
  maxFeeAmount     Decimal?           @map("max_fee_amount") @db.Decimal(10, 2) // Cap for percentage-based
  isCompounding    Boolean            @default(false) @map("is_compounding") // Apply repeatedly
  compoundingDays  Int?               @map("compounding_days") // Days between compounds
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  association      Association        @relation(fields: [associationId], references: [id])
  category         FinancialCategory? @relation(fields: [categoryId], references: [id])
  appliedPenalties AppliedPenalty[]

  @@index([associationId, isActive])
  @@map("penalty_rules")
}

// Track applied penalties from rules (TASK-ADV-006)
model AppliedPenalty {
  id                   Int          @id @default(autoincrement())
  ruleId               Int          @map("rule_id")
  sourceTransactionId  Int          @map("source_transaction_id") // The overdue transaction
  penaltyTransactionId Int?         @unique @map("penalty_transaction_id") // The penalty transaction created
  amount               Decimal      @db.Decimal(10, 2)
  appliedAt            DateTime     @default(now()) @map("applied_at")
  rule                 PenaltyRule  @relation(fields: [ruleId], references: [id])
  sourceTransaction    Transaction  @relation("SourceTransaction", fields: [sourceTransactionId], references: [id])
  penaltyTransaction   Transaction? @relation("PenaltyTransaction", fields: [penaltyTransactionId], references: [id])

  @@index([ruleId])
  @@index([sourceTransactionId])
  @@map("applied_penalties")
}

// Penalty Waiver Management (TASK-ADV-007)
model PenaltyWaiver {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  transactionId Int         @map("transaction_id")
  waivedAmount  Decimal     @map("waived_amount") @db.Decimal(10, 2)
  reason        String
  waivedBy      Int         @map("waived_by")
  waivedAt      DateTime    @default(now()) @map("waived_at")
  association   Association @relation(fields: [associationId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([associationId])
  @@index([transactionId])
  @@map("penalty_waivers")
}

// ============================================
// PHASE 9: ACCOUNTING SYSTEM MODELS
// ============================================

// Chart of Accounts (TASK-ACC-001)
model ChartOfAccount {
  id                Int                @id @default(autoincrement())
  associationId     Int                @map("association_id")
  code              String // Account code (e.g., "1000", "2000")
  name              String
  type              AccountType // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  subType           String?            @map("sub_type") // e.g., "current_asset", "fixed_asset"
  description       String?
  parentId          Int?               @map("parent_id")
  isActive          Boolean            @default(true) @map("is_active")
  isSystemAccount   Boolean            @default(false) @map("is_system_account") // Cannot be deleted
  normalBalance     NormalBalance      @default(DEBIT) @map("normal_balance")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  association       Association        @relation(fields: [associationId], references: [id])
  parent            ChartOfAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          ChartOfAccount[]   @relation("AccountHierarchy")
  journalEntryLines JournalEntryLine[]
  budgetItems       BudgetItem[]

  @@unique([associationId, code])
  @@index([associationId, type])
  @@index([parentId])
  @@map("chart_of_accounts")
}

// Journal Entry (TASK-ACC-002)
model JournalEntry {
  id              Int                @id @default(autoincrement())
  associationId   Int                @map("association_id")
  entryNumber     String             @map("entry_number") // Auto-generated
  entryDate       DateTime           @map("entry_date")
  description     String
  reference       String? // External reference (e.g., invoice number)
  sourceType      String?            @map("source_type") // manual, auto_sync, adjustment
  sourceId        Int?               @map("source_id") // Reference to source transaction
  status          JournalEntryStatus @default(DRAFT)
  totalDebit      Decimal            @map("total_debit") @db.Decimal(12, 2)
  totalCredit     Decimal            @map("total_credit") @db.Decimal(12, 2)
  createdBy       Int                @map("created_by")
  approvedBy      Int?               @map("approved_by")
  approvedAt      DateTime?          @map("approved_at")
  rejectedBy      Int?               @map("rejected_by")
  rejectedAt      DateTime?          @map("rejected_at")
  rejectionReason String?            @map("rejection_reason")
  postedAt        DateTime?          @map("posted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  association     Association        @relation(fields: [associationId], references: [id])
  creator         User               @relation("JournalEntryCreatedBy", fields: [createdBy], references: [id])
  approver        User?              @relation("JournalEntryApprovedBy", fields: [approvedBy], references: [id])
  rejecter        User?              @relation("JournalEntryRejectedBy", fields: [rejectedBy], references: [id])
  lines           JournalEntryLine[]

  @@unique([associationId, entryNumber])
  @@index([associationId, status])
  @@index([associationId, entryDate])
  @@map("journal_entries")
}

// Journal Entry Line (Double-entry bookkeeping)
model JournalEntryLine {
  id             Int            @id @default(autoincrement())
  journalEntryId Int            @map("journal_entry_id")
  accountId      Int            @map("account_id")
  debitAmount    Decimal        @default(0) @map("debit_amount") @db.Decimal(12, 2)
  creditAmount   Decimal        @default(0) @map("credit_amount") @db.Decimal(12, 2)
  description    String?
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// Budget (TASK-ACC-006)
model Budget {
  id            Int          @id @default(autoincrement())
  associationId Int          @map("association_id")
  name          String
  description   String?
  fiscalYear    Int          @map("fiscal_year")
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  status        BudgetStatus @default(DRAFT)
  totalBudget   Decimal      @map("total_budget") @db.Decimal(12, 2)
  createdBy     Int          @map("created_by")
  approvedBy    Int?         @map("approved_by")
  approvedAt    DateTime?    @map("approved_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  association   Association  @relation(fields: [associationId], references: [id])
  creator       User         @relation("BudgetCreatedBy", fields: [createdBy], references: [id])
  approver      User?        @relation("BudgetApprovedBy", fields: [approvedBy], references: [id])
  items         BudgetItem[]

  @@unique([associationId, fiscalYear, name])
  @@index([associationId, fiscalYear])
  @@map("budgets")
}

// Budget Item (Line items for budget)
model BudgetItem {
  id            Int            @id @default(autoincrement())
  budgetId      Int            @map("budget_id")
  accountId     Int            @map("account_id")
  monthlyAmount Decimal        @map("monthly_amount") @db.Decimal(12, 2)
  q1Amount      Decimal?       @map("q1_amount") @db.Decimal(12, 2)
  q2Amount      Decimal?       @map("q2_amount") @db.Decimal(12, 2)
  q3Amount      Decimal?       @map("q3_amount") @db.Decimal(12, 2)
  q4Amount      Decimal?       @map("q4_amount") @db.Decimal(12, 2)
  annualAmount  Decimal        @map("annual_amount") @db.Decimal(12, 2)
  notes         String?
  budget        Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account       ChartOfAccount @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId])
  @@index([budgetId])
  @@map("budget_items")
}

// Accounting Period (for closing books)
model AccountingPeriod {
  id            Int          @id @default(autoincrement())
  associationId Int          @map("association_id")
  name          String // e.g., "January 2025", "Q1 2025"
  periodType    String       @map("period_type") // month, quarter, year
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  status        PeriodStatus @default(OPEN)
  closedBy      Int?         @map("closed_by")
  closedAt      DateTime?    @map("closed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  association   Association  @relation(fields: [associationId], references: [id])
  closer        User?        @relation("PeriodClosedBy", fields: [closedBy], references: [id])

  @@unique([associationId, startDate, endDate])
  @@index([associationId, status])
  @@map("accounting_periods")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  VOIDED
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  CLOSED
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

// ============================================
// PHASE 3.5: NIGERIAN PAYMENT FEATURES MODELS
// ============================================

// Association Bank Accounts (TASK-PAY-002)
model AssociationBankAccount {
  id               Int                   @id @default(autoincrement())
  associationId    Int                   @map("association_id")
  bankName         String                @map("bank_name")
  accountName      String                @map("account_name")
  accountNumber    String                @map("account_number")
  bankCode         String?               @map("bank_code") // Nigerian bank codes
  isDefault        Boolean               @default(false) @map("is_default")
  isActive         Boolean               @default(true) @map("is_active")
  description      String?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  association      Association           @relation(fields: [associationId], references: [id])
  bankTransfers    BankTransfer[]
  statementImports BankStatementImport[]

  @@unique([associationId, accountNumber])
  @@index([associationId, isActive])
  @@map("association_bank_accounts")
}

// Bank Transfer Tracking (TASK-PAY-001)
model BankTransfer {
  id                  Int                     @id @default(autoincrement())
  associationId       Int                     @map("association_id")
  transactionId       Int?                    @map("transaction_id") // Link to financial transaction
  bankAccountId       Int?                    @map("bank_account_id") // Receiving bank account
  memberId            Int?                    @map("member_id")
  senderBankName      String                  @map("sender_bank_name")
  senderAccountNumber String?                 @map("sender_account_number")
  senderAccountName   String?                 @map("sender_account_name")
  amount              Decimal                 @db.Decimal(12, 2)
  reference           String // Bank transfer reference
  transferDate        DateTime                @map("transfer_date")
  narration           String?
  status              BankTransferStatus      @default(PENDING)
  reconciliationId    Int?                    @map("reconciliation_id")
  verifiedBy          Int?                    @map("verified_by")
  verifiedAt          DateTime?               @map("verified_at")
  notes               String?
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  association         Association             @relation(fields: [associationId], references: [id])
  transaction         Transaction?            @relation(fields: [transactionId], references: [id])
  bankAccount         AssociationBankAccount? @relation(fields: [bankAccountId], references: [id])
  member              Member?                 @relation(fields: [memberId], references: [id])
  reconciliation      PaymentReconciliation?  @relation(fields: [reconciliationId], references: [id])
  paymentProofs       PaymentProof[]

  @@index([associationId, status])
  @@index([reference])
  @@index([transactionId])
  @@map("bank_transfers")
}

// Bank Statement Import (TASK-PAY-005)
model BankStatementImport {
  id               Int                    @id @default(autoincrement())
  associationId    Int                    @map("association_id")
  bankAccountId    Int                    @map("bank_account_id")
  filename         String
  importDate       DateTime               @default(now()) @map("import_date")
  startDate        DateTime?              @map("start_date")
  endDate          DateTime?              @map("end_date")
  totalEntries     Int                    @default(0) @map("total_entries")
  matchedEntries   Int                    @default(0) @map("matched_entries")
  unmatchedEntries Int                    @default(0) @map("unmatched_entries")
  status           ImportStatus           @default(PROCESSING)
  importedBy       Int                    @map("imported_by")
  createdAt        DateTime               @default(now()) @map("created_at")
  association      Association            @relation(fields: [associationId], references: [id])
  bankAccount      AssociationBankAccount @relation(fields: [bankAccountId], references: [id])
  entries          BankStatementEntry[]

  @@index([associationId, status])
  @@map("bank_statement_imports")
}

// Bank Statement Entry (individual rows from imported statement)
model BankStatementEntry {
  id                    Int                 @id @default(autoincrement())
  importId              Int                 @map("import_id")
  transactionDate       DateTime            @map("transaction_date")
  valueDate             DateTime?           @map("value_date")
  reference             String?
  description           String
  debitAmount           Decimal?            @map("debit_amount") @db.Decimal(12, 2)
  creditAmount          Decimal?            @map("credit_amount") @db.Decimal(12, 2)
  balance               Decimal?            @db.Decimal(12, 2)
  matchStatus           MatchStatus         @default(UNMATCHED) @map("match_status")
  matchedTransactionId  Int?                @map("matched_transaction_id")
  matchedBankTransferId Int?                @map("matched_bank_transfer_id")
  matchConfidence       Int?                @map("match_confidence") // 0-100 percentage
  matchedAt             DateTime?           @map("matched_at")
  matchedBy             Int?                @map("matched_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  import                BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, matchStatus])
  @@index([reference])
  @@map("bank_statement_entries")
}

// Payment Reconciliation (TASK-PAY-003)
model PaymentReconciliation {
  id               Int                     @id @default(autoincrement())
  associationId    Int                     @map("association_id")
  transactionId    Int                     @map("transaction_id")
  statementEntryId Int?                    @map("statement_entry_id")
  matchType        ReconciliationMatchType @map("match_type")
  matchedAmount    Decimal                 @map("matched_amount") @db.Decimal(12, 2)
  variance         Decimal                 @default(0) @db.Decimal(12, 2) // Difference if any
  status           ReconciliationStatus    @default(PENDING)
  reconciledBy     Int?                    @map("reconciled_by")
  reconciledAt     DateTime?               @map("reconciled_at")
  notes            String?
  createdAt        DateTime                @default(now()) @map("created_at")
  association      Association             @relation(fields: [associationId], references: [id])
  transaction      Transaction             @relation(fields: [transactionId], references: [id])
  bankTransfers    BankTransfer[]

  @@index([associationId, status])
  @@index([transactionId])
  @@map("payment_reconciliations")
}

// Payment Proof Upload (TASK-PAY-007)
model PaymentProof {
  id              Int                @id @default(autoincrement())
  associationId   Int                @map("association_id")
  transactionId   Int?               @map("transaction_id")
  bankTransferId  Int?               @map("bank_transfer_id")
  memberId        Int                @map("member_id")
  filename        String
  filepath        String
  fileSize        Int                @map("file_size")
  mimeType        String             @map("mime_type")
  status          PaymentProofStatus @default(PENDING)
  uploadedAt      DateTime           @default(now()) @map("uploaded_at")
  verifiedBy      Int?               @map("verified_by")
  verifiedAt      DateTime?          @map("verified_at")
  rejectionReason String?            @map("rejection_reason")
  notes           String?
  association     Association        @relation(fields: [associationId], references: [id])
  transaction     Transaction?       @relation(fields: [transactionId], references: [id])
  bankTransfer    BankTransfer?      @relation(fields: [bankTransferId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])

  @@index([associationId, status])
  @@index([transactionId])
  @@index([memberId])
  @@map("payment_proofs")
}

enum BankTransferStatus {
  PENDING
  VERIFIED
  MATCHED
  REJECTED
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum MatchStatus {
  UNMATCHED
  AUTO_MATCHED
  MANUAL_MATCHED
  REJECTED
}

enum ReconciliationMatchType {
  AUTO_REFERENCE // Matched by reference number
  AUTO_AMOUNT // Matched by amount
  MANUAL // Manually matched by admin
}

enum ReconciliationStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// PHASE 8.5: COOPERATIVES & LOANS MODELS
// Enterprise Feature - Thrift & Savings, Loans, Guarantors
// ============================================

// Savings Account
model SavingsAccount {
  id                  Int                  @id @default(autoincrement())
  associationId       Int                  @map("association_id")
  memberId            Int                  @map("member_id")
  accountNumber       String               @map("account_number")
  accountType         SavingsAccountType   @default(REGULAR) @map("account_type")
  balance             Decimal              @default(0) @db.Decimal(12, 2)
  targetAmount        Decimal?             @map("target_amount") @db.Decimal(12, 2)
  monthlyContribution Decimal?             @map("monthly_contribution") @db.Decimal(12, 2)
  interestRate        Decimal              @default(0) @map("interest_rate") @db.Decimal(5, 2)
  accruedInterest     Decimal              @default(0) @map("accrued_interest") @db.Decimal(12, 2)
  totalDeposits       Decimal              @default(0) @map("total_deposits") @db.Decimal(12, 2)
  totalWithdrawals    Decimal              @default(0) @map("total_withdrawals") @db.Decimal(12, 2)
  status              SavingsAccountStatus @default(ACTIVE)
  maturityDate        DateTime?            @map("maturity_date")
  openedAt            DateTime             @default(now()) @map("opened_at")
  closedAt            DateTime?            @map("closed_at")
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  association         Association          @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member              Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transactions        SavingsTransaction[]

  @@unique([associationId, accountNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@map("savings_accounts")
}

// Savings Transaction
model SavingsTransaction {
  id               Int                    @id @default(autoincrement())
  associationId    Int                    @map("association_id")
  savingsAccountId Int                    @map("savings_account_id")
  type             SavingsTransactionType
  amount           Decimal                @db.Decimal(12, 2)
  balanceAfter     Decimal                @map("balance_after") @db.Decimal(12, 2)
  paymentMethod    String?                @map("payment_method")
  reference        String?
  processedBy      Int                    @map("processed_by")
  notes            String?
  createdAt        DateTime               @default(now()) @map("created_at")
  association      Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  savingsAccount   SavingsAccount         @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  processor        User                   @relation("SavingsTransactionProcessor", fields: [processedBy], references: [id])

  @@index([savingsAccountId])
  @@index([createdAt])
  @@map("savings_transactions")
}

// Loan Product
model LoanProduct {
  id                    Int               @id @default(autoincrement())
  associationId         Int               @map("association_id")
  name                  String
  description           String?
  minAmount             Decimal           @map("min_amount") @db.Decimal(12, 2)
  maxAmount             Decimal           @map("max_amount") @db.Decimal(12, 2)
  interestRate          Decimal           @map("interest_rate") @db.Decimal(5, 2)
  interestType          InterestType      @default(REDUCING_BALANCE) @map("interest_type")
  minTenureMonths       Int               @map("min_tenure_months")
  maxTenureMonths       Int               @map("max_tenure_months")
  processingFeePercent  Decimal           @default(0) @map("processing_fee_percent") @db.Decimal(5, 2)
  processingFeeFixed    Decimal           @default(0) @map("processing_fee_fixed") @db.Decimal(10, 2)
  requiresGuarantor     Boolean           @default(true) @map("requires_guarantor")
  minGuarantors         Int               @default(1) @map("min_guarantors")
  maxLoanToSavingsRatio Decimal?          @map("max_loan_to_savings_ratio") @db.Decimal(5, 2)
  gracePeriodDays       Int               @default(0) @map("grace_period_days")
  lateFeePercent        Decimal           @default(0) @map("late_fee_percent") @db.Decimal(5, 2)
  lateFeeFixed          Decimal           @default(0) @map("late_fee_fixed") @db.Decimal(10, 2)
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  association           Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  applications          LoanApplication[]
  loans                 Loan[]

  @@unique([associationId, name])
  @@index([associationId, isActive])
  @@map("loan_products")
}

// Loan Application
model LoanApplication {
  id                    Int                   @id @default(autoincrement())
  associationId         Int                   @map("association_id")
  applicationNumber     String                @map("application_number")
  memberId              Int                   @map("member_id")
  loanProductId         Int                   @map("loan_product_id")
  amount                Decimal               @db.Decimal(12, 2)
  tenureMonths          Int                   @map("tenure_months")
  interestRate          Decimal               @map("interest_rate") @db.Decimal(5, 2)
  interestType          InterestType          @map("interest_type")
  monthlyRepayment      Decimal               @map("monthly_repayment") @db.Decimal(12, 2)
  totalRepayment        Decimal               @map("total_repayment") @db.Decimal(12, 2)
  totalInterest         Decimal               @map("total_interest") @db.Decimal(12, 2)
  processingFee         Decimal               @default(0) @map("processing_fee") @db.Decimal(10, 2)
  purpose               String
  status                LoanApplicationStatus @default(DRAFT)
  collateralDescription String?               @map("collateral_description")
  collateralValue       Decimal?              @map("collateral_value") @db.Decimal(12, 2)
  appliedAt             DateTime              @default(now()) @map("applied_at")
  reviewedBy            Int?                  @map("reviewed_by")
  reviewedAt            DateTime?             @map("reviewed_at")
  reviewComments        String?               @map("review_comments")
  approvedBy            Int?                  @map("approved_by")
  approvedAt            DateTime?             @map("approved_at")
  rejectionReason       String?               @map("rejection_reason")
  disbursedAt           DateTime?             @map("disbursed_at")
  cancelledAt           DateTime?             @map("cancelled_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  association           Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member                Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanProduct           LoanProduct           @relation(fields: [loanProductId], references: [id])
  reviewer              User?                 @relation("LoanApplicationReviewer", fields: [reviewedBy], references: [id])
  approver              User?                 @relation("LoanApplicationApprover", fields: [approvedBy], references: [id])
  guarantors            LoanGuarantor[]
  loan                  Loan?

  @@unique([associationId, applicationNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@map("loan_applications")
}

// Loan Guarantor
model LoanGuarantor {
  id                Int             @id @default(autoincrement())
  associationId     Int             @map("association_id")
  loanApplicationId Int             @map("loan_application_id")
  guarantorMemberId Int             @map("guarantor_member_id")
  guaranteeAmount   Decimal         @map("guarantee_amount") @db.Decimal(12, 2)
  status            GuarantorStatus @default(PENDING)
  acceptedAt        DateTime?       @map("accepted_at")
  declinedAt        DateTime?       @map("declined_at")
  declineReason     String?         @map("decline_reason")
  releasedAt        DateTime?       @map("released_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  association       Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  guarantorMember   Member          @relation(fields: [guarantorMemberId], references: [id], onDelete: Cascade)

  @@unique([loanApplicationId, guarantorMemberId])
  @@index([loanApplicationId])
  @@index([guarantorMemberId, status])
  @@map("loan_guarantors")
}

// Active Loan
model Loan {
  id                 Int                     @id @default(autoincrement())
  associationId      Int                     @map("association_id")
  loanNumber         String                  @map("loan_number")
  applicationId      Int                     @unique @map("application_id")
  memberId           Int                     @map("member_id")
  loanProductId      Int                     @map("loan_product_id")
  principalAmount    Decimal                 @map("principal_amount") @db.Decimal(12, 2)
  interestRate       Decimal                 @map("interest_rate") @db.Decimal(5, 2)
  interestType       InterestType            @map("interest_type")
  tenureMonths       Int                     @map("tenure_months")
  monthlyRepayment   Decimal                 @map("monthly_repayment") @db.Decimal(12, 2)
  totalRepayment     Decimal                 @map("total_repayment") @db.Decimal(12, 2)
  totalInterest      Decimal                 @map("total_interest") @db.Decimal(12, 2)
  processingFee      Decimal                 @default(0) @map("processing_fee") @db.Decimal(10, 2)
  amountDisbursed    Decimal                 @map("amount_disbursed") @db.Decimal(12, 2)
  totalPaid          Decimal                 @default(0) @map("total_paid") @db.Decimal(12, 2)
  principalPaid      Decimal                 @default(0) @map("principal_paid") @db.Decimal(12, 2)
  interestPaid       Decimal                 @default(0) @map("interest_paid") @db.Decimal(12, 2)
  outstandingBalance Decimal                 @map("outstanding_balance") @db.Decimal(12, 2)
  nextPaymentDate    DateTime?               @map("next_payment_date") @db.Date
  nextPaymentAmount  Decimal?                @map("next_payment_amount") @db.Decimal(12, 2)
  status             LoanStatus              @default(ACTIVE)
  disbursedAt        DateTime                @map("disbursed_at")
  maturityDate       DateTime                @map("maturity_date") @db.Date
  closedAt           DateTime?               @map("closed_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  association        Association             @relation(fields: [associationId], references: [id], onDelete: Cascade)
  application        LoanApplication         @relation(fields: [applicationId], references: [id])
  member             Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanProduct        LoanProduct             @relation(fields: [loanProductId], references: [id])
  repaymentSchedule  LoanRepaymentSchedule[]
  repayments         LoanRepayment[]

  @@unique([associationId, loanNumber])
  @@index([associationId, status])
  @@index([memberId])
  @@index([nextPaymentDate])
  @@map("loans")
}

// Loan Repayment Schedule
model LoanRepaymentSchedule {
  id                Int             @id @default(autoincrement())
  loanId            Int             @map("loan_id")
  installmentNumber Int             @map("installment_number")
  dueDate           DateTime        @map("due_date") @db.Date
  principalDue      Decimal         @map("principal_due") @db.Decimal(12, 2)
  interestDue       Decimal         @map("interest_due") @db.Decimal(12, 2)
  totalDue          Decimal         @map("total_due") @db.Decimal(12, 2)
  principalPaid     Decimal         @default(0) @map("principal_paid") @db.Decimal(12, 2)
  interestPaid      Decimal         @default(0) @map("interest_paid") @db.Decimal(12, 2)
  totalPaid         Decimal         @default(0) @map("total_paid") @db.Decimal(12, 2)
  lateFee           Decimal         @default(0) @map("late_fee") @db.Decimal(10, 2)
  status            RepaymentStatus @default(PENDING)
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  loan              Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  repayments        LoanRepayment[]

  @@unique([loanId, installmentNumber])
  @@index([loanId])
  @@index([dueDate, status])
  @@map("loan_repayment_schedule")
}

// Loan Repayment
model LoanRepayment {
  id               Int                    @id @default(autoincrement())
  associationId    Int                    @map("association_id")
  loanId           Int                    @map("loan_id")
  scheduleItemId   Int?                   @map("schedule_item_id")
  amount           Decimal                @db.Decimal(12, 2)
  principalPortion Decimal                @map("principal_portion") @db.Decimal(12, 2)
  interestPortion  Decimal                @map("interest_portion") @db.Decimal(12, 2)
  lateFee          Decimal                @default(0) @map("late_fee") @db.Decimal(10, 2)
  paymentMethod    String                 @map("payment_method")
  reference        String?
  processedBy      Int                    @map("processed_by")
  notes            String?
  paidAt           DateTime               @default(now()) @map("paid_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  association      Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  loan             Loan                   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  scheduleItem     LoanRepaymentSchedule? @relation(fields: [scheduleItemId], references: [id])
  processor        User                   @relation("LoanRepaymentProcessor", fields: [processedBy], references: [id])

  @@index([loanId])
  @@index([paidAt])
  @@map("loan_repayments")
}

