generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Association {
  id                         Int                         @id @default(autoincrement())
  name                       String
  slug                       String                      @unique
  subdomain                  String                      @unique
  tier                       AssociationTier             @default(STARTER)
  status                     AssociationStatus           @default(ACTIVE)
  logo                       String?
  primaryColor               String?                     @map("primary_color")
  subscriptionExpiresAt      DateTime?                   @map("subscription_expires_at")
  // G79: tracks whether this association has EVER started a trial, independent of which
  // Subscription row/plan it was against — initializePayment/startTrial's own "does a
  // subscription already exist" check only looked at currently-active statuses, so an
  // expired/cancelled association could get a second free trial just by picking a new plan.
  hasEverTrialed             Boolean                     @default(false) @map("has_ever_trialed")
  // Phase 19: Platform Admin - Soft Delete
  deletedAt                  DateTime?                   @map("deleted_at")
  deletedBy                  Int?                        @map("deleted_by")
  deletionReason             String?                     @map("deletion_reason")
  // Phase 19: Platform Admin - Security Settings
  force2FA                   Boolean                     @default(false) @map("force_2fa")
  passwordPolicyLevel        String                      @default("standard") @map("password_policy_level")
  sessionTimeoutMinutes      Int                         @default(480) @map("session_timeout_minutes")
  ipRestrictions             String[]                    @default([]) @map("ip_restrictions")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  accounting                 AccountingEntry[]
  auditLogs                  AuditLog[]
  securityEventLogs          SecurityEventLog[]
  exports                    ExportHistory[]
  categories                 FinancialCategory[]
  memberInvites              MemberInvite[]
  members                    Member[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  paymentGatewayTransactions PaymentGatewayTransaction[]
  payments                   Payment[]
  settings                   Settings[]
  subscriptions              Subscription[]
  transactions               Transaction[]
  users                      User[]
  levyCampaigns              LevyCampaign[]
  penaltyRules               PenaltyRule[]
  penaltyWaivers             PenaltyWaiver[]
  donationAllocations        DonationAllocation[]
  // Phase 9: Accounting System
  chartOfAccounts            ChartOfAccount[]
  journalEntries             JournalEntry[]
  budgets                    Budget[]
  accountingPeriods          AccountingPeriod[]
  // Phase 3.5: Nigerian Payment Features
  bankAccounts               AssociationBankAccount[]
  bankTransfers              BankTransfer[]
  bankStatementImports       BankStatementImport[]
  paymentReconciliations     PaymentReconciliation[]
  paymentProofs              PaymentProof[]
  // Phase 8.5: Cooperatives & Loans
  savingsAccounts            SavingsAccount[]
  savingsDepositRequests     SavingsDepositRequest[]
  loanRepaymentRequests      LoanRepaymentRequest[]
  savingsLiens               SavingsLien[]
  cashCollections             CashCollection[]
  cashReceipts                CashReceipt[]
  cashLodgments               CashLodgment[]
  savingsTransactions        SavingsTransaction[]
  loanProducts               LoanProduct[]
  loanApplications           LoanApplication[]
  loanGuarantors             LoanGuarantor[]
  loans                      Loan[]
  loanRepayments             LoanRepayment[]
  // Member Financial Ledger
  memberLedgerEntries        MemberFinancialLedger[]
  // Phase 12.5: Meetings & Attendance
  meetings                   Meeting[]
  // Phase 5.5: Welfare & Social Funds
  welfareFunds               WelfareFund[]
  welfareContributions       WelfareContribution[]
  welfarePayoutRequests      WelfarePayoutRequest[]
  // Phase 6.5: SMS & Bulk Communication
  smsMessages                SMSMessage[]
  smsCampaigns               SMSCampaign[]
  smsTemplates               SMSTemplate[]
  smsCreditBalance           SMSCreditBalance?
  smsCreditsPurchases        SMSCreditsPurchase[]
  // Phase 17: AI Integration
  aiAuditLogs                AIAuditLog[]
  documentEmbeddings         DocumentEmbedding[]
  // Phase 4.5: Voting & Elections
  elections                  Election[]
  polls                      Poll[]

  // RBAC System Relations
  roles     Role[]
  userRoles UserRole[]

  // Phase 19: Platform Admin - Module & Feature Overrides
  tenantModules    TenantModule[]
  tenantFeatures   TenantFeature[]
  billingOverrides BillingOverride[]

  // Phase 21: Help & Support
  helpArticles   HelpArticle[]
  faqItems       FAQItem[]
  supportTickets SupportTicket[]
  // Phase 14: Webhooks Management
  webhookEventLogs WebhookEventLog[]

  // Phase 22: Hybrid Super Admin Architecture
  isPlatformAssociation Boolean @default(false) @map("is_platform_association")

  // A1.3 — Impersonation handoff back-relation
  impersonationHandoffs ImpersonationHandoff[]

  @@index([deletedAt])
  @@index([isPlatformAssociation])
  @@map("associations")
}

model User {
  id                            Int                    @id @default(autoincrement())
  associationId                 Int?                   @map("association_id")
  email                         String
  passwordHash                  String                 @map("password_hash")
  role                          String                 @default("member")
  platformRole                  PlatformRole?          @map("platform_role")
  isActive                      Boolean                @default(false) @map("is_active")
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")
  emailVerified                 Boolean                @default(false) @map("email_verified")
  passwordResetExpiresAt        DateTime?              @map("password_reset_expires_at")
  passwordResetToken            String?                @map("password_reset_token")
  verificationCode              String?                @map("verification_code")
  verificationExpiresAt         DateTime?              @map("verification_expires_at")
  approvedAccountingEntries     AccountingEntry[]      @relation("AccountingEntryApprovedBy")
  createdAccountingEntries      AccountingEntry[]      @relation("AccountingEntryCreatedBy")
  auditLogs                     AuditLog[]
  exports                       ExportHistory[]
  sentMemberInvites             MemberInvite[]         @relation("MemberInvitedBy")
  member                        Member?
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  confirmedPayments             Payment[]              @relation("PaymentConfirmedBy")
  settingsUpdates               Settings[]             @relation("SettingsUpdatedBy")
  createdTransactions           Transaction[]          @relation("TransactionCreatedBy")
  approvedUsers                 UserApproval[]         @relation("UserApprovedBy")
  userApproval                  UserApproval?
  association                   Association?           @relation(fields: [associationId], references: [id])
  // Phase 9: Accounting System
  createdJournalEntries         JournalEntry[]         @relation("JournalEntryCreatedBy")
  approvedJournalEntries        JournalEntry[]         @relation("JournalEntryApprovedBy")
  rejectedJournalEntries        JournalEntry[]         @relation("JournalEntryRejectedBy")
  createdBudgets                Budget[]               @relation("BudgetCreatedBy")
  approvedBudgets               Budget[]               @relation("BudgetApprovedBy")
  closedPeriods                 AccountingPeriod[]     @relation("PeriodClosedBy")
  // Phase 8.5: Cooperatives & Loans
  processedSavingsTransactions  SavingsTransaction[]   @relation("SavingsTransactionProcessor")
  reviewedLoanApplications      LoanApplication[]      @relation("LoanApplicationReviewer")
  approvedLoanApplications      LoanApplication[]      @relation("LoanApplicationApprover")
  processedLoanRepayments       LoanRepayment[]        @relation("LoanRepaymentProcessor")
  // Phase 12.5: Meetings & Attendance
  createdMeetings               Meeting[]              @relation("MeetingCreatedBy")
  cancelledMeetings             Meeting[]              @relation("MeetingCancelledBy")
  markedAttendances             MeetingAttendance[]    @relation("AttendanceMarkedBy")
  recordedMinutes               MeetingMinutes[]       @relation("MinutesRecordedBy")
  approvedMinutes               MeetingMinutes[]       @relation("MinutesApprovedBy")
  // Phase 5.5: Welfare & Social Funds
  createdWelfareFunds           WelfareFund[]          @relation("WelfareFundCreator")
  confirmedWelfareContributions WelfareContribution[]  @relation("WelfareContributionConfirmer")
  reviewedWelfarePayouts        WelfarePayoutRequest[] @relation("WelfarePayoutReviewer")
  approvedWelfarePayouts        WelfarePayoutRequest[] @relation("WelfarePayoutApprover")
  disbursedWelfarePayouts       WelfarePayoutRequest[] @relation("WelfarePayoutDisburser")
  // Phase 17: AI Integration
  aiAuditLogs                   AIAuditLog[]
  // Phase 4.5: Voting & Elections
  createdElections              Election[]             @relation("ElectionCreatedBy")
  publishedElections            Election[]             @relation("ElectionPublishedBy")
  cancelledElections            Election[]             @relation("ElectionCancelledBy")
  nominatedCandidates           Candidate[]            @relation("CandidateNominatedBy")
  approvedCandidates            Candidate[]            @relation("CandidateApprovedBy")
  createdPolls                  Poll[]                 @relation("PollCreatedBy")

  // RBAC System Relations
  userRoles         UserRole[]
  assignedUserRoles UserRole[] @relation("UserRoleAssigner")

  // Phase 21: Help & Support
  createdTickets    SupportTicket[]    @relation("TicketCreator")
  assignedTickets   SupportTicket[]    @relation("TicketAssignee")
  ticketResponses   TicketResponse[]
  ticketAttachments TicketAttachment[]

  // Phase 6.5: SMS Credits
  smsCreditsPurchases SMSCreditsPurchase[]

  // Blog & Documentation relations
  blogPosts       BlogPost[]    @relation("BlogPostAuthor")
  blogComments    BlogComment[] @relation("BlogCommentAuthor")
  docPages        DocPage[]     @relation("DocPageAuthor")
  docFeedback     DocFeedback[]  @relation("DocFeedbackUser")

  // A1.3 — Impersonation handoff
  impersonationHandoffs ImpersonationHandoff[]

  // A2.12 — Platform admin invites
  platformAdminInvitesSent PlatformAdminInvite[] @relation("PlatformAdminInvitedBy")

  // A1.4 — TOTP 2FA for platform users (stored only on platform-role users)
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  lastLoginAt     DateTime? @map("last_login_at")
  totpSecretEnc   String?   @map("totp_secret_enc")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  recoveryCodes   RecoveryCode[]
  loginChallenges AdminLoginChallenge[]

  // F0.2 — Mobile push notifications
  deviceTokens DeviceToken[]

  // F0.3 — Mobile refresh-token sessions
  refreshTokens RefreshToken[]

  @@unique([associationId, email])
  @@index([associationId, email])
  @@map("users")
}

model UserApproval {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  approvalStatus  String    @default("pending") @map("approval_status")
  approvedById    Int?      @map("approved_by")
  approvalDate    DateTime? @map("approval_date")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  approvedBy      User?     @relation("UserApprovedBy", fields: [approvedById], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_approvals")
}

model Member {
  id                           Int                      @id @default(autoincrement())
  associationId                Int                      @map("association_id")
  userId                       Int?                     @unique @map("user_id")
  memberId                     String                   @map("member_id")
  firstName                    String                   @map("first_name")
  lastName                     String                   @map("last_name")
  email                        String?
  phone                        String?
  address                      String?
  joinDate                     DateTime?                @map("join_date")
  status                       String                   @default("active")
  category                     String                   @default("regular")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  city                         String?
  country                      String?
  dateOfBirth                  DateTime?                @map("date_of_birth")
  emergencyContactName         String?                  @map("emergency_contact_name")
  emergencyContactPhone        String?                  @map("emergency_contact_phone")
  emergencyContactRelationship String?                  @map("emergency_contact_relationship")
  gender                       String                   @default("male")
  notes                        String?
  occupation                   String?
  state                        String?
  loginStatus                  String                   @default("no_login") @map("login_status")
  invites                      MemberInvite[]
  association                  Association              @relation(fields: [associationId], references: [id])
  user                         User?                    @relation(fields: [userId], references: [id])
  transactions                 Transaction[]
  levyAssignments              LevyCampaignAssignment[]
  // Phase 3.5: Nigerian Payment Features
  bankTransfers                BankTransfer[]
  paymentProofs                PaymentProof[]
  // Phase 8.5: Cooperatives & Loans
  savingsAccounts              SavingsAccount[]
  savingsDepositRequests       SavingsDepositRequest[]
  loanRepaymentRequests        LoanRepaymentRequest[]
  savingsLiens                 SavingsLien[]
  cashReceipts                CashReceipt[]
  loanApplications             LoanApplication[]
  guaranteedLoans              LoanGuarantor[]
  loans                        Loan[]
  // Member Financial Ledger
  ledgerEntries                MemberFinancialLedger[]
  // Phase 12.5: Meetings & Attendance
  meetingAttendances           MeetingAttendance[]
  // Phase 5.5: Welfare & Social Funds
  welfareContributions         WelfareContribution[]
  welfarePayoutRequests        WelfarePayoutRequest[]
  // Phase 4.5: Voting & Elections
  candidacies                  Candidate[]
  eligibilityExceptions        ElectionEligibilityException[]
  votes                        Vote[]
  pollResponses                PollResponse[]

  @@unique([associationId, memberId])
  // Phase 12: Performance indexes
  @@index([associationId, status])
  @@index([associationId, category])
  @@index([associationId, createdAt])
  @@index([loginStatus])
  @@index([email])
  @@map("members")
}

model MemberInvite {
  id                   Int         @id @default(autoincrement())
  associationId        Int         @map("association_id")
  memberId             Int         @map("member_id")
  email                String?
  phone                String?
  inviteToken          String      @unique @map("invite_token")
  inviteTokenExpiresAt DateTime    @map("invite_token_expires_at")
  status               String      @default("pending")
  invitedById          Int         @map("invited_by")
  acceptedAt           DateTime?   @map("accepted_at")
  revokedAt            DateTime?   @map("revoked_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  association          Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  invitedBy            User        @relation("MemberInvitedBy", fields: [invitedById], references: [id])
  member               Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, status])
  @@index([memberId])
  @@map("member_invites")
}

model FinancialCategory {
  id            Int            @id @default(autoincrement())
  associationId Int            @map("association_id")
  name          String
  type          String
  amount        Decimal?       @db.Decimal(10, 2)
  frequency     String?
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  association   Association    @relation(fields: [associationId], references: [id])
  transactions  Transaction[]
  levyCampaigns LevyCampaign[]
  penaltyRules  PenaltyRule[]

  @@index([associationId, type])
  @@map("financial_categories")
}

model Transaction {
  id                  Int                         @id @default(autoincrement())
  associationId       Int                         @map("association_id")
  memberId            Int                         @map("member_id")
  categoryId          Int                         @map("category_id")
  amount              Decimal                     @db.Decimal(10, 2)
  paymentDate         DateTime?                   @map("payment_date")
  dueDate             DateTime?                   @map("due_date")
  paymentMethod       String?                     @map("payment_method")
  referenceNumber     String?                     @map("reference_number")
  status              String                      @default("pending")
  notes               String?
  createdBy           Int                         @map("created_by")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  
  // R3.4/G43: tracks when the last automated payment reminder was sent, so
  // the daily job doesn't re-send the same reminder more than once per day.
  lastReminderSentAt  DateTime?                   @map("last_reminder_sent_at")

  // Edit and void tracking
  isVoided            Boolean                     @default(false) @map("is_voided")
  voidReason          String?                     @map("void_reason")
  voidedAt            DateTime?                   @map("voided_at")
  voidedBy            Int?                        @map("voided_by")
  replacedBy          Int?                        @map("replaced_by")
  replaces            Int?                        @map("replaces")
  editHistory         Json?                       @map("edit_history")
  lastEditedBy        Int?                        @map("last_edited_by")
  lastEditedAt        DateTime?                   @map("last_edited_at")
  
  // Accounting integration sync tracking
  accountingSynced    Boolean                     @default(false) @map("accounting_synced")
  accountingEntryId   Int?                        @map("accounting_entry_id")
  
  gatewayTransactions PaymentGatewayTransaction[]
  payments            Payment[]
  association         Association                 @relation(fields: [associationId], references: [id])
  category            FinancialCategory           @relation(fields: [categoryId], references: [id])
  creator             User                        @relation("TransactionCreatedBy", fields: [createdBy], references: [id])
  member              Member                      @relation(fields: [memberId], references: [id])
  levyAssignment      LevyCampaignAssignment?
  donationRecord      DonationRecord?
  penaltyWaivers      PenaltyWaiver[]
  sourcePenalties     AppliedPenalty[]            @relation("SourceTransaction")
  asPenalty           AppliedPenalty?             @relation("PenaltyTransaction")
  // Phase 3.5: Nigerian Payment Features
  bankTransfers       BankTransfer[]
  reconciliations     PaymentReconciliation[]
  paymentProofs       PaymentProof[]

  // Phase 12: Performance indexes
  @@index([associationId, status])
  @@index([associationId, memberId])
  @@index([associationId, categoryId])
  @@index([associationId, createdAt])
  @@index([associationId, dueDate])
  @@index([memberId, status])
  @@map("transactions")
}

model Payment {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  transactionId Int         @map("transaction_id")
  amountPaid    Decimal     @map("amount_paid") @db.Decimal(10, 2)
  paymentDate   DateTime    @map("payment_date")
  paymentMethod String?     @map("payment_method")
  receiptNumber String?     @unique @map("receipt_number")
  confirmedBy   Int?        @map("confirmed_by")
  confirmedAt   DateTime?   @map("confirmed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  
  // Accounting integration sync tracking
  accountingSynced    Boolean   @default(false) @map("accounting_synced")
  accountingEntryId   Int?      @map("accounting_entry_id")
  
  association   Association @relation(fields: [associationId], references: [id])
  confirmer     User?       @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // Phase 12: Performance indexes
  @@index([associationId, paymentDate])
  @@index([transactionId])
  @@index([associationId, createdAt])
  @@map("payments")
}

model AccountingEntry {
  id              Int         @id @default(autoincrement())
  associationId   Int         @map("association_id")
  entryType       String      @map("entry_type")
  category        String
  subcategory     String?
  amount          Decimal     @db.Decimal(10, 2)
  description     String?
  transactionDate DateTime    @map("transaction_date")
  referenceNumber String?     @map("reference_number")
  receiptFilePath String?     @map("receipt_file_path")
  createdBy       Int         @map("created_by")
  approvedBy      Int?        @map("approved_by")
  approvalStatus  String      @default("pending") @map("approval_status")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  approver        User?       @relation("AccountingEntryApprovedBy", fields: [approvedBy], references: [id])
  association     Association @relation(fields: [associationId], references: [id])
  creator         User        @relation("AccountingEntryCreatedBy", fields: [createdBy], references: [id])

  @@index([associationId, entryType])
  @@map("accounting_entries")
}

model ExportHistory {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  userId        Int         @map("user_id")
  type          String
  format        String
  filename      String
  filepath      String
  fileSize      Int         @map("file_size")
  expiresAt     DateTime    @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([associationId, type])
  @@index([expiresAt])
  @@map("export_history")
}

model Notification {
  id            Int         @id @default(autoincrement())
  associationId Int         @map("association_id")
  userId        Int         @map("user_id")
  title         String
  message       String
  type          String
  entityId      Int?        @map("entity_id") // F0.2: the entity (payment, meeting, election...) this notification is about, for push deep-link routing. Nullable — existing rows and writers that don't pass one are unaffected.
  pushType      String?     @map("push_type") // Deep-link type (same vocabulary as the push `data.type`), so the inbox can route a tap to the right screen. Null on older rows.
  isRead        Boolean     @default(false) @map("is_read")
  createdAt     DateTime    @default(now()) @map("created_at")
  association   Association @relation(fields: [associationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([associationId, type])
  @@map("notifications")
}

// R3.6/G14/G42: replaces the in-memory Map that previously backed
// notification preferences — lost on every restart, and nothing ever read
// it to gate a real send. One row per user per association.
model NotificationPreference {
  id                    Int         @id @default(autoincrement())
  associationId         Int         @map("association_id")
  userId                Int         @map("user_id")
  emailEnabled          Boolean     @default(true) @map("email_enabled")
  smsEnabled            Boolean     @default(false) @map("sms_enabled")
  inAppEnabled          Boolean     @default(true) @map("in_app_enabled")
  pushEnabled           Boolean     @default(true) @map("push_enabled") // F0.2: master toggle for mobile push, independent of the in-app feed. Per-kind push granularity (like email/SMS/inApp have) can be added later if a mobile settings screen needs it — not required for v1.
  paymentDueEmail       Boolean     @default(true) @map("payment_due_email")
  paymentDueSMS         Boolean     @default(false) @map("payment_due_sms")
  paymentDueInApp       Boolean     @default(true) @map("payment_due_in_app")
  paymentReceivedEmail  Boolean     @default(true) @map("payment_received_email")
  paymentReceivedSMS    Boolean     @default(false) @map("payment_received_sms")
  paymentReceivedInApp  Boolean     @default(true) @map("payment_received_in_app")
  systemEmail           Boolean     @default(true) @map("system_email")
  systemSMS             Boolean     @default(false) @map("system_sms")
  systemInApp           Boolean     @default(true) @map("system_in_app")
  approvalEmail         Boolean     @default(true) @map("approval_email")
  approvalSMS           Boolean     @default(false) @map("approval_sms")
  approvalInApp         Boolean     @default(true) @map("approval_in_app")
  announcementEmail     Boolean     @default(true) @map("announcement_email")
  announcementSMS       Boolean     @default(false) @map("announcement_sms")
  announcementInApp     Boolean     @default(true) @map("announcement_in_app")
  quietHoursEnabled     Boolean     @default(false) @map("quiet_hours_enabled")
  quietHoursStart       String      @default("22:00") @map("quiet_hours_start")
  quietHoursEnd         String      @default("08:00") @map("quiet_hours_end")
  quietHoursTimezone    String      @default("UTC") @map("quiet_hours_timezone")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  association           Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([associationId, userId])
  @@map("notification_preferences")
}

// F0.2 — a registered Expo push token for one install of the mobile app.
// associationId is nullable: a device can be registered before the user has
// selected/switched a tenant in some flows, and one physical device token is
// re-used/reassigned across associations if the same phone signs into more
// than one (register upserts by expoPushToken, not by user).
model DeviceToken {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  associationId Int?      @map("association_id")
  expoPushToken String    @unique @map("expo_push_token")
  platform      String // 'ios' | 'android'
  deviceName    String?   @map("device_name")
  appVersion    String?   @map("app_version")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  disabledAt    DateTime? @map("disabled_at") // set by the receipts job on a DeviceNotRegistered receipt
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, associationId])
  @@map("device_tokens")
}

// F0.3 — one row per issued mobile refresh token. `tokenHash` is the sha256
// of the opaque token the client holds (the plaintext is never stored).
// `familyId` groups every token descended from one login via rotation; a
// reuse of a revoked token revokes the whole family (theft detection).
// `replacedById` is informational only (no enforced FK, matching
// architecture.md's own schema exactly) — which row a rotation replaced.
model RefreshToken {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  associationId Int?      @map("association_id")
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id")
  deviceName    String?   @map("device_name")
  platform      String?
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
