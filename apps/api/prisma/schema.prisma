// PHASE 5.5: WELFARE & SOCIAL FUNDS MODELS
// Nigerian/African Market Feature
// Bereavement, Medical, Education, Emergency Support
// ============================================

// Welfare Fund
model WelfareFund {
  id                      Int                    @id @default(autoincrement())
  associationId           Int                    @map("association_id")
  name                    String
  description             String?
  fundType                WelfareFundType        @default(GENERAL) @map("fund_type")
  targetBalance           Decimal?               @map("target_balance") @db.Decimal(12, 2)
  currentBalance          Decimal                @default(0) @map("current_balance") @db.Decimal(12, 2)
  monthlyContribution     Decimal?               @map("monthly_contribution") @db.Decimal(12, 2)
  isContributionMandatory Boolean                @default(false) @map("is_contribution_mandatory")
  minContribution         Decimal?               @map("min_contribution") @db.Decimal(12, 2)
  maxPayout               Decimal?               @map("max_payout") @db.Decimal(12, 2)
  waitingPeriodDays       Int                    @default(0) @map("waiting_period_days")
  minContributionMonths   Int                    @default(0) @map("min_contribution_months")
  status                  WelfareFundStatus      @default(ACTIVE)
  createdBy               Int                    @map("created_by")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  association             Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
