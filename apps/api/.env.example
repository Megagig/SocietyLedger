# Database
DATABASE_URL="postgresql://user:password@localhost:5432/societyledger"

# JWT
JWT_SECRET="your-jwt-secret-key-here"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Paystack Configuration
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"

# Nomba Configuration
# Get from Nomba Dashboard → Settings → API Keys
NOMBA_API_KEY="your-client-id"              # "Client ID" field in dashboard
NOMBA_API_SECRET="your-private-key"         # "Private Key" field (click to reveal)
NOMBA_ACCOUNT_ID="your-account-id"          # "Account ID" field

# Set in Nomba Dashboard → Settings → Webhooks
NOMBA_WEBHOOK_SECRET="your-signature-key"   # "Signature Key" you configure in webhook settings

# Nomba API URL - Same URL for sandbox and production (credentials determine environment)
NOMBA_BASE_URL="https://api.nomba.com/v1"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"

# Redis (Optional - for caching)
REDIS_URL="redis://localhost:6379"

# MinIO Object Storage (replaces local disk uploads)
# In Dokploy: MINIO_ENDPOINT uses the internal Docker service name, e.g. http://minio:9000
# The console (admin UI) is on port 9001
MINIO_ENDPOINT="http://minio:9000"
# The address phones and browsers can open for receipts and attachments (signed links point at it). REQUIRED in production whenever
# MINIO_ENDPOINT is internal — e.g. "https://files.societyledger.com.ng". Leave unset locally: in development, with MINIO_ENDPOINT on
# localhost, links automatically use the address the app reached the API on (your PC's LAN IP), so it keeps working when the IP changes.
# MINIO_PUBLIC_ENDPOINT="https://files.societyledger.com.ng"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="societyledger"

# AI features (support "Suggest a reply", help assistant). Without a key those features show a "not configured" message.
# OPENROUTER_MODEL is optional; the default "openrouter/auto" lets OpenRouter pick an available model. Pin one from openrouter.ai/models if you prefer.
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL=""
