# API Environment Variables
NODE_ENV=development
PORT=4000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database (Neon)
# Use pooled connection for app runtime
# Example pooled URL (notice the -pooler host and sslmode):
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/societyledger?schema=public"

# Use direct connection for Prisma migrations (no -pooler)
# Example direct URL:
# DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@localhost:5432/societyledger?schema=public"

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Redis (optional for now)
REDIS_URL=redis://localhost:6379

# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=SocietyLedger <noreply@societyledger.com>
EMAIL_REPLY_TO=support@societyledger.com

# Application URL (for email links)
APP_URL=http://localhost:3000

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
