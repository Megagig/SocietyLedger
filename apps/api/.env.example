# Database
DATABASE_URL="postgresql://user:password@localhost:5432/societyledger"

# JWT
JWT_SECRET="your-jwt-secret-key-here"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Paystack Configuration
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"

# Nomba Configuration
# Get from Nomba Dashboard → Settings → API Keys
NOMBA_API_KEY="your-client-id"              # "Client ID" field in dashboard
NOMBA_API_SECRET="your-private-key"         # "Private Key" field (click to reveal)
NOMBA_ACCOUNT_ID="your-account-id"          # "Account ID" field

# Set in Nomba Dashboard → Settings → Webhooks
NOMBA_WEBHOOK_SECRET="your-signature-key"   # "Signature Key" you configure in webhook settings

# Nomba API URL - Same URL for sandbox and production (credentials determine environment)
NOMBA_BASE_URL="https://api.nomba.com/v1"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"

# Redis (Optional - for caching)
REDIS_URL="redis://localhost:6379"
