// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  role            String   @default("member")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  member          Member?
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
  confirmedPayments   Payment[]     @relation("PaymentConfirmedBy")
  createdAccountingEntries AccountingEntry[] @relation("AccountingEntryCreatedBy")
  approvedAccountingEntries AccountingEntry[] @relation("AccountingEntryApprovedBy")
  userApproval    UserApproval?
  approvedUsers   UserApproval[] @relation("UserApprovedBy")
  notifications   Notification[]
  auditLogs       AuditLog[]
  exports         ExportHistory[]
  settingsUpdates Settings[] @relation("SettingsUpdatedBy")

  @@map("users")
}

model UserApproval {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  approvalStatus  String   @default("pending") @map("approval_status") // 'pending', 'approved', 'rejected'
  approvedById    Int?     @map("approved_by")
  approvalDate    DateTime? @map("approval_date")
  rejectionReason String?  @map("rejection_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy   User? @relation("UserApprovedBy", fields: [approvedById], references: [id])

  @@map("user_approvals")
}

model Member {
  id          Int      @id @default(autoincrement())
  userId      Int?     @unique @map("user_id")
  memberId    String   @unique @map("member_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?
  phone       String?
  address     String?
  joinDate    DateTime? @map("join_date")
  status      String   @default("active")
  category    String   @default("regular")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user         User?         @relation(fields: [userId], references: [id])
  transactions Transaction[]
  exports      ExportHistory[]

  @@map("members")
}

model FinancialCategory {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   // 'due', 'levy', 'donation', 'penalty'
  amount      Decimal? @db.Decimal(10, 2)
  frequency   String?  // 'monthly', 'quarterly', 'annual', 'one-time'
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  transactions Transaction[]

  @@map("financial_categories")
}

model Transaction {
  id              Int      @id @default(autoincrement())
  memberId        Int      @map("member_id")
  categoryId      Int      @map("category_id")
  amount          Decimal  @db.Decimal(10, 2)
  paymentDate     DateTime? @map("payment_date")
  dueDate         DateTime? @map("due_date")
  paymentMethod   String?  @map("payment_method")
  referenceNumber String?  @map("reference_number")
  status          String   @default("pending") // 'paid', 'pending', 'overdue', 'waived'
  notes           String?
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  member   Member            @relation(fields: [memberId], references: [id])
  category FinancialCategory @relation(fields: [categoryId], references: [id])
  creator  User              @relation("TransactionCreatedBy", fields: [createdBy], references: [id])
  payments Payment[]

  @@map("transactions")
}

model Payment {
  id             Int      @id @default(autoincrement())
  transactionId  Int      @map("transaction_id")
  amountPaid     Decimal  @db.Decimal(10, 2) @map("amount_paid")
  paymentDate    DateTime @map("payment_date")
  paymentMethod  String?  @map("payment_method")
  receiptNumber  String?  @unique @map("receipt_number")
  confirmedBy    Int?     @map("confirmed_by")
  confirmedAt    DateTime? @map("confirmed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id])
  confirmer   User?       @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id])

  @@map("payments")
}

model AccountingEntry {
  id              Int      @id @default(autoincrement())
  entryType       String   @map("entry_type") // 'income', 'expense'
  category        String
  subcategory     String?
  amount          Decimal  @db.Decimal(10, 2)
  description     String?
  transactionDate DateTime @map("transaction_date")
  referenceNumber String?  @map("reference_number")
  receiptFilePath String?  @map("receipt_file_path")
  createdBy       Int      @map("created_by")
  approvedBy      Int?     @map("approved_by")
  approvalStatus  String   @default("pending") @map("approval_status") // 'pending', 'approved', 'rejected'
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  creator  User @relation("AccountingEntryCreatedBy", fields: [createdBy], references: [id])
  approver User? @relation("AccountingEntryApprovedBy", fields: [approvedBy], references: [id])

  @@map("accounting_entries")
}

model ExportHistory {
  id             Int      @id @default(autoincrement())
  exportType     String   @map("export_type") // 'financial_pdf', 'financial_excel', 'member_excel', 'individual_member'
  exportFormat   String   @map("export_format") // 'pdf', 'excel'
  dateRangeStart DateTime? @map("date_range_start")
  dateRangeEnd   DateTime? @map("date_range_end")
  exportPeriod   String?  @map("export_period") // 'weekly', 'monthly', 'quarterly', 'annually', 'custom'
  filePath       String?  @map("file_path")
  memberId       Int?     @map("member_id")
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  member  Member? @relation(fields: [memberId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@map("export_history")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  type      String   // 'payment_due', 'payment_received', 'system'
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Settings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?
  description String?
  updatedBy   Int      @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  updater User @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id])

  @@map("settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  tableName  String   @map("table_name")
  recordId   Int?     @map("record_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}