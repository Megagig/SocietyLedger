# Environment variables for the Dokploy "Compose" project running
# docker-compose.dokploy.yml. Paste these (with real values) into the
# project's Environment tab in the Dokploy UI — Dokploy injects them as
# ${VAR} substitutions into the compose file at deploy time.
#
# Do not commit a filled-in copy of this file.
#
# Legend:  [REQUIRED] the stack misbehaves or won't start without it
#          [OPTIONAL] a feature is switched off (or a safe default is used) without it
#          [BUILD]    baked into the JS bundle at image build time; changing it needs a rebuild
#
# Generate secrets with:  openssl rand -hex 32   (64 hex chars)

# ---------------------------------------------------------------------------
# Domains
# ---------------------------------------------------------------------------
# [REQUIRED] Apex + wildcard subdomain host for the web app. Needs wildcard DNS
# (*.societyledger.com.ng) and a wildcard TLS cert issued via DNS-01 challenge.
BASE_DOMAIN=societyledger.com.ng
# [REQUIRED] Host routed to the api service.
API_DOMAIN=api.societyledger.com.ng
# [REQUIRED] Host routed to the admin console.
ADMIN_DOMAIN=admin.societyledger.com.ng
# [REQUIRED] Host routed to the docs site.
DOCS_DOMAIN=docs.societyledger.com.ng

# ---------------------------------------------------------------------------
# Postgres + Redis (DATABASE_URL / DIRECT_URL / REDIS_URL are composed inside
# docker-compose.dokploy.yml from these; do not set them yourself)
# ---------------------------------------------------------------------------
POSTGRES_USER=societyledger
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=societyledger
REDIS_PASSWORD=change-me-to-a-strong-random-password

# ---------------------------------------------------------------------------
# API — core
# ---------------------------------------------------------------------------
# [REQUIRED] Signs every login token. There is a built-in fallback value in the
# code, so a missing secret would NOT fail loudly: always set a long random one.
JWT_SECRET=change-me-to-a-long-random-secret
# [REQUIRED] Public URL of the web app (CORS, email links, payment callbacks).
FRONTEND_URL=https://societyledger.com.ng
# [REQUIRED] Admin console URL (CORS, impersonation redirect, invite links).
ADMIN_URL=https://admin.societyledger.com.ng
# [REQUIRED] Public URL of this API. Used for the mobile payment return link;
# the built-in default points at a different domain.
API_PUBLIC_URL=https://api.societyledger.com.ng
# [REQUIRED] Website URL used in emails (renewal, manage-subscription links).
APP_URL=https://societyledger.com.ng
# [REQUIRED] 64 hex chars, AES-256-GCM key for TOTP secrets. Never change it
# after admins have enrolled 2FA, or they are locked out.
TOTP_ENCRYPTION_KEY=change-me-to-64-hex-chars
# [OPTIONAL] Platform (super admin) token life. Default 8h.
PLATFORM_TOKEN_EXPIRY=8h
# [OPTIONAL] Mobile access-token life. Default 15m. Impersonation life. Default 4h.
MOBILE_ACCESS_TOKEN_EXPIRY=15m
IMPERSONATION_EXPIRY=4h
# [OPTIONAL] Cookie domain for the web session, e.g. .societyledger.com.ng so it
# is shared across tenant subdomains. Leave empty to scope to the API host.
COOKIE_DOMAIN=
# [OPTIONAL] WhatsApp number shown on support cards (international format, no +).
SUPPORT_WHATSAPP_NUMBER=2348060374755

# ---------------------------------------------------------------------------
# API — first start (migrations and seeds run automatically on every start)
# ---------------------------------------------------------------------------
# [REQUIRED on the FIRST deploy only] Creates the first platform super admin for the
# admin console. Skipped when a super admin already exists, and it never changes an
# existing password. Use 12+ characters. After you sign in and set up 2FA, delete
# SUPER_ADMIN_PASSWORD from this list and redeploy.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=change-me-to-a-12-plus-character-password
# [OPTIONAL] "false" skips the reference-data seeds on start (about 30 s faster).
# Leave it true: new permissions and modules ship with each release.
SEED_ON_START=true

# ---------------------------------------------------------------------------
# API — payments
# ---------------------------------------------------------------------------
# [REQUIRED] Paystack (use live keys here, test keys on staging).
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
# [REQUIRED] Paystack signs webhooks with the SECRET key, so set this to the
# SAME value as PAYSTACK_SECRET_KEY. Left empty, real webhooks are rejected.
PAYSTACK_WEBHOOK_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxxx
# [OPTIONAL] Nomba bank-transfer payments. Leave the values empty if unused.
NOMBA_API_KEY=your-client-id
NOMBA_API_SECRET=your-private-key
NOMBA_ACCOUNT_ID=your-account-id
NOMBA_WEBHOOK_SECRET=your-signature-key
NOMBA_BASE_URL=https://api.nomba.com/v1

# ---------------------------------------------------------------------------
# API — email, SMS, push, AI
# ---------------------------------------------------------------------------
# [REQUIRED] Resend: signup verification, approval, reset-password emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# [REQUIRED] Must be an address on a domain verified in Resend.
EMAIL_FROM=SocietyLedger <no-reply@societyledger.com.ng>
EMAIL_REPLY_TO=support@societyledger.com.ng
# [OPTIONAL] Termii SMS. Without the key, SMS sending is off.
TERMII_API_KEY=
TERMII_SENDER_ID=SocLedger
TERMII_BASE_URL=https://api.ng.termii.com/api
TERMII_CHANNEL=generic
TERMII_WEBHOOK_SECRET=
# [OPTIONAL] Mobile push notifications. Without it, push works but is rate
# limited by Expo; create an access token in your Expo account.
EXPO_ACCESS_TOKEN=
# [OPTIONAL] AI assistant. Without the key, AI features return an error.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# ---------------------------------------------------------------------------
# File storage (MinIO), a SHARED stack deployed on its own: see docs/deployment/MINIO_SETUP.md.
# Payment proofs, expense receipts, cash deposit slips and support attachments live there.
# This app gets its own bucket and a key limited to that bucket (NOT the MinIO admin login).
# ---------------------------------------------------------------------------
# [REQUIRED] Where the API talks to MinIO. Use the public address instead if the two stacks
# cannot reach each other over dokploy-network.
MINIO_ENDPOINT=http://shared-minio:9000
# [REQUIRED] What phones and browsers use to open signed receipt links (public HTTPS, port 9000).
# Without it, uploads work but receipts will not open on phones.
MINIO_PUBLIC_ENDPOINT=https://files.societyledger.com.ng
# [REQUIRED] The app's own user and secret created in MinIO (setup guide, step 2). Not the root login.
MINIO_ACCESS_KEY=societyledger-app
MINIO_SECRET_KEY=change-me-to-the-secret-you-created
# [OPTIONAL] Defaults shown.
MINIO_BUCKET=societyledger
MINIO_REGION=us-east-1

# ---------------------------------------------------------------------------
# Web (apps/web) [BUILD] — NEXT_PUBLIC_* are passed as Docker build args AND
# set at runtime; changing one needs a rebuild + redeploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.societyledger.com.ng
NEXT_PUBLIC_APP_NAME=SocietyLedger
NEXT_PUBLIC_BASE_DOMAIN=societyledger.com.ng

# ---------------------------------------------------------------------------
# Admin console (apps/admin)
# ---------------------------------------------------------------------------
# [REQUIRED] [BUILD] Public URL of the admin console (CSRF Origin check).
NEXT_PUBLIC_ADMIN_HOST=https://admin.societyledger.com.ng
# [OPTIONAL] [BUILD] "production" or "staging", shown as a badge in the chrome.
NEXT_PUBLIC_ENV=production
# [OPTIONAL] Comma-separated IPs/CIDRs allowed to open the console. Empty = off.
ADMIN_IP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Docs (apps/docs)
# ---------------------------------------------------------------------------
# [BUILD] The three below must be present (empty is allowed for GA and drafts).
NEXT_PUBLIC_SITE_URL=https://docs.societyledger.com.ng
NEXT_PUBLIC_APP_URL=https://www.societyledger.com.ng
# [OPTIONAL] Google Analytics ID. Empty = no analytics.
NEXT_PUBLIC_GA_ID=
# [OPTIONAL] "true" only on preview builds, to show draft pages.
NEXT_PUBLIC_SHOW_DRAFTS=
# [OPTIONAL] Set to "noindex, nofollow" on STAGING only; leave empty in production.
DOCS_ROBOTS_TAG=

# ===========================================================================
# NOT for Dokploy: mobile app build variables (set in EAS, not here).
# `eas build` never sees apps/mobile/.env.local. Put these in the `preview`
# and `production` profiles' env in eas.json, or in EAS project environment
# variables (eas env:create), per environment:
#
#   EXPO_PUBLIC_API_URL=https://api.societyledger.com.ng        (https only)
#   EXPO_PUBLIC_WEB_URL=https://societyledger.com.ng
#   EXPO_PUBLIC_BASE_DOMAIN=societyledger.com.ng
#   EXPO_PUBLIC_DOCS_URL=https://docs.societyledger.com.ng
#   EXPO_PUBLIC_SENTRY_DSN=<from Sentry project settings>        (optional)
#   SENTRY_ORG / SENTRY_PROJECT                                  (with the DSN)
#   SENTRY_AUTH_TOKEN=<secret, EAS secret visibility>            (source maps)
#   EAS_PROJECT_ID is already in eas.json.
# ===========================================================================
