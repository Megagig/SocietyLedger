# Environment variables for the Dokploy "Compose" project running
# docker-compose.dokploy.yml. Paste these (with real values) into the
# project's Environment tab in the Dokploy UI — Dokploy injects them as
# ${VAR} substitutions into the compose file at deploy time.
#
# Do not commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# Domains
# ---------------------------------------------------------------------------
# Apex + wildcard subdomain host for the web app (Host() / HostRegexp() rule
# in docker-compose.dokploy.yml). Needs wildcard DNS (*.societyledger.com.ng)
# and a wildcard TLS cert issued via DNS-01 challenge.
BASE_DOMAIN=societyledger.com.ng
# Host Dokploy/Traefik routes to the api service.
API_DOMAIN=api.societyledger.com.ng

# ---------------------------------------------------------------------------
# Postgres (replaces Neon)
# ---------------------------------------------------------------------------
POSTGRES_USER=societyledger
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=societyledger

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me-to-a-strong-random-password

# ---------------------------------------------------------------------------
# API (apps/api) — DATABASE_URL / DIRECT_URL / REDIS_URL are composed inside
# docker-compose.dokploy.yml from the Postgres/Redis values above; you don't
# set them directly here.
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
FRONTEND_URL=https://societyledger.com.ng

PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

NOMBA_API_KEY=your-client-id
NOMBA_API_SECRET=your-private-key
NOMBA_ACCOUNT_ID=your-account-id
NOMBA_WEBHOOK_SECRET=your-signature-key
NOMBA_BASE_URL=https://api.nomba.com/v1

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Web (apps/web) — NEXT_PUBLIC_* values are baked into the JS bundle at BUILD
# time (passed as Docker build args) as well as set at runtime, so changing
# one of these requires a rebuild+redeploy, not just a container restart.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.societyledger.com.ng
NEXT_PUBLIC_APP_NAME=SocietyLedger
NEXT_PUBLIC_BASE_DOMAIN=societyledger.com.ng

# ---------------------------------------------------------------------------
# API (apps/api) — extra vars added for Admin Phase A1
# ---------------------------------------------------------------------------
# Full URL of the admin console (used for CORS and impersonation redirect)
ADMIN_URL=https://admin.societyledger.com.ng
# JWT expiry for platform (super admin) tokens — matches session cookie Max-Age
PLATFORM_TOKEN_EXPIRY=8h
# AES-256-GCM key for encrypting TOTP secrets at rest (32 hex bytes = 64 chars)
# Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=change-me-to-64-hex-chars

# ---------------------------------------------------------------------------
# Admin console (apps/admin)
# ---------------------------------------------------------------------------
# Traefik domain rule for the admin service
ADMIN_DOMAIN=admin.societyledger.com.ng
# Public URL of the admin console — used for CSRF Origin check in the BFF
NEXT_PUBLIC_ADMIN_HOST=https://admin.societyledger.com.ng
# "production" or "staging" — shown as the EnvBadge in the chrome
NEXT_PUBLIC_ENV=production
# Optional comma-separated IP allowlist — leave empty to disable
ADMIN_IP_ALLOWLIST=
